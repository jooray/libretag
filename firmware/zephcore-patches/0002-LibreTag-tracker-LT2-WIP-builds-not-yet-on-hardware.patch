+static const struct flash_area *keys_fa;
+
+static uint32_t keyrec_crc(const struct keyrec *r)
+{
+	return crc32_ieee((const uint8_t *)r, offsetof(struct keyrec, crc));
+}
+
+static bool keys_read(int page, struct keyrec *r)
+{
+	return flash_area_read(keys_fa, page * KEYS_PAGE, r, sizeof(*r)) == 0 && r->magic == KEYS_MAGIC &&
+	       r->crc == keyrec_crc(r);
+}
+
+static bool keys_save(void)
+{
+	if (!keys_fa) {
+		return false;
+	}
+	keys.magic = KEYS_MAGIC;
+	keys.seq++;
+	keys.crc = keyrec_crc(&keys);
+	int page = keys.seq & 1;
+	struct keyrec back;
+
+	if (flash_area_erase(keys_fa, page * KEYS_PAGE, KEYS_PAGE) ||
+	    flash_area_write(keys_fa, page * KEYS_PAGE, &keys, sizeof(keys)) || !keys_read(page, &back) ||
+	    back.seq != keys.seq) {
+		LOG_ERR("key page %d write failed", page);
+		return false;
+	}
+	/* the previous page holds the previous epoch's keys: erase it */
+	flash_area_erase(keys_fa, (1 - page) * KEYS_PAGE, KEYS_PAGE);
+	return true;
+}
+
+static void keys_new(const uint8_t *k0)
+{
+	memset(&keys.k0, 0, sizeof(keys.k0));
+	if (k0) {
+		memcpy(keys.k0, k0, LT_K0_SIZE);
+	} else {
+		rng.random(keys.k0, LT_K0_SIZE);
+	}
+	keys.has_k0 = 1;
+	keys.locked = 0;
+	lt_keys_from_k0(keys.k0, &keys.k);
+}
+
+/* Keys for report n: ratchet forward when n entered a new epoch. */
+static void keys_for(uint32_t n)
+{
+	if (lt_epoch(n) > keys.k.epoch) {
+		lt_keys_advance(&keys.k, lt_epoch(n));
+		keys_save();
+	}
+}
