+/* Keys (PROTOCOL.md 1) live in two raw 4 KB pages of storage_partition, written alternately;
+ * after a good write the other page is erased, so a ratcheted-away key is really gone (a
+ * LittleFS rewrite would leave the old block readable). */
+#define KEYS_MAGIC 0x4C544B32u /* "LTK2" */
+#define KEYS_PAGE 4096
+struct keyrec {
+	uint32_t magic;
+	uint32_t seq;
+	uint8_t locked;   /* USB console locked (PROTOCOL.md 6) */
+	uint8_t has_k0;   /* K0 kept until the app locks the tracker after pairing */
+	uint8_t pad[2];
+	uint8_t k0[LT_K0_SIZE];
+	lt_keys_t k;
+	uint32_t crc;
+};
+static struct keyrec keys;
