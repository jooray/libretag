From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Mon, 16 Nov 2026 02:12:07 +0100
Subject: [PATCH 03/40] LibreTag tracker 0.5.0: LT2, low battery 25 %

---
 zephcore/Kconfig              | 2 +-
 zephcore/src/lt_version.h     | 2 +-
 zephcore/src/main_tracker.cpp | 2 ++
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/zephcore/Kconfig b/zephcore/Kconfig
index 9179706..acb570a 100644
--- a/zephcore/Kconfig
+++ b/zephcore/Kconfig
@@ -218,7 +218,7 @@ config LIBRETAG_FIX_TIMEOUT_SEC
 
 config LIBRETAG_LOW_BATT_PCT
 	int "Battery percentage that sets the LOW_BATT flag"
-	default 20
+	default 25
 
 config LIBRETAG_CHANNEL_MODE
 	bool "Send reports on the #libretag hashtag channel (for MeshCore Open apps)"
diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index 49f03dd..6a1f1be 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.4.0"
+#define LT_FW_VERSION "0.5.0"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index af881d6..940d18b 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -430,6 +430,8 @@ static void load_cfg(void)
 				cfg.region_manual = 0;
 				cfg.path_hash_size = 1;
 			}
+			cfg.low_batt_pct = CONFIG_LIBRETAG_LOW_BATT_PCT; /* 25 %: the app's DM step (PROTOCOL.md 5) */
+			cfg.dm_alerts = 1;
 			ok = true;
 		}
 	}
