--- a/zephcore/boards/common/tracker.conf
+++ b/zephcore/boards/common/tracker.conf
@@ -2,9 +2,11 @@
 # Build: west build -b wio_tracker_l1 zephcore -- -DEXTRA_CONF_FILE="boards/common/tracker.conf"
 CONFIG_ZEPHCORE_ROLE_TRACKER=y
 
-# BLE: scanning (owner presence, BLE_SCAN, blescan) and, only inside a `blepair` window, a
-# connectable bondable peripheral so the owner's phone can hand over its IRK. Outside the window
-# nothing advertises and nothing can connect. Bonds live in RAM only (no BT settings).
+# BLE: scanning (owner presence, BLE_SCAN, blescan) and a connectable peripheral only inside a
+# window: `blepair` (bondable, so the owner's phone can hand over its IRK) and, since 0.8.0, the
+# Bluetooth console for 3 minutes after a boot (`blecon`, PROTOCOL.md 6.2; sealed frames keyed
+# with usb_key, no bonding). Outside a window nothing advertises and nothing can connect. Bonds
+# live in RAM only (no BT settings).
 CONFIG_BT=y
 CONFIG_BT_OBSERVER=y
 CONFIG_BT_PERIPHERAL=y
@@ -19,6 +21,11 @@ CONFIG_BT_DEVICE_NAME="LibreTag"
 CONFIG_BT_DEVICE_NAME_DYNAMIC=n
 CONFIG_BT_SETTINGS=n
 CONFIG_ENTROPY_GENERATOR=y
+# 0.8.0: the console window advertises from a resolvable private address, never the identity
+# (factory) address; blepair keeps USE_IDENTITY. The IRK is random per boot (no BT settings).
+CONFIG_BT_PRIVACY=y
+# nothing for a stranger to read after connecting (no ZephCore model or version)
+CONFIG_BT_DIS=n
 
 # The USB CDC port carries the text CLI; keep the console driver off it.
 CONFIG_UART_CONSOLE=n
