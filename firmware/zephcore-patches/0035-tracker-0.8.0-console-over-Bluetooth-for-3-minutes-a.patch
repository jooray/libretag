 	memset(&keys.k0, 0, sizeof(keys.k0));
 	if (k0) {
 		memcpy(keys.k0, k0, LT_K0_SIZE);
@@ -3592,12 +3611,612 @@ static void ble_cmd_done(void)
 	try_tx();
 }
 
+#if BCON
+/* ---- console over Bluetooth (0.8.0, docs/design/ble-console.md, PROTOCOL.md 6.2).
+ * After a boot a paired tag advertises for LT_BCON_WINDOW_S from a private address: manufacturer
+ * data 0x25 with a salted tag only the owner's app recognises. One GATT service, RX (write) and
+ * TX (notify). No Bluetooth pairing: the app proves usb_key in a handshake, then every frame is
+ * sealed with session keys (lt_bcon_*). Before that the tag answers nothing. The Bluetooth
+ * callbacks only queue frames and post EV_BCON; lines run in the main loop like USB lines. */
+#define BCON_UUID(w) BT_UUID_DECLARE_128(BT_UUID_128_ENCODE(w, 0x7A1E, 0x4B0C, 0x9D2F, 0x6C6962726574ULL))
+#define BCON_FRAME_MAX (1 + 240 + LT_BCON_MAC_LEN)
+
+enum { BC_NONE, BC_CONNECTED, BC_AUTH, BC_SESSION };
+enum { BCF_CONN, BCF_DISC, BCF_CCC };
+
+static bool bcon_advertising;
+static bool bcon_dropping;          /* disconnect requested, waiting for the callback */
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+static bool bcon_held;              /* ESP32: the sleep lock of the window */
+#endif
+static uint8_t bcon_st;
+static uint8_t bcon_fails;          /* failed handshakes and frames since boot */
+static int64_t bcon_until_ms;       /* advertising ends; a session keeps the window open past it */
+static int64_t bcon_adv_ms;         /* next refresh of `left` */
+static int64_t bcon_conn_ms, bcon_rx_ms, bcon_sess_ms, bcon_flush_ms;
+static uint8_t bcon_salt[6];
+static uint8_t bcon_mfg[2 + LT_BCON_ADV_LEN];
+static uint8_t bcon_tn[LT_BCON_NONCE_LEN];
+static lt_bcon_t bcon_s;
+static size_t bcon_chunk = LT_BCON_DATA_MAX;
+static uint8_t bcon_txb[LT_BCON_DATA_MAX];
+static size_t bcon_txn;
+static char bcon_line[160];         /* its own line buffer: a half-typed USB line never mixes in */
+static size_t bcon_line_len;
+static uint32_t bcon_sessions;      /* authenticated sessions since boot (status) */
+
+/* shared with the Bluetooth threads */
+static struct k_spinlock bcon_lock;
+static struct bt_conn *bcon_conn;
+static atomic_t bcon_flags;
+static volatile uint8_t bcon_reason;
+static volatile bool bcon_notify_on;
+static uint8_t bcon_ring[512];      /* frames from the app: [len][frame]... */
+static size_t bcon_rhead, bcon_rused;
+
+static const uint8_t bcon_flags_ad = BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR;
+static const struct bt_data bcon_ad[] = {
+	{BT_DATA_FLAGS, 1, &bcon_flags_ad},
+	{BT_DATA_MANUFACTURER_DATA, sizeof(bcon_mfg), bcon_mfg},
+};
+
+static bool bcon_ring_put(const uint8_t *d, size_t n)
+{
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+	bool ok = bcon_rused + 1 + n <= sizeof(bcon_ring);
+
+	if (ok) {
+		size_t w = (bcon_rhead + bcon_rused) % sizeof(bcon_ring);
+
+		bcon_ring[w] = (uint8_t)n;
+		for (size_t i = 0; i < n; i++) {
+			bcon_ring[(w + 1 + i) % sizeof(bcon_ring)] = d[i];
+		}
+		bcon_rused += 1 + n;
+	}
+	k_spin_unlock(&bcon_lock, k);
+	return ok;
+}
+
+static size_t bcon_ring_get(uint8_t *d)
+{
+	size_t n = 0;
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+
+	if (bcon_rused) {
+		n = bcon_ring[bcon_rhead];
+		for (size_t i = 0; i < n; i++) {
+			d[i] = bcon_ring[(bcon_rhead + 1 + i) % sizeof(bcon_ring)];
+		}
+		bcon_rhead = (bcon_rhead + 1 + n) % sizeof(bcon_ring);
+		bcon_rused -= 1 + n;
+	}
+	k_spin_unlock(&bcon_lock, k);
+	return n;
+}
+
+static void bcon_ring_clear(void)
+{
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+
+	bcon_rhead = bcon_rused = 0;
+	k_spin_unlock(&bcon_lock, k);
+}
+
+/* a reference to the console's connection, or NULL */
+static struct bt_conn *bcon_ref(void)
+{
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+	struct bt_conn *c = bcon_conn ? bt_conn_ref(bcon_conn) : NULL;
+
+	k_spin_unlock(&bcon_lock, k);
+	return c;
+}
+
+static ssize_t bcon_rx_write(struct bt_conn *conn, const struct bt_gatt_attr *attr, const void *buf, uint16_t len,
+			     uint16_t offset, uint8_t flags)
+{
+	ARG_UNUSED(attr);
+	ARG_UNUSED(flags);
+	if (!bcon_on || conn != bcon_conn) {
+		return BT_GATT_ERR(BT_ATT_ERR_WRITE_NOT_PERMITTED); /* outside a console window (blepair) */
+	}
+	if (offset) {
+		return BT_GATT_ERR(BT_ATT_ERR_INVALID_OFFSET);
+	}
+	if (!len || len > BCON_FRAME_MAX) {
+		return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
+	}
+	if (!bcon_ring_put((const uint8_t *)buf, len)) {
+		return BT_GATT_ERR(BT_ATT_ERR_INSUFFICIENT_RESOURCES);
+	}
+	k_event_post(&events, EV_BCON);
+	return len;
+}
+
+static void bcon_ccc(const struct bt_gatt_attr *attr, uint16_t value)
+{
+	ARG_UNUSED(attr);
+	bcon_notify_on = value == BT_GATT_CCC_NOTIFY;
+	atomic_set_bit(&bcon_flags, BCF_CCC);
+	k_event_post(&events, EV_BCON);
+}
+
+BT_GATT_SERVICE_DEFINE(bcon_svc,
+	BT_GATT_PRIMARY_SERVICE(BCON_UUID(0x4C540001)),
+	BT_GATT_CHARACTERISTIC(BCON_UUID(0x4C540002), BT_GATT_CHRC_WRITE | BT_GATT_CHRC_WRITE_WITHOUT_RESP,
+			       BT_GATT_PERM_WRITE, NULL, bcon_rx_write, NULL),
+	BT_GATT_CHARACTERISTIC(BCON_UUID(0x4C540003), BT_GATT_CHRC_NOTIFY, BT_GATT_PERM_NONE, NULL, NULL, NULL),
+	BT_GATT_CCC(bcon_ccc, BT_GATT_PERM_READ | BT_GATT_PERM_WRITE),
+);
+#define BCON_TX_ATTR (&bcon_svc.attrs[4])
+
+static void bcon_connected(struct bt_conn *conn, uint8_t err)
+{
+	struct bt_conn_info info;
+
+	if (err || !bcon_on || pair_on || bt_conn_get_info(conn, &info) || info.role != BT_CONN_ROLE_PERIPHERAL) {
+		return;
+	}
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+	bool mine = !bcon_conn;
+
+	if (mine) {
+		bcon_conn = bt_conn_ref(conn);
+	}
+	k_spin_unlock(&bcon_lock, k);
+	if (mine) {
+		atomic_set_bit(&bcon_flags, BCF_CONN);
+		k_event_post(&events, EV_BCON);
+	}
+}
+
+static void bcon_disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	k_spinlock_key_t k = k_spin_lock(&bcon_lock);
+	bool mine = conn == bcon_conn;
+
+	if (mine) {
+		bcon_conn = NULL;
+	}
+	k_spin_unlock(&bcon_lock, k);
+	if (!mine) {
+		return;
+	}
+	bt_conn_unref(conn);
+	bcon_reason = reason;
+	atomic_set_bit(&bcon_flags, BCF_DISC);
+	k_event_post(&events, EV_BCON);
+}
+
+BT_CONN_CB_DEFINE(bcon_conn_cb) = {
+	.connected = bcon_connected,
+	.disconnected = bcon_disconnected,
+};
+
+static bool bcon_authed(void)
+{
+	return bcon_st == BC_SESSION && !bcon_dropping;
+}
+
+static uint32_t bcon_left_s(void)
+{
+	int64_t l = bcon_until_ms - k_uptime_get();
+
+	return l > 0 ? (uint32_t)((l + 999) / 1000) : 0U;
+}
+
+static void bcon_adv_fill(void)
+{
+	bcon_mfg[0] = 0xFF; /* company 0xFFFF, little endian */
+	bcon_mfg[1] = 0xFF;
+	lt_bcon_adv(keys.k.usb_key, bcon_salt, bcon_left_s(), bcon_mfg + 2);
+	bcon_adv_ms = k_uptime_get() + 10000;
+}
+
+static int bcon_adv_start(void)
+{
+	/* connectable, legacy, 100 to 150 ms, without USE_IDENTITY: a resolvable private address
+	 * (CONFIG_BT_PRIVACY); nobody gets the IRK, the console never bonds */
+	struct bt_le_adv_param p = BT_LE_ADV_PARAM_INIT(BT_LE_ADV_OPT_CONN, 160, 240, NULL);
+
+	bcon_adv_fill();
+	int err = bt_le_adv_start(&p, bcon_ad, ARRAY_SIZE(bcon_ad), NULL, 0);
+
+	bcon_advertising = err == 0;
+	if (err) {
+		LOG_WRN("blecon: advertising failed (%d)", err);
+	}
+	return err;
+}
+
+static void bcon_adv_stop(void)
+{
+	if (bcon_advertising) {
+		bt_le_adv_stop();
+		bcon_advertising = false;
+	}
+}
+
+static void bcon_drop(void)
+{
+	struct bt_conn *c = bcon_ref();
+
+	if (c) {
+		bcon_dropping = true;
+		bt_conn_disconnect(c, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+		bt_conn_unref(c);
+	}
+}
+
+static void bcon_fail(const char *what)
+{
+	if (bcon_fails < 255) {
+		bcon_fails++;
+	}
+	LOG_WRN("blecon: %s, %u failure(s)", what, bcon_fails);
+	bcon_drop();
+}
+
+/* one notification; waits for an ATT buffer (bounded), a link that cannot take it is dropped */
+static bool bcon_notify(const uint8_t *d, size_t n)
+{
+	struct bt_conn *c = bcon_ref();
+	int err = -ENOTCONN;
+	int64_t t0 = k_uptime_get();
+
+	if (c) {
+		while ((err = bt_gatt_notify(c, BCON_TX_ATTR, d, (uint16_t)n)) == -ENOMEM &&
+		       k_uptime_get() - t0 < 2000) {
+			k_msleep(5);
+		}
+		bt_conn_unref(c);
+	}
+	if (err) {
+		LOG_WRN("blecon: notify failed (%d)", err);
+		bcon_drop();
+		return false;
+	}
+	return true;
+}
+
+static void bcon_flush(void)
+{
+	uint8_t f[BCON_FRAME_MAX];
+
+	if (!bcon_txn) {
+		return;
+	}
+	if (bcon_authed()) {
+		size_t l = lt_bcon_seal(&bcon_s, LT_BCON_T2A, bcon_txb, bcon_txn, f);
+
+		bcon_notify(f, l);
+	}
+	bcon_txn = 0;
+	bcon_flush_ms = k_uptime_get();
+}
+
+/* console output of a Bluetooth line: full frames, a line at once when the last frame is 50 ms old */
+static void bcon_tx(const uint8_t *b, size_t n)
+{
+	bool nl = n && b[n - 1] == '\n';
+
+	if (!bcon_authed()) {
+		return;
+	}
+	while (n) {
+		size_t m = MIN(n, bcon_chunk - bcon_txn);
+
+		memcpy(bcon_txb + bcon_txn, b, m);
+		bcon_txn += m;
+		b += m;
+		n -= m;
+		if (bcon_txn >= bcon_chunk) {
+			bcon_flush();
+		}
+	}
+	if (nl && k_uptime_get() - bcon_flush_ms >= 50) {
+		bcon_flush();
+	}
+}
+
+/* a line of the tag's own, sealed like console output, wherever the current line came from */
+static void bcon_say(const char *why)
+{
+	uint8_t was = con_cur;
+
+	if (!bcon_authed()) {
+		return;
+	}
+	con_cur = CON_BLE;
+	out("BLECON closing %s\r\n", why);
+	bcon_flush();
+	con_cur = was;
+}
+
+static void bcon_wipe(void)
+{
+	memset(&bcon_s, 0, sizeof(bcon_s));
+	memset(bcon_tn, 0, sizeof(bcon_tn));
+	memset(bcon_txb, 0, sizeof(bcon_txb));
+	memset(bcon_line, 0, sizeof(bcon_line));
+	bcon_txn = 0;
+	bcon_line_len = 0;
+	bcon_st = BC_NONE;
+	bcon_dropping = false;
+	bcon_ring_clear();
+	if (con_cur == CON_BLE) {
+		con_cur = CON_USB;
+	}
+}
+
+static int bcon_open(uint32_t sec)
+{
+	if (!keys.locked) {
+		return -EPERM; /* first activation is cable only: an unpaired tag never listens */
+	}
+	if (bcon_fails >= LT_BCON_FAILS) {
+		return -EACCES; /* closed until the next boot */
+	}
+	if (pair_on) {
+		return -EBUSY;
+	}
+	if (!ble_ready) {
+		int err = bt_enable(NULL);
+
+		if (err && err != -EALREADY) {
+			return err;
+		}
+		ble_ready = true;
+	}
+	bcon_until_ms = k_uptime_get() + (int64_t)sec * 1000;
+	if (bcon_on) {
+		if (bcon_advertising) {
+			bcon_adv_fill();
+			bt_le_adv_update_data(bcon_ad, ARRAY_SIZE(bcon_ad), NULL, 0);
+		}
+		return 0;
+	}
+	rng.random(bcon_salt, sizeof(bcon_salt)); /* a new salt per window: two windows cannot be linked */
+	bcon_on = true;
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+	if (!bcon_held) {
+		zc_pm_block_sleep(); /* the ESP32 stays awake for the window and a session */
+		bcon_held = true;
+	}
+#endif
+	k_timer_start(&bcon_tmr, K_SECONDS(1), K_SECONDS(1));
+	int err = bcon_st == BC_NONE ? bcon_adv_start() : 0;
+
+	if (err) {
+		bcon_close(NULL);
+		return err;
+	}
+	LOG_INF("blecon: window open for %u s", sec);
+	return 0;
+}
+
+/* closes the window and any session; why: the reason printed to the session, NULL for none */
+static void bcon_close(const char *why)
+{
+	if (!bcon_on) {
+		return;
+	}
+	if (why) {
+		bcon_say(why);
+	}
+	bcon_on = false;
+	bcon_adv_stop();
+	bcon_drop();
+	k_timer_stop(&bcon_tmr);
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+	if (bcon_held) {
+		zc_pm_unblock_sleep();
+		bcon_held = false;
+	}
+#endif
+	bcon_wipe();
+	LOG_INF("blecon: window closed");
+}
+
+static void bcon_frame(const uint8_t *f, size_t n)
+{
+	if (bcon_dropping) {
+		return;
+	}
+	if (bcon_st == BC_AUTH) {
+		/* anything but a well-formed AUTH is ignored; the 10 s deadline ends such a connection */
+		if (n != 1 + LT_BCON_NONCE_LEN + LT_BCON_PROOF_LEN || f[0] != LT_BCON_AUTH) {
+			return;
+		}
+		struct bt_conn *c = bcon_ref();
+		uint16_t mtu = c ? bt_gatt_get_mtu(c) : 0;
+		uint8_t want[LT_BCON_PROOF_LEN], r[1 + LT_BCON_PROOF_LEN];
+		const uint8_t *an = f + 1;
+
+		if (c) {
+			bt_conn_unref(c);
+		}
+		if (mtu < 64) {
+			LOG_WRN("blecon: MTU %u too small", mtu);
+			bcon_drop();
+			return;
+		}
+		lt_bcon_proof(keys.k.usb_key, 'a', bcon_tn, an, want);
+		if (!lt_ct_eq(want, f + 1 + LT_BCON_NONCE_LEN, LT_BCON_PROOF_LEN)) {
+			bcon_fail("wrong proof");
+			return;
+		}
+		lt_bcon_session(keys.k.usb_key, bcon_tn, an, &bcon_s);
+		r[0] = LT_BCON_READY;
+		lt_bcon_proof(keys.k.usb_key, 't', bcon_tn, an, r + 1);
+		bcon_chunk = MIN((size_t)LT_BCON_DATA_MAX, (size_t)mtu - 3 - 1 - LT_BCON_MAC_LEN);
+		if (!bcon_notify(r, sizeof(r))) {
+			return;
+		}
+		bcon_st = BC_SESSION;
+		bcon_sess_ms = bcon_rx_ms = bcon_flush_ms = k_uptime_get();
+		bcon_line_len = 0;
+		bcon_txn = 0;
+		bcon_sessions++;
+		LOG_INF("blecon: session open (MTU %u)", mtu);
+		/* the owner is here and the resets were theirs (as `reboot`) */
+		if (cfg.boot_resets > 1) {
+			cfg.boot_resets = 1;
+			save_cfg();
+		}
+		c = bcon_ref();
+		if (c) {
+			struct bt_le_conn_param p = BT_LE_CONN_PARAM_INIT(24, 40, 0, 600); /* 30-50 ms, 6 s */
+
+			bt_conn_le_param_update(c, &p);
+			bt_conn_unref(c);
+		}
+		return;
+	}
+	if (bcon_st != BC_SESSION) {
+		return; /* before HELLO: ignored */
+	}
+	uint8_t pt[BCON_FRAME_MAX];
+	int l = lt_bcon_open(&bcon_s, LT_BCON_A2T, f, n, pt);
+
+	if (l < 0) {
+		bcon_fail("bad frame");
+		return;
+	}
+	bcon_rx_ms = k_uptime_get();
+	for (int i = 0; i < l && bcon_authed(); i++) {
+		char ch = (char)pt[i];
+
+		if (ch == '\r' || ch == '\n') {
+			if (bcon_line_len) {
+				/* no echo over Bluetooth */
+				bcon_line[bcon_line_len] = 0;
+				bcon_line_len = 0;
+				con_cur = CON_BLE;
+				cli_exec(bcon_line);
+				bcon_flush();
+			}
+			/* an empty line is the app's keepalive: no command */
+		} else if (bcon_line_len < sizeof(bcon_line) - 1) {
+			bcon_line[bcon_line_len++] = ch;
+		}
+	}
+	memset(pt, 0, sizeof(pt));
+}
+
+static void bcon_handle(void)
+{
+	int64_t now = k_uptime_get();
+	uint8_t f[BCON_FRAME_MAX];
+	size_t n;
+
+	if (atomic_test_and_clear_bit(&bcon_flags, BCF_DISC)) {
+		bool was = bcon_st == BC_SESSION;
+		uint8_t reason = bcon_reason;
+
+		bcon_wipe();
+		bt_unpair(BT_ID_DEFAULT, NULL); /* in case the phone bonded on its own: nothing is kept */
+		LOG_INF("blecon: disconnected (0x%02x)", reason);
+		if (bcon_on) {
+			if (was && reason == BT_HCI_ERR_CONN_TIMEOUT) {
+				/* the link was lost in a session: 30 s more to reconnect and finish */
+				bcon_until_ms = MAX(bcon_until_ms, now + LT_BCON_GRACE_S * 1000);
+			}
+			if (bcon_fails >= LT_BCON_FAILS) {
+				LOG_WRN("blecon: %u failures, closed until the next boot", bcon_fails);
+				bcon_close(NULL);
+			} else if (now >= bcon_until_ms) {
+				bcon_close(NULL);
+			} else {
+				bcon_adv_start();
+			}
+		}
+	}
+	if (atomic_test_and_clear_bit(&bcon_flags, BCF_CONN)) {
+		struct bt_conn *c = bcon_ref();
+
+		if (c && bcon_on) {
+			bt_conn_unref(c);
+			bcon_wipe();
+			bcon_st = BC_CONNECTED;
+			bcon_advertising = false; /* a connection ends connectable advertising */
+			bcon_conn_ms = now;
+		} else if (c) {
+			bt_conn_unref(c);
+			bcon_drop();
+		}
+	}
+	if (atomic_test_and_clear_bit(&bcon_flags, BCF_CCC) && bcon_st == BC_CONNECTED && bcon_notify_on) {
+		uint8_t h[2 + LT_BCON_NONCE_LEN];
+
+		rng.random(bcon_tn, sizeof(bcon_tn)); /* fresh per connection: a recorded AUTH is useless */
+		h[0] = LT_BCON_HELLO;
+		h[1] = LT_BCON_VER;
+		memcpy(h + 2, bcon_tn, sizeof(bcon_tn));
+		if (bcon_notify(h, sizeof(h))) {
+			bcon_st = BC_AUTH;
+		}
+	}
+	while ((n = bcon_ring_get(f)) > 0) {
+		bcon_frame(f, n);
+	}
+	if (!bcon_on) {
+		return;
+	}
+	now = k_uptime_get();
+	if (bcon_st == BC_NONE) {
+		if (now >= bcon_until_ms) {
+			bcon_close(NULL);
+		} else if (!bcon_advertising) {
+			bcon_adv_start(); /* after a disconnect the controller may not have been ready */
+		} else if (now >= bcon_adv_ms) {
+			bcon_adv_fill();
+			bt_le_adv_update_data(bcon_ad, ARRAY_SIZE(bcon_ad), NULL, 0);
+		}
+	} else if (bcon_st != BC_SESSION) {
+		if (now - bcon_conn_ms >= LT_BCON_AUTH_S * 1000 && !bcon_dropping) {
+			LOG_INF("blecon: no handshake in %u s", LT_BCON_AUTH_S);
+			bcon_drop();
+		}
+	} else if (!bcon_dropping) {
+		if (now - bcon_sess_ms >= (int64_t)LT_BCON_SESSION_MAX_S * 1000) {
+			bcon_say("max");
+			bcon_until_ms = now; /* the window ends with it */
+			bcon_drop();
+		} else if (now - bcon_rx_ms >= LT_BCON_IDLE_S * 1000) {
+			bcon_say("idle");
+			bcon_drop();
+		}
+	}
+}
+
+/* `blecon` and the status line */
+static void bcon_print(const char *prefix)
+{
+	int64_t now = k_uptime_get();
+
+	out("%s boot=%s state=", prefix, cfg.bcon_off ? "off" : "on");
+	if (!bcon_on) {
+		out("closed");
+	} else if (bcon_st == BC_SESSION) {
+		int64_t left = (int64_t)LT_BCON_SESSION_MAX_S * 1000 - (now - bcon_sess_ms);
+
+		out("session %us", (unsigned)(MAX(left, 0) / 1000));
+	} else if (bcon_st != BC_NONE) {
+		out("connecting");
+	} else {
+		out("open %us", (unsigned)bcon_left_s());
+	}
+	out(" fails=%u sessions=%u\r\n", bcon_fails, (unsigned)bcon_sessions);
+}
