 static void ble_scan_halt(void);
@@ -2132,6 +2147,7 @@ static void wake_finish(bool with_fix)
 		ble_scan_halt(); /* the presence scan never extends a wake-up */
 		ble_purpose = BLE_NONE;
 	}
+	blecheck_stop();
 #endif
 	if (check_rx && check_rx_over) {
