  * not a check. A match is opened like a mesh command and taken like one at a check. */
 #define BLECMD_GRACE_MS 2000  /* after an anchor answers, listen this long for the phone's command */
 #define BLECMD_NOGPS_MS 3000  /* boards without GPS: the presence scan's own window after the Wi-Fi scan */
+/* 0.9.3: a wake-up with no presence or LOST scan (a listen-only one between reports, a check or a
+ * report without known devices, TRACK) runs a short passive scan for the command advert only,
+ * alongside the LoRa window or the GPS search. The phone advertises every 250 ms (Android
+ * INTERVAL_MEDIUM); at 100 % scan duty 1.5 s covers 6 advertising events (firmware/README.md 0.9.3). */
+#define BLECMD_CHECK_MS 1500
 static volatile bool blecmd_armed;     /* a scan of this wake-up looks for a command advert */
 static uint16_t blecmd_k;
 static uint8_t blecmd_tag[LT_TAG_LEN]; /* xc(n_report, blecmd_k) */
@@ -359,6 +364,14 @@ static bool owner_finish_pending;      /* anchor gps off: decide when the grace
 static bool blecmd_inject;             /* console `blecmd adv`: fed at the next armed scan */
 static uint8_t blecmd_inject_buf[LT_BLE_CMD_LEN];
 static uint32_t blecmd_seen, blecmd_ok;
+static void blecheck_start(void);
+static void blecheck_stop(void);
+static uint32_t blecmd_scans;          /* 0.9.3: command-only scans since boot */
+static int32_t blecmd_first_ms = -1;   /* 0.9.3: scan start to our advert, last match (bench) */
+static int64_t blecmd_arm_ms;
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+static bool blecmd_held;               /* ESP32: no light sleep during the command scan */
+#endif
 #endif
 
 /* packets of one wake-up, sent back to back before the LISTEN window */
@@ -1387,7 +1400,9 @@ static void go_to_sleep(void)
 	check_wait = false;
 	check_cmd = false;
 #if IS_ENABLED(CONFIG_BT_OBSERVER)
+	blecheck_stop();
 	blecmd_armed = false;
+	blecmd_taken = false; /* 0.9.3: per wake-up (a listen-only one that took a command looks on) */
 	owner_finish_pending = false;
 #endif
 	energy_wake_end(wake_start_ms, phase == PH_LISTEN && listen_start_ms ? k_uptime_get() - listen_start_ms : 0);
@@ -1647,7 +1662,7 @@ static bool disc_start(uint32_t sec, bool quiet);
 static void fill_neighbours(lt_report_t *r);
