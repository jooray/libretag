@@ -2266,6 +2282,11 @@ static void start_report(void)
 			go_to_sleep(); /* the window is already over */
 			return;
 		}
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+		/* 0.9.3: the owner's phone may advertise the command for this check: a short passive
+		 * scan for that advert only, alongside the LoRa window (no Wi-Fi scan here) */
+		blecheck_start();
+#endif
 		check_wait = true;
 		check_wait_fix = false;
 		phase = PH_CHECK;
@@ -2292,6 +2313,10 @@ static void start_report(void)
 			blecmd_arm();
 		}
 	}
+	if (ble_purpose == BLE_NONE) {
+		/* 0.9.3: no presence or LOST scan at this wake-up: still look for the phone's command */
+		blecheck_start();
+	}
 #endif
 	if (gps_is_available() && gps_is_enabled()) {
 		phase = PH_WAIT_FIX;
@@ -2318,6 +2343,11 @@ static void start_report(void)
 			k_timer_start(&fix_timer, K_MSEC(BLECMD_NOGPS_MS), K_NO_WAIT);
 			return;
 		}
+		if (ble_purpose == BLE_CHECK && k_timer_remaining_get(&ble_tmr) > 0) {
+			/* 0.9.3: the same for the command scan: the decision waits for its 1.5 s */
+			k_timer_start(&fix_timer, K_MSEC(k_timer_remaining_get(&ble_tmr) + 20), K_NO_WAIT);
+			return;
+		}
 #endif
 		search_done(false);
 	}
@@ -2543,6 +2573,10 @@ static void handle_rx(void)
 				 * report n + 1 with CMD_ACK */
 				int64_t started = wake_start_ms;
 
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+				blecheck_stop(); /* 0.9.3: the presence scan may start now */
+				blecmd_taken = true; /* the command is here: no advert for it this wake-up */
+#endif
 				listen_only = false;
 				check_wait = false;
 				phase = PH_SLEEP;
@@ -2592,11 +2626,13 @@ static void handle_rx(void)
 static void blecmd_arm(void)
 {
 	blecmd_full = false;
-	blecmd_taken = false;
 	owner_finish_pending = false;
 	blecmd_armed = false;
-	if (!n_report_valid) {
-		return; /* no report since boot: no command can be bound to anything */
+	blecmd_arm_ms = k_uptime_get();
+	if (!n_report_valid || blecmd_taken) {
+		/* no report since boot: nothing to bind to; 0.9.3: or this wake-up took one already (a
+		 * listen-only wake-up that took a command and now looks) */
+		return;
 	}
 	/* the check of this wake-up, as at the mesh window; any other wake-up: "the next one" */
 	blecmd_k = (sched_keyed() && chk_k && !chk_hb) ? chk_k : (uint16_t)LT_BLE_K_NEXT;
@@ -2626,7 +2662,8 @@ static void blecmd_handle(void)
 	}
 	memcpy(a, blecmd_buf, sizeof(a));
 	blecmd_seen++;
-	bool ok = blecmd_armed && !blecmd_taken && phase == PH_WAIT_FIX &&
+	bool lonly = phase == PH_CHECK && listen_only && ble_purpose == BLE_CHECK;
+	bool ok = blecmd_armed && !blecmd_taken && (phase == PH_WAIT_FIX || lonly) &&
 		  lt_ble_command_open(chk_key, n_report, blecmd_k, a, sizeof(a), &c);
 
 	blecmd_full = false; /* the next advert with the tag may be the real one */
@@ -2638,7 +2675,9 @@ static void blecmd_handle(void)
 	}
 	blecmd_taken = true;
 	blecmd_ok++;
-	LOG_INF("command over Bluetooth for n=%u k=%u", n_report, blecmd_k);
+	blecmd_first_ms = (int32_t)(k_uptime_get() - blecmd_arm_ms);
+	LOG_INF("command over Bluetooth for n=%u k=%u after %d ms%s", n_report, blecmd_k, blecmd_first_ms,
+		lonly ? " (listen-only wake-up)" : "");
 	at_check = true; /* BLE_SCAN waits for the window after report n + 1, as at a check */
 	apply_command(&c);
 	at_check = false;
@@ -2647,6 +2686,21 @@ static void blecmd_handle(void)
 	}
 	check_rx_close(); /* the command is here: the check window has done its job */
 	wake_forced = true; /* report n + 1 with CMD_ACK when the search ends */
+	blecheck_stop();
+	if (lonly) {
+		/* 0.9.3: as a mesh command at a listen-only wake-up (handle_rx): look now (GPS, Wi-Fi,
+		 * Bluetooth), then report n + 1 with CMD_ACK */
+		int64_t started = wake_start_ms;
+		bool chk = check_cmd;
+
+		listen_only = false;
+		check_wait = false;
+		phase = PH_SLEEP;
+		start_report();
+		wake_start_ms = started;
+		check_cmd = chk;
+		return;
+	}
 	if (ble_purpose == BLE_PRESENCE && (owner_seen || owner_finish_pending)) {
 		ble_scan_halt(); /* presence is known and the command taken */
 	}
@@ -3109,7 +3163,8 @@ static void ble_scan_cb(const bt_addr_le_t *addr, int8_t rssi, uint8_t type, str
 {
 	struct ble_seen t = {};
 
-	if (blecmd_armed && !blecmd_full && (ble_purpose == BLE_PRESENCE || ble_purpose == BLE_LOST)) {
+	if (blecmd_armed && !blecmd_full &&
+	    (ble_purpose == BLE_PRESENCE || ble_purpose == BLE_LOST || ble_purpose == BLE_CHECK)) {
 		/* 0.7.7: before bt_data_parse, which consumes the buffer. A foreign advert costs a walk
 		 * over its AD structures and a 4 B compare, nothing cryptographic. */
 		const uint8_t *m = lt_ble_command_find(ad->data, ad->len);
@@ -3120,6 +3175,9 @@ static void ble_scan_cb(const bt_addr_le_t *addr, int8_t rssi, uint8_t type, str
 			k_event_post(&events, EV_BLECMD);
 		}
 	}
+	if (ble_purpose == BLE_CHECK) {
+		return; /* 0.9.3: the command scan keeps no table (anchors are the presence scan's job) */
+	}
 	bt_addr_le_copy(&t.addr, addr);
 	t.rssi_min = t.rssi_max = rssi;
 	t.rssi_sum = rssi;
@@ -3437,6 +3495,10 @@ static void bsv_final(void)
 /* ble_tmr fired: end a scan, or start the next survey round */
 static void ble_timer(void)
 {
+	if (ble_purpose == BLE_CHECK) {
+		blecheck_stop(); /* 0.9.3: nothing for us in 1.5 s; the LoRa window or the search runs on */
+		return;
+	}
 	if (ble_purpose == BLE_PRESENCE) {
 		ble_scan_halt(); /* the GPS is still searching; decide when it is done */
 		if (owner_finish_pending && phase == PH_WAIT_FIX) {
@@ -3542,6 +3604,42 @@ static void ble_scan_halt(void)
 	}
 }
 
+/* 0.9.3: the command-only scan of a wake-up without a presence or LOST scan (PROTOCOL.md 3.1):
+ * passive, 100 % duty, BLECMD_CHECK_MS, no table */
+static void blecheck_start(void)
+{
+	if (ble_purpose != BLE_NONE || !n_report_valid || blecmd_taken) {
+		return; /* another scan runs (a console blescan), or nothing could be bound to a report */
+	}
+	if (ble_scan_begin(BLE_CHECK, false, 1) != 0) {
+		ble_purpose = BLE_NONE;
+		return;
+	}
+	k_timer_start(&ble_tmr, K_MSEC(BLECMD_CHECK_MS), K_NO_WAIT);
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+	if (!blecmd_held) {
+		zc_pm_block_sleep(); /* the SoC must not light-sleep through the phone's adverts */
+		blecmd_held = true;
+	}
+#endif
+	blecmd_scans++;
+	blecmd_arm();
+}
+
+static void blecheck_stop(void)
+{
+	if (ble_purpose == BLE_CHECK) {
+		ble_scan_halt();
+		ble_purpose = BLE_NONE;
+	}
+#if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+	if (blecmd_held) {
+		zc_pm_unblock_sleep();
+		blecmd_held = false;
+	}
+#endif
+}
+
