+		    : (mode == LT_MODE_IDLE && cfg.anchor_count)                      ? "presence"
+										      : "check",
+		    blecmd_seen, blecmd_ok, blecmd_scans, blecmd_first_ms);
 		return true;
 	}
 	if (!strcmp(c, "blepkt")) {
@@ -5445,7 +5547,7 @@ static void cli_exec(char *l)
 		out("radio <MHz> <bwkHz> <sf> <cr> | power <dBm> | pathhash 1|2|3 | region <name>|none\r\n");
