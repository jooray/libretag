From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Wed, 18 Nov 2026 22:49:16 +0100
Subject: [PATCH 38/41] tracker 0.9.2: BLE_CONSOLE command (opcode 0x06) opens
 the Bluetooth console window at the wake-up that takes it (mesh window, check
 or command advert), as after a boot: paired, above the transmit floor; the
 boot switch and the reset count do not apply; argument in 10 s (0 = 180 s,
 30..600 s); acknowledged in the next report

---
 zephcore/src/lt_version.h     |  2 +-
 zephcore/src/main_tracker.cpp | 17 +++++++++++++++++
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index 5667091..20dec55 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.9.1"
+#define LT_FW_VERSION "0.9.2"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index 3477707..dd3811a 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -453,6 +453,7 @@ static bool bcon_on;  /* the console window is open (advertising, or a connectio
 static bool pair_on;  /* a blepair window */
 static bool bcon_authed(void);
 static void bcon_close(const char *why);
+static int bcon_open(uint32_t sec);
 static void bcon_flush(void);
 static void cli_exec(char *l);
 #endif
@@ -2486,6 +2487,22 @@ static void apply_command(const lt_command_t *c)
 		}
 		break;
 	}
+#endif
+#if BCON
+	case LT_OP_BLE_CONSOLE: {
+		/* 0.9.2: open the Bluetooth console window now, as after a boot: a paired tag, above the
+		 * transmit floor. The boot switch (blecon boot off) and the reset count do not apply: the
+		 * owner asked. Acknowledged in the next report like every command. */
+		uint32_t s = lt_bcon_cmd_window_s(c->args[0]);
+		int err = !tx_ok_now() ? -ENOSPC : bcon_open(s);
+
+		if (err) {
+			LOG_WRN("blecon: command, no window (%d)", err);
+		} else {
+			LOG_INF("blecon: opened by a command for %u s", s);
+		}
+		break;
+	}
 #endif
 	default:
 		return;
