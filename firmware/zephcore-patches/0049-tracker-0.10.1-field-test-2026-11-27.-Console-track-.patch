From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Fri, 27 Nov 2026 17:33:02 +0100
Subject: [PATCH 49/50] tracker 0.10.1: field test 2026-11-27. Console track
 reports at once; a Track or Lost that ran out ends before the report is built
 (the report says IDLE with the IDLE next_in); the TRACK/LOST interval runs
 wake-up to wake-up

---
 zephcore/src/lt_version.h     |  2 +-
 zephcore/src/main_tracker.cpp | 25 ++++++++++++++++++++++++-
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index 67d4bd6..b6da848 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.10.0"
+#define LT_FW_VERSION "0.10.1"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index aca5572..f3aed48 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -2785,6 +2785,14 @@ static void send_report(bool with_fix, const lt_wake_out_t *d, bool answer)
 		mode = LT_MODE_IDLE;
 		events |= LT_EV_MODE;
 	}
+	if (mode != LT_MODE_IDLE && k_uptime_get() >= mode_until_ms) {
+		/* 0.10.1: a Track or Lost that ran out ends before this report is built, so the report
+		 * already says IDLE and its next_in is the IDLE one (field test 2026-11-27: the last
+		 * report said TRACK, next_in 1 h, and the app raised Silent before the IDLE report) */
+		LOG_INF("mode %d expired, back to IDLE", mode);
+		mode = LT_MODE_IDLE;
+		events |= LT_EV_MODE;
+	}
 	if (d->epoch_skip) {
 		/* a long quiet stretch kept the ratchet still: whoever reads the key now cannot read back */
 		n_cur = (lt_epoch(n_cur) + 1) * LT_EPOCH_REPORTS;
@@ -2922,7 +2930,15 @@ static void send_report(bool with_fix, const lt_wake_out_t *d, bool answer)
 		s_iv = next_interval_s();
 		hello_s = flood_next_in_s = cfg.listen_s + s_iv;
 		if (!test_left && !ping_requested) {
-			planned_due_ms = k_uptime_get() + (int64_t)hello_s * 1000;
+			/* 0.10.1: the interval runs from wake-up to wake-up, not from this report, so a
+			 * GPS search and the listen window do not stretch it (field test 2026-11-27:
+			 * Track 10 min gave a report every 11 to 13 min). next_in adds this wake-up's search. */
+			int64_t now = k_uptime_get();
+			int64_t due = wake_ms ? wake_ms + (int64_t)s_iv * 1000 : now + (int64_t)hello_s * 1000;
+
+			due = MAX(due, now + (int64_t)cfg.listen_s * 1000);
+			planned_due_ms = due;
+			hello_s = flood_next_in_s = (uint32_t)((due - now) / 1000) + rp.search_s;
 		}
 	} else {
 		uint8_t ks[32];
@@ -8466,6 +8482,13 @@ static void cli_exec(char *l)
 		cmd.args[4] = du >> 8;
 		apply_command(&cmd);
 		pending_ack = false;
+		if (phase == PH_SLEEP) {
+			/* 0.10.1: the mode's first report now, as after a mesh command (field test
+			 * 2026-11-27: it waited 30 min for the next IDLE wake-up) */
+			wake_forced = true;
+			planned_due_ms = 0;
+			schedule_next(1);
+		}
 		out("OK\r\n");
 	} else if (!strcmp(c, "idle")) {
 		if (mode != LT_MODE_IDLE) {
