From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Sun, 22 Nov 2026 11:54:17 +0100
Subject: [PATCH 41/50] tracker 0.9.5: console wake advert from the owner's
 phone (company 0xFFFF, type 0x26, salt, HMAC(usb_key, LT2-bcon-wake ||
 salt)[0:6]): every presence, LOST and command scan also looks for it, a salt
 not taken in this boot and one HMAC, then the console window opens for 180 s
 as with BLE_CONSOLE (paired, above the transmit floor, not closed after 5
 failed handshakes); no n, no report; 8 salts kept since boot, at most 16
 HMACs a scan; blecmd shows wake_seen/wake_taken, blecmd adv takes a 13 B wake
 payload

---
 zephcore/src/lt_version.h     |   2 +-
 zephcore/src/main_tracker.cpp | 118 ++++++++++++++++++++++++++++++++--
 2 files changed, 115 insertions(+), 5 deletions(-)

diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index 82bc018..a9ac947 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.9.4"
+#define LT_FW_VERSION "0.9.5"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index 181ee97..09ffe41 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -372,6 +372,27 @@ static int64_t blecmd_arm_ms;
 #if defined(CONFIG_PM) && defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
 static bool blecmd_held;               /* ESP32: no light sleep during the command scan */
 #endif
+#if BCON
+/* 0.9.5: console wake advert from the owner's phone (PROTOCOL.md 3.2): company 0xFFFF, type 0x26,
+ * salt, HMAC(usb_key, "LT2-bcon-wake" || salt)[0:6]. Every scan that looks for a command advert
+ * also looks for it; a match opens the console window like a BLE_CONSOLE command, without n. */
+#define BCONWAKE_SALTS 8               /* salts taken since boot: a replay in this boot is refused */
+#define BCONWAKE_HMACS 16              /* HMACs per scan at most (a flood of foreign 0x26 adverts) */
+static volatile bool bconwake_armed;   /* the scan callback copies a 0x26 advert */
+static volatile bool bconwake_full;    /* bconwake_buf holds one not yet checked */
+static uint8_t bconwake_buf[LT_BCON_WAKE_LEN];
+static uint8_t bconwake_salts[BCONWAKE_SALTS][6];
+static uint8_t bconwake_nsalts, bconwake_next;
+static uint8_t bconwake_hmacs;         /* this scan */
+static bool bconwake_inject;           /* console `blecmd adv <26 hex>`: fed at the next scan */
+static uint8_t bconwake_inject_buf[LT_BCON_WAKE_LEN];
+static uint32_t bconwake_seen, bconwake_taken;
+#define BCONWAKE_SEEN bconwake_seen
+#define BCONWAKE_TAKEN bconwake_taken
+#else
+#define BCONWAKE_SEEN 0u
+#define BCONWAKE_TAKEN 0u
+#endif
 #endif
 
 /* packets of one wake-up, sent back to back before the LISTEN window */
@@ -1409,6 +1430,9 @@ static void go_to_sleep(void)
 	blecmd_armed = false;
 	blecmd_taken = false; /* 0.9.3: per wake-up (a listen-only one that took a command looks on) */
 	owner_finish_pending = false;
+#if BCON
+	bconwake_armed = false;
+#endif
 #endif
 	energy_wake_end(wake_start_ms, phase == PH_LISTEN && listen_start_ms ? k_uptime_get() - listen_start_ms : 0);
 	listen_only = false;
@@ -2638,6 +2662,18 @@ static void blecmd_arm(void)
 	owner_finish_pending = false;
 	blecmd_armed = false;
 	blecmd_arm_ms = k_uptime_get();
+#if BCON
+	/* 0.9.5: the wake advert needs no report: only a paired tag, and no window open yet */
+	bconwake_full = false;
+	bconwake_hmacs = 0;
+	bconwake_armed = keys.locked;
+	if (bconwake_inject) {
+		bconwake_inject = false;
+		memcpy(bconwake_buf, bconwake_inject_buf, LT_BCON_WAKE_LEN);
+		bconwake_full = true;
+		k_event_post(&events, EV_BLECMD);
+	}
+#endif
 	if (!n_report_valid || blecmd_taken) {
 		/* no report since boot: nothing to bind to; 0.9.3: or this wake-up took one already (a
 		 * listen-only wake-up that took a command and now looks) */
@@ -2718,6 +2754,49 @@ static void blecmd_handle(void)
 		wake_finish(false);
 	}
 }
+
+#if BCON
+/* 0.9.5: a 0x26 advert from the scan: a salt not taken in this boot, then one HMAC with usb_key.
+ * Ours opens the console window for LT_BCON_WINDOW_S as a BLE_CONSOLE command would: paired, above
+ * the transmit floor, not closed after LT_BCON_FAILS failed handshakes. The boot switch and the
+ * reset count do not apply (the owner asked). No report, no n, no acknowledgement. */
+static void bconwake_handle(void)
+{
+	uint8_t a[LT_BCON_WAKE_LEN];
+
+	if (!bconwake_full) {
+		return;
+	}
+	memcpy(a, bconwake_buf, sizeof(a));
+	bconwake_full = false;
+	bconwake_seen++;
+	if (!keys.locked || bcon_on || bconwake_hmacs >= BCONWAKE_HMACS) {
+		return; /* unpaired, the window is already open, or too many this scan */
+	}
+	for (uint8_t i = 0; i < bconwake_nsalts; i++) {
+		if (!memcmp(bconwake_salts[i], a + 1, 6)) {
+			return; /* taken before in this boot: a replay */
+		}
+	}
+	bconwake_hmacs++;
+	if (!lt_bcon_wake_match(keys.k.usb_key, a, sizeof(a))) {
+		return; /* another owner's phone, or a forgery */
+	}
+	int err = !tx_ok_now() ? -ENOSPC : bcon_open(LT_BCON_WINDOW_S);
+
+	if (err) {
+		LOG_WRN("blecon: wake advert, no window (%d)", err);
+		return;
+	}
+	memcpy(bconwake_salts[bconwake_next], a + 1, 6);
+	bconwake_next = (uint8_t)((bconwake_next + 1) % BCONWAKE_SALTS);
+	if (bconwake_nsalts < BCONWAKE_SALTS) {
+		bconwake_nsalts++;
+	}
+	bconwake_taken++;
+	LOG_INF("blecon: opened by the phone's wake advert for %u s", LT_BCON_WINDOW_S);
+}
+#endif
 #endif
 
 /* ------------------------------------------------------------------ position without GPS (experiment)
@@ -3184,6 +3263,19 @@ static void ble_scan_cb(const bt_addr_le_t *addr, int8_t rssi, uint8_t type, str
 			k_event_post(&events, EV_BLECMD);
 		}
 	}
+#if BCON
+	if (bconwake_armed && !bconwake_full &&
+	    (ble_purpose == BLE_PRESENCE || ble_purpose == BLE_LOST || ble_purpose == BLE_CHECK)) {
+		/* 0.9.5: the console wake advert: a walk and a type compare here, the HMAC in the loop */
+		const uint8_t *w = lt_bcon_wake_find(ad->data, ad->len);
+
+		if (w) {
+			memcpy(bconwake_buf, w, LT_BCON_WAKE_LEN);
+			bconwake_full = true;
+			k_event_post(&events, EV_BLECMD);
+		}
+	}
+#endif
 	if (ble_purpose == BLE_CHECK) {
 		return; /* 0.9.3: the command scan keeps no table (anchors are the presence scan's job) */
 	}
@@ -5150,6 +5242,19 @@ static bool cli_quiet(int argc, char **argv)
 #if IS_ENABLED(CONFIG_BT_OBSERVER)
 	if (!strcmp(c, "blecmd")) {
 		/* 0.7.7: blecmd: the command advert the next wake-up takes; blecmd adv <hex>: feed one in */
+#if BCON
+		if (argc == 3 && !strcmp(argv[1], "adv") && strlen(argv[2]) == 2 * LT_BCON_WAKE_LEN) {
+			/* 0.9.5: a console wake advert (26 ...), checked at the next scan like one on air */
+			if (parse_hex(argv[2], bconwake_inject_buf, LT_BCON_WAKE_LEN) ||
+			    bconwake_inject_buf[0] != LT_BCON_WAKE_TYPE) {
+				out("ERR blecmd adv <%u bytes hex, starting 26>\r\n", LT_BCON_WAKE_LEN);
+				return true;
+			}
+			bconwake_inject = true;
+			out("OK wake advert fed to the next wake-up's scan\r\n");
+			return true;
+		}
+#endif
 		if (argc == 3 && !strcmp(argv[1], "adv")) {
 			if (parse_hex(argv[2], blecmd_inject_buf, LT_BLE_CMD_LEN) || blecmd_inject_buf[0] != LT_TYPE_COMMAND) {
 				out("ERR blecmd adv <%u bytes hex, starting 22>\r\n", LT_BLE_CMD_LEN);
@@ -5164,17 +5269,19 @@ static bool cli_quiet(int argc, char **argv)
 		char h[2 * LT_TAG_LEN + 1];
 
 		if (!n_report_valid) {
-			out("BLECMD none (no report since boot) seen=%u taken=%u\r\n", blecmd_seen, blecmd_ok);
+			out("BLECMD none (no report since boot) seen=%u taken=%u wake_seen=%u wake_taken=%u\r\n",
+			    blecmd_seen, blecmd_ok, BCONWAKE_SEEN, BCONWAKE_TAKEN);
 			return true;
 		}
 		lt_command_tag_k(chk_key, n_report, k, tag);
 		hex(h, tag, sizeof(tag));
-		out("BLECMD n=%u k=%u tag=%s scan=%s seen=%u taken=%u scans=%u first_ms=%d\r\n", n_report, k, h,
+		out("BLECMD n=%u k=%u tag=%s scan=%s seen=%u taken=%u scans=%u first_ms=%d wake_seen=%u wake_taken=%u\r\n",
+		    n_report, k, h,
 		    mode == LT_MODE_LOST                                              ? "lost"
 		    : sched_keyed() && chk_k && !chk_hb && !lt_wake_reports(chk_k, chk_every) ? "check"
 		    : (mode == LT_MODE_IDLE && cfg.anchor_count)                      ? "presence"
 										      : "check",
-		    blecmd_seen, blecmd_ok, blecmd_scans, blecmd_first_ms);
+		    blecmd_seen, blecmd_ok, blecmd_scans, blecmd_first_ms, BCONWAKE_SEEN, BCONWAKE_TAKEN);
 		return true;
 	}
 	if (!strcmp(c, "blepkt")) {
@@ -5562,7 +5669,7 @@ static void cli_exec(char *l)
 		out("blecon [boot on|off | open [s] | close]: the Bluetooth console after a boot\r\n");
 #endif
 #if IS_ENABLED(CONFIG_BT_OBSERVER)
-		out("blecmd [adv <hex>]: the command advert the next wake-up takes from the owner's phone\r\n");
+		out("blecmd [adv <hex>]: the command or console wake advert the next scan takes from the phone\r\n");
 #endif
 		out("zone add <lat> <lon> <r_m>|list|del <i>|clear | quiet | lostble <every> [packets]\r\n");
 		out("anchor add addr|name|mfg|svc|irk <value> | anchor list|del <i>|clear|gps on|off|scan active|passive\r\n");
@@ -6174,6 +6281,9 @@ int main(void)
 #if IS_ENABLED(CONFIG_BT_OBSERVER)
 		if (ev & EV_BLECMD) {
 			blecmd_handle();
+#if BCON
+			bconwake_handle();
+#endif
 		}
 #endif
 		if ((ev & EV_OWNER) && phase == PH_WAIT_FIX) {
