+/* ------------------------------------------------------------------ field log (0.9.8)
+ * 48 B records, little endian, decoded by `libretag fieldlog` (host/src/libretag/fieldlog.py):
+ *   0 magic F1, 1 type, 2 phase, 3 mode, 4 u32 seq, 8 u32 uptime ms, 12 u32 unix s (0 unknown)
+ * FL_TX  16 u32 n_report, 20 kind, 21 j, 22 header byte, 23 path-length byte, 24 total length,
+ *        25 flags (1 alt network, 2 scoped, 4 USB power, 8 over the flood cap, 16 fix this wake-up,
+ *        32 an older fix), 26 u16 est. airtime ms, 28 u16 battery mV, 30 floods_24h (max 255),
+ *        31 satellites, 32 u32 hash, 36 u16 fix age s (FFFF none), 38 u16 transport code,
+ *        40 char[8] region (not NUL-terminated at 8)
+ * FL_RX  16 header byte, 17 path-length byte, 18 total length, 19 match (FLM_*; |0x80 path cut,
+ *        |0x40 heard on the alternate radio), 20 i8 SNR x4, 21 u8 -RSSI, 22 u16 transport code,
+ *        24 u32 hash, 28 path[12] (all, or the first 9 and the last 3 bytes when longer),
+ *        40 extra[8]: advert key[4] + type; discover answer key[4] + their SNR x4
+ * FL_WIN 16 kind (FLW_*), 17 1 open / 0 close, 20 u32 duration ms (close; check open: its
+ *        length), 24 u32 a, 28 u32 b (wake open: k, flags; wake close: packets, own copies;
+ *        listen: listen_s, relayed; check: k, n_report; discover open: seconds)
+ * FL_GPS 16 result (FLG_*), 17 satellites, 18 cold start pending, 20 u32 search ms,
+ *        24 i32 lat e7, 28 i32 lon e7, 32 i16 alt m, 36 u32 fix time, 40 u16 timeout s
+ * FL_EVT 16 EVT_* type, 17 a, 18 b, 19 quiet, 20 u16 c, 22 flags, 24 u32 x, 28 u32 n, 32 u16 mV
+ * The hash is CRC-32 (IEEE) of the payload type byte and the payload after the path, so a copy of
+ * our own report repeated by a repeater has the hash of the TX record. */
+static void fl_hdr(uint8_t *r, uint8_t type)
+{
+	r[1] = type;
+	r[2] = (uint8_t)phase;
+	r[3] = (uint8_t)mode;
+	sys_put_le32((uint32_t)k_uptime_get(), r + 8);
+	sys_put_le32(now_unix(), r + 12);
+}
+
+/* header, transport code, path and hash of a raw packet; false if it does not parse */
+static bool fl_parse(const uint8_t *b, size_t n, uint16_t *tcode, size_t *path_o, size_t *path_bytes,
+		     uint32_t *hash)
+{
+	if (n < 2) {
+		return false;
+	}
+	uint8_t route = b[0] & 0x03, ptype = (b[0] >> 2) & 0x0F;
+	size_t o = 1;
+
+	*tcode = 0;
+	if (route == 0x00 || route == 0x03) {
+		if (n < 6) {
+			return false;
+		}
+		*tcode = sys_get_le16(b + 1);
+		o += 4;
+	}
+	uint8_t pl = b[o++];
+	size_t pb = (size_t)((pl >> 6) + 1) * (pl & 0x3F);
+
+	if (n < o + pb) {
+		return false;
+	}
+	*path_o = o;
+	*path_bytes = pb;
+	*hash = crc32_ieee_update(crc32_ieee(&ptype, 1), b + o + pb, n - o - pb);
+	return true;
+}
+
+static void fl_tx(const uint8_t *pkt, size_t len, uint8_t kind, uint8_t j, bool alt)
+{
+	uint8_t r[LT_FL_REC] = {};
+	uint16_t tc = 0;
+	size_t po = 1, pb = 0;
+	uint32_t h = 0;
+	struct gps_state_info gi;
+	const char *scope = alt ? alt_net.scope : cfg.scope;
+
+	fl_hdr(r, FL_TX);
+	fl_parse(pkt, len, &tc, &po, &pb, &h);
+	gps_get_state_info(&gi);
+	sys_put_le32(n_report, r + 16);
+	r[20] = kind;
+	r[21] = j;
+	r[22] = pkt[0];
+	r[23] = len > po - 1 ? pkt[po - 1] : 0;
+	r[24] = (uint8_t)MIN(len, 255U);
+	r[25] = (alt ? 1 : 0) | (scope && scope[0] ? 2 : 0) | (board.isExternalPowered() ? 4 : 0) |
+		(over_cap() ? 8 : 0) | (fix_valid ? 16 : 0) | (!fix_valid && cfg.last_fix_time ? 32 : 0);
+	sys_put_le16((uint16_t)MIN(radio.getEstAirtimeFor((int)len), 65535U), r + 26);
+	sys_put_le16(board.getBattMilliVolts(), r + 28);
+	r[30] = (uint8_t)MIN(floods_24h(), 255U);
+	r[31] = (uint8_t)MIN(gi.satellites, 255);
+	sys_put_le32(h, r + 32);
+	sys_put_le16((uint16_t)MIN(gi.last_fix_age_s, 65535U), r + 36);
+	sys_put_le16(tc, r + 38);
+	if (scope) {
+		strncpy((char *)r + 40, scope, 8);
+	}
+	lt_fl_put(r);
+}
+
+static void fl_rx(const uint8_t *b, size_t n, int16_t rssi, float snr)
+{
+	uint8_t r[LT_FL_REC] = {};
+	uint16_t tc = 0;
+	size_t po = 1, pb = 0;
+	uint32_t h = 0;
+	uint8_t m = FLM_NONE;
+
+	fl_rx_n++;
+	fl_hdr(r, FL_RX);
+	r[16] = b[0];
+	r[18] = (uint8_t)MIN(n, 255U);
+	r[20] = (uint8_t)(int8_t)CLAMP((int)lroundf(snr * 4.0f), -128, 127);
+	r[21] = (uint8_t)CLAMP(-(int)rssi, 0, 255);
+	if (fl_parse(b, n, &tc, &po, &pb, &h)) {
+		uint8_t ptype = (b[0] >> 2) & 0x0F;
+		const uint8_t *pay = b + po + pb;
+		size_t pn = n - po - pb;
+		const uint8_t *gp;
+		size_t gl;
+
+		r[17] = b[po - 1];
+		sys_put_le16(tc, r + 22);
+		sys_put_le32(h, r + 24);
+		if (pb <= 12) {
+			memcpy(r + 28, b + po, pb);
+		} else {
+			memcpy(r + 28, b + po, 9);
+			memcpy(r + 37, b + po + pb - 3, 3);
+			m |= 0x80;
+		}
+		if (sent_payload_len && (gl = lt_packet_grp_payload(b, n, &gp)) == sent_payload_len &&
+		    !memcmp(gp, sent_payload, gl)) {
+			m |= FLM_OWN;
+			fl_own_n++;
+		} else if ((b[0] & 0x03) == 0x02 && ptype == 0x0B && n >= 16 && b[1] == 0 && (b[2] & 0xF0) == 0x90) {
+			m |= FLM_DISC;
+			memcpy(r + 40, b + 8, 4);
+			r[44] = b[3];
+		} else if (ptype == 0x04 && pn >= 101) {
+			m |= FLM_ADVERT;
+			memcpy(r + 40, pay, 4);
+			r[44] = pay[100] & 0x0F;
+		}
+	}
+	if (radio.hasRadioOverride()) {
+		m |= 0x40;
+	}
+	r[19] = m;
+	lt_fl_put(r);
+}
+
+static void fl_win(uint8_t kind, bool open, uint32_t dur_ms, uint32_t a, uint32_t b)
+{
+	uint8_t r[LT_FL_REC] = {};
+
+	fl_hdr(r, FL_WIN);
+	r[16] = kind;
+	r[17] = open ? 1 : 0;
+	sys_put_le32(dur_ms, r + 20);
+	sys_put_le32(a, r + 24);
+	sys_put_le32(b, r + 28);
+	lt_fl_put(r);
+}
+
+static void fl_gps(uint8_t result, uint32_t timeout_s)
+{
+	uint8_t r[LT_FL_REC] = {};
+	struct gps_position pos;
+
+	gps_get_position(&pos);
+	fl_hdr(r, FL_GPS);
+	r[16] = result;
+	r[17] = (uint8_t)MIN(pos.satellites, 255);
+	r[18] = first_fix_pending ? 1 : 0;
+	sys_put_le32(fl_gps_ms && result != FLG_START ? (uint32_t)(k_uptime_get() - fl_gps_ms) : 0, r + 20);
+	if (result == FLG_FIX) {
+		sys_put_le32((uint32_t)(int32_t)llround(fix_lat * 1e7), r + 24);
+		sys_put_le32((uint32_t)(int32_t)llround(fix_lon * 1e7), r + 28);
+		sys_put_le16((uint16_t)(int16_t)CLAMP(fix_alt_m, -32768, 32767), r + 32);
+		sys_put_le32(fix_time, r + 36);
+	}
+	sys_put_le16((uint16_t)MIN(timeout_s, 65535U), r + 40);
+	lt_fl_put(r);
 }
 
