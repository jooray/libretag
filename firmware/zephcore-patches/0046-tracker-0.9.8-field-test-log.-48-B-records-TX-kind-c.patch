--- /dev/null
+++ b/zephcore/src/lt_fieldlog.c
@@ -0,0 +1,267 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * LibreTag 0.9.8: field-test log storage. See lt_fieldlog.h.
+ */
+
+#include "lt_fieldlog.h"
+
+#include <zephyr/kernel.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/fs/fs.h>
+#include <zephyr/logging/log.h>
+#include <zephyr/sys/byteorder.h>
+#include <string.h>
+#include <stdio.h>
+
+#include "../adapters/datastore/ZephyrFsFormat.h"
+
+LOG_MODULE_REGISTER(lt_fieldlog, LOG_LEVEL_INF);
+
+#if DT_NODE_EXISTS(DT_NODELABEL(qspi_lfs))
+/* 2 MB QSPI, empty on the tracker: 2 x 8192 x 48 B = 768 KB, the newest 8192..16384 records */
+#define FL_EXT 1
+#define FL_FMT "/ext/fl%u"
+#define FL_MNT "/ext"
+#define FL_SEG_RECS 8192
+#else
+/* internal volume only (ESP32-S3: 384 KB /lfs shared with the state and history): 2 x 640 x 48 B */
+#define FL_EXT 0
+#define FL_FMT "/lfs/libretag/fl%u"
+#define FL_MNT "/lfs"
+#define FL_SEG_RECS 640
+#endif
+
+#define FL_BUF 32
+
+static uint8_t buf[FL_BUF][LT_FL_REC];
+static uint32_t buf_n;
+static uint8_t seg;
+static uint32_t seg_count; /* records in the current segment */
+static uint32_t other_count;
+static uint32_t seq;
+static uint32_t lost, errors, flushes;
+static bool ready;
+
+static void seg_name(char *b, size_t n, unsigned s) { snprintf(b, n, FL_FMT, s); }
+
+static bool vol_begin(void)
+{
+#if FL_EXT
+	if (!zephcore_fs_mount_ext()) {
+		errors++;
+		return false;
+	}
+#endif
+	return true;
+}
+
+static void vol_end(void)
+{
+#if FL_EXT
+	zephcore_fs_ext_power_down(); /* unmounts /ext and sends the flash to deep power-down */
+#endif
+}
+
+/* records in a segment file and the seq after its last record */
+static uint32_t seg_scan(unsigned s, uint32_t *next_seq)
+{
+	struct fs_dirent st;
+	struct fs_file_t f;
+	char name[32];
+	uint8_t r[LT_FL_REC];
+	uint32_t cnt;
+
+	seg_name(name, sizeof(name), s);
+	if (fs_stat(name, &st) != 0) {
+		return 0;
+	}
+	cnt = (uint32_t)(st.size / LT_FL_REC);
+	if (!cnt) {
+		return 0;
+	}
+	fs_file_t_init(&f);
+	if (fs_open(&f, name, FS_O_READ) == 0) {
+		if (fs_seek(&f, (off_t)(cnt - 1) * LT_FL_REC, FS_SEEK_SET) == 0 &&
+		    fs_read(&f, r, LT_FL_REC) == LT_FL_REC && r[0] == LT_FL_MAGIC) {
+			uint32_t q = sys_get_le32(r + 4) + 1;
+
+			if (q > *next_seq) {
+				*next_seq = q;
+			}
+		}
+		fs_close(&f);
+	}
+	return cnt;
+}
+
+void lt_fl_init(void)
+{
+	uint32_t c[2];
+
+	if (!vol_begin()) {
+		LOG_ERR("field log: no volume");
+		return;
+	}
+	seq = 0;
+	c[0] = seg_scan(0, &seq);
+	c[1] = seg_scan(1, &seq);
+	seg = (c[0] >= FL_SEG_RECS && c[1] < FL_SEG_RECS) ? 1 : 0;
+	if (c[0] >= FL_SEG_RECS && c[1] >= FL_SEG_RECS) {
+		char name[32];
+
+		seg_name(name, sizeof(name), 0);
+		fs_unlink(name);
+		c[0] = 0;
+		seg = 0;
+	}
+	seg_count = c[seg];
+	other_count = c[seg ^ 1];
+	vol_end();
+	ready = true;
+	LOG_INF("field log: %u + %u records, seq %u", seg_count, other_count, seq);
+}
+
+void lt_fl_flush(void)
+{
+	struct fs_file_t f;
+	char name[32];
+	bool open = false;
+
+	if (!ready || !buf_n) {
+		return;
+	}
+	if (!vol_begin()) {
+		lost += buf_n;
+		buf_n = 0;
+		return;
+	}
+	fs_file_t_init(&f);
+	for (uint32_t i = 0; i < buf_n; i++) {
+		if (seg_count >= FL_SEG_RECS) {
+			if (open) {
+				fs_close(&f);
+				open = false;
+			}
+			seg ^= 1;
+			other_count = seg_count;
+			seg_count = 0;
+			seg_name(name, sizeof(name), seg);
+			fs_unlink(name);
+		}
+		if (!open) {
+			seg_name(name, sizeof(name), seg);
+			fs_file_t_init(&f);
+			if (fs_open(&f, name, FS_O_CREATE | FS_O_WRITE | FS_O_APPEND) < 0) {
+				errors++;
+				lost += buf_n - i;
+				break;
+			}
+			open = true;
+		}
+		if (fs_write(&f, buf[i], LT_FL_REC) != LT_FL_REC) {
+			errors++;
+			lost++;
+			continue;
+		}
+		seg_count++;
+	}
+	if (open) {
+		fs_close(&f);
+	}
+	buf_n = 0;
+	flushes++;
+	vol_end();
+}
+
+void lt_fl_put(uint8_t *rec)
+{
+	rec[0] = LT_FL_MAGIC;
+	sys_put_le32(seq++, rec + 4);
+	if (!ready) {
+		lost++;
+		return;
+	}
+	if (buf_n >= FL_BUF) {
+		lt_fl_flush();
+	}
+	if (buf_n < FL_BUF) {
+		memcpy(buf[buf_n++], rec, LT_FL_REC);
+	} else {
+		lost++;
+	}
+}
+
+uint32_t lt_fl_each(void (*fn)(const uint8_t *rec, void *user), void *user)
+{
+	unsigned order[2] = {(unsigned)(seg ^ 1), seg};
+	uint8_t r[LT_FL_REC];
+	uint32_t n = 0;
+
+	if (!ready) {
+		return 0;
+	}
+	lt_fl_flush();
+	if (!vol_begin()) {
+		return 0;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		struct fs_file_t f;
+		char name[32];
+
+		seg_name(name, sizeof(name), order[k]);
+		fs_file_t_init(&f);
+		if (fs_open(&f, name, FS_O_READ) < 0) {
+			continue;
+		}
+		while (fs_read(&f, r, LT_FL_REC) == LT_FL_REC) {
+			if (r[0] == LT_FL_MAGIC) {
+				fn(r, user);
+				n++;
+			}
+		}
+		fs_close(&f);
+	}
+	vol_end();
+	return n;
+}
+
+void lt_fl_clear(void)
+{
+	char name[32];
+
+	buf_n = 0;
+	if (!ready || !vol_begin()) {
+		return;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		seg_name(name, sizeof(name), i);
+		fs_unlink(name);
+	}
+	seg = 0;
+	seg_count = 0;
+	other_count = 0;
+	vol_end();
+}
+
+void lt_fl_get_info(struct lt_fl_info *o)
+{
+	struct fs_statvfs sv;
+
+	memset(o, 0, sizeof(*o));
+	o->path = FL_FMT;
+	o->seg_recs = FL_SEG_RECS;
+	o->count = seg_count + other_count;
+	o->seq = seq;
+	o->buffered = buf_n;
+	o->lost = lost;
+	o->errors = errors;
+	o->flushes = flushes;
+	o->ready = ready;
+	if (ready && vol_begin()) {
+		if (fs_statvfs(FL_MNT, &sv) == 0) {
+			o->vol_kb = (uint32_t)((uint64_t)sv.f_frsize * sv.f_blocks / 1024);
+			o->free_kb = (uint32_t)((uint64_t)sv.f_frsize * sv.f_bfree / 1024);
+		}
+		vol_end();
+	}
+}
diff --git a/zephcore/src/lt_fieldlog.h b/zephcore/src/lt_fieldlog.h
new file mode 100644
index 0000000..2cd3e75
--- /dev/null
+++ b/zephcore/src/lt_fieldlog.h
@@ -0,0 +1,57 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * LibreTag 0.9.8: field-test log. Fixed 48 B records (TX, RX, windows, GPS, state events) in RAM,
+ * flushed in batches to two append-only segments: on boards with the QSPI flash (Wio Tracker L1)
+ * /ext/fl0, /ext/fl1 (the flash is mounted for the flush and put back into deep power-down after
+ * it); elsewhere /lfs/libretag/fl0, fl1 (smaller). The older segment is dropped when the current
+ * one is full. The records hold positions: they stay on the tag and leave it only over the
+ * unlocked USB console (`fieldlog dump`). Main thread only.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LT_FL_REC 48
+#define LT_FL_MAGIC 0xF1
+
+/* every record: magic, type, phase, mode, u32 seq (set by lt_fl_put), u32 uptime ms, u32 unix s */
+struct lt_fl_info {
+	const char *path;   /* segment name format */
+	uint32_t seg_recs;  /* records per segment */
+	uint32_t count;     /* records on flash */
+	uint32_t seq;       /* next sequence number */
+	uint32_t buffered;  /* in RAM, not yet written */
+	uint32_t lost;      /* records not written (buffer overflow while the store failed) */
+	uint32_t errors;    /* failed mounts, opens or writes */
+	uint32_t flushes;
+	uint32_t vol_kb, free_kb; /* the volume holding the log (0 if unknown) */
+	bool ready;
+};
+
+/* Once at boot, after /lfs is mounted. */
+void lt_fl_init(void);
+
+/* A record (LT_FL_REC bytes): seq is filled in; written at the next flush or when the buffer is full. */
+void lt_fl_put(uint8_t *rec);
+
+/* Write the buffer out (end of a wake-up, before a reset, before a dump). */
+void lt_fl_flush(void);
+
+/* Every record on flash, oldest first. Flushes first. Returns the count. */
+uint32_t lt_fl_each(void (*fn)(const uint8_t *rec, void *user), void *user);
+
+/* Delete the log (both segments and the buffer); seq goes on. */
+void lt_fl_clear(void);
+
+void lt_fl_get_info(struct lt_fl_info *out);
+
+#ifdef __cplusplus
+}
+#endif
