 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index ae27925..5cda371 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -1541,14 +1541,46 @@ static void add_low_battery_dm(uint8_t pct)
 }
 #endif
 
+#if !NOSTR
+#error "report sealing v2 commits to the mailbox key pk_n: the tracker needs CONFIG_LIBRETAG_NOSTR (libsecp256k1)"
+#endif
+
+/* 0.9.0, report sealing v2: one public key per sealed copy, timed for `selftest` (pk_us) */
+static uint32_t mbpk_last_us;
+
+static uint32_t cyc_us(uint32_t cyc)
+{
+	return (uint32_t)k_cyc_to_us_floor64(cyc);
+}
+
+/* pk_n = sk_n * G (PROTOCOL.md 4): every mailbox event for report n is signed with sk_n */
+static bool mailbox_pk(const uint8_t cmd_e[32], uint32_t n, uint8_t pk[32], uint32_t *us)
+{
+	uint8_t sk[32];
+	uint32_t t0 = k_cycle_get_32();
+	lt_mailbox_sk(cmd_e, n, sk);
+	bool ok = lt_secp_pubkey(sk, pk);
+	memset(sk, 0, sizeof(sk));
+	if (us) {
+		*us = cyc_us(k_cycle_get_32() - t0);
+	}
+	return ok;
+}
+
 /* Report n, copy j, into the TX queue (PROTOCOL.md 2). */
 static bool txq_add_report(const lt_report_t *r, uint32_t n, uint8_t j)
 {
+	uint8_t pk[32];
+
 	if (txq_n >= TXQ_MAX) {
 		return false;
 	}
-	size_t l = cfg.channel_mode ? lt_build_channel_report_packet(keys.k.view, chan_key, n, j, r, txq[txq_n])
-				    : lt_build_stealth_report_packet(keys.k.view, n, j, r, txq[txq_n]);
+	if (!mailbox_pk(keys.k.cmd, n, pk, &mbpk_last_us)) {
+		LOG_ERR("mailbox key n=%u failed", n);
+		return false;
+	}
+	size_t l = cfg.channel_mode ? lt_build_channel_report_packet(keys.k.view, pk, chan_key, n, j, r, txq[txq_n])
+				    : lt_build_stealth_report_packet(keys.k.view, pk, n, j, r, txq[txq_n]);
 	if (!l) {
 		return false;
 	}
@@ -1828,7 +1860,7 @@ static void hist_silent(const lt_wake_out_t *d)
 	h.search_s = wake_ms ? (uint16_t)MIN((k_uptime_get() - wake_ms) / 1000, 65535) : 0;
 	h.flags = HF_FIX;
 	h.flags2 = HF2_QUIET | (r.quiet_owner ? HF2_OWNER : r.quiet_parked ? HF2_PARKED : HF2_ZONE);
-	h.p_len = (uint8_t)lt_seal_report(keys.k.view, n_cur, LT_J_HIST_SILENT, &r, false, h.p);
+	h.p_len = (uint8_t)lt_seal_report(keys.k.view, NULL, n_cur, LT_J_HIST_SILENT, &r, false, h.p);
 	hist_write(&h);
 }
 
@@ -1958,7 +1990,7 @@ static void send_report(bool with_fix, const lt_wake_out_t *d)
 			    (r.quiet ? (r.quiet_owner ? HF2_OWNER : r.quiet_parked ? HF2_PARKED : HF2_ZONE) : 0) |
 			    (d->epoch_skip ? HF2_EPOCH_SKIP : 0) | (r.has_wifi ? HF2_WIFI : 0) |
 			    (check_cmd ? HF2_CHECK : 0);
-		h->p_len = (uint8_t)lt_seal_report(keys.k.view, n_cur, LT_J_HIST, &r, false, h->p);
+		h->p_len = (uint8_t)lt_seal_report(keys.k.view, NULL, n_cur, LT_J_HIST, &r, false, h->p);
 		hist_open = true;
 		wake_ms = 0;
 	}
@@ -4574,6 +4606,15 @@ static void print_selftest(void)
 	}
 	out(" empty_retried=%u", (unsigned)wscan_retries);
 #endif
+	/* 0.9.0: time of one mailbox public key (report sealing v2), on a fixed public test key, and of
+	 * the last report's; no key material */
+	{
+		static const uint8_t zero_chain[32] = {0};
+		uint8_t pk[32];
+		uint32_t us = 0;
+		bool ok = mailbox_pk(zero_chain, 0, pk, &us);
+		out(" pk=%s pk_us=%u pk_last_us=%u", ok ? "ok" : "failed", (unsigned)us, (unsigned)mbpk_last_us);
+	}
 	/* whether an owner npub is stored (not which): the pairing wizard's last step */
 	out(" owner=%s uptime=%us\r\n", cfg.has_owner ? "set" : "none", (unsigned)up);
 }
