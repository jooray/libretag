+/* blesurvey: repeated scans; which addresses and which payloads (fp) come back each round */
+struct ble_track {
+	bt_addr_le_t addr;
+	uint16_t fp;
+	int8_t rssi_max;
+	uint32_t rounds; /* bit per round */
+};
+
+struct ble_fpt {
+	uint16_t fp;
+	uint16_t company;
+	uint8_t addrs;   /* distinct addresses with this payload */
+	int8_t rssi_max;
+	uint32_t rounds;
+	char name[16];
+};
+
+#define BLE_TRACK_MAX 128
+#define BLE_FP_MAX 48
+static struct ble_track bsv_tr[BLE_TRACK_MAX];
+static struct ble_fpt bsv_fp[BLE_FP_MAX];
+static uint8_t bsv_ntr, bsv_nfp;
+static struct {
+	bool on, gap, active, quiet;
+	uint8_t rounds, done;
+	uint16_t scan_s, gap_s;
+} bsv;
+
+static void bsv_round_end(void)
+{
+	uint8_t fresh = 0;
+	uint32_t bit = BIT(bsv.done);
+
 	for (uint8_t i = 0; i < ble_n; i++) {
 		const struct ble_seen *e = &ble_tab[i];
-		const uint8_t *v = e->addr.a.val;
+		uint16_t fp = ble_fp(e);
+		struct ble_track *t = NULL;
+
+		for (uint8_t j = 0; j < bsv_ntr; j++) {
+			if (bt_addr_le_eq(&bsv_tr[j].addr, &e->addr)) {
+				t = &bsv_tr[j];
+			}
+		}
+		bool new_addr = !t;
+
+		if (!t && bsv_ntr < BLE_TRACK_MAX) {
+			t = &bsv_tr[bsv_ntr++];
+			bt_addr_le_copy(&t->addr, &e->addr);
+			t->rssi_max = -127;
+			t->rounds = 0;
+		}
+		fresh += new_addr;
+		if (t) {
+			t->fp = fp;
+			t->rounds |= bit;
+			t->rssi_max = MAX(t->rssi_max, e->rssi_max);
+		}
+		struct ble_fpt *f = NULL;
 
-		out(" %02X:%02X:%02X:%02X:%02X:%02X %-6s rssi %d x%u co %04X \"%s\"\r\n", v[5], v[4], v[3], v[2], v[1],
-		    v[0], ble_addr_kind(&e->addr), e->rssi, e->heard, e->company, e->name);
+		for (uint8_t j = 0; j < bsv_nfp; j++) {
+			if (bsv_fp[j].fp == fp) {
+				f = &bsv_fp[j];
+			}
+		}
+		if (!f && bsv_nfp < BLE_FP_MAX) {
+			f = &bsv_fp[bsv_nfp++];
+			memset(f, 0, sizeof(*f));
+			f->fp = fp;
+			f->company = e->company;
+			f->rssi_max = -127;
+			strncpy(f->name, e->name, sizeof(f->name) - 1);
+		}
+		if (f) {
+			f->rounds |= bit;
+			f->rssi_max = MAX(f->rssi_max, e->rssi_max);
+			if (new_addr) {
+				f->addrs = (uint8_t)MIN(f->addrs + 1, 255);
+			}
+		}
+	}
+	out("R %u/%u %us %s: %u adv, %u dev, %u new addr, %u dropped\r\n", bsv.done + 1, bsv.rounds, bsv.scan_s,
+	    bsv.active ? "active" : "passive", (unsigned)ble_adv_total, ble_n, fresh, (unsigned)ble_dropped);
+	if (!bsv.quiet) {
+		ble_print_sorted();
+	}
+}
