+/* long console output: wait for room in the USB ring instead of dropping lines
+ * (bounded, so nothing hangs when no one listens) */
+static void ble_write(const char *s, size_t n)
+{
+	for (int i = 0; i < 100 && cli.availableForWrite() < (int)n; i++) {
+		k_msleep(2);
+	}
+	cli.write((const uint8_t *)s, n);
+}
+
+static void ble_cat(char *b, size_t sz, size_t *l, const char *fmt, ...)
+{
+	va_list ap;
+
+	if (*l >= sz) {
+		return;
+	}
+	va_start(ap, fmt);
+	int r = vsnprintf(b + *l, sz - *l, fmt, ap);
+	va_end(ap);
+	if (r > 0) {
+		*l = MIN(*l + (size_t)r, sz - 1);
+	}
+}
+
+static void ble_print_dev(const struct ble_seen *e)
+{
+	char b[360], h[2 * 16 + 1];
+	size_t l = 0;
+	const uint8_t *v = e->addr.a.val;
+
+	ble_cat(b, sizeof(b), &l, "D %02X:%02X:%02X:%02X:%02X:%02X %s rssi=%d/%d/%d n=%u", v[5], v[4], v[3], v[2],
+		v[1], v[0], ble_addr_kind(&e->addr), e->rssi_min, (int)(e->rssi_sum / MAX(e->heard, 1)),
+		e->rssi_max, e->heard);
+	if (e->rsp) {
+		ble_cat(b, sizeof(b), &l, " rsp=%u", e->rsp);
+	}
+	ble_cat(b, sizeof(b), &l, " pdu=%02x conn=%u", e->props, (e->props & (BIT(0) | BIT(1))) ? 1 : 0);
+	if (e->flags) {
+		ble_cat(b, sizeof(b), &l, " fl=%02x", e->flags);
+	}
+	if (e->txp != 127) {
+		ble_cat(b, sizeof(b), &l, " tx=%d", e->txp);
+	}
+	if (e->appearance) {
+		ble_cat(b, sizeof(b), &l, " ap=%04x", e->appearance);
+	}
+	if (e->company != 0xFFFF) {
+		hex(h, e->mfg, MIN((size_t)e->mfg_len, sizeof(e->mfg)));
+		ble_cat(b, sizeof(b), &l, " co=%04X ml=%u m=%s mchg=%u", e->company, e->mfg_len, h, e->mfg_chg);
+	}
+	if (e->n16) {
+		ble_cat(b, sizeof(b), &l, " u16=");
+		for (uint8_t i = 0; i < e->n16; i++) {
+			ble_cat(b, sizeof(b), &l, i ? ",%04X" : "%04X", e->u16[i]);
+		}
+	}
+	if (e->n128) {
+		uint8_t be[16];
+
+		for (int i = 0; i < 16; i++) {
+			be[i] = e->u128[15 - i];
+		}
+		hex(h, be, 16);
+		ble_cat(b, sizeof(b), &l, " u128=%s", h);
+		if (e->n128 > 1) {
+			ble_cat(b, sizeof(b), &l, "+%u", e->n128 - 1);
+		}
+	}
+	if (e->sd_uuid) {
+		hex(h, e->sd, MIN((size_t)e->sd_len, sizeof(e->sd)));
+		ble_cat(b, sizeof(b), &l, " sd=%04X:%u:%s", e->sd_uuid, e->sd_len, h);
+	}
+	if (e->name_kind) {
+		ble_cat(b, sizeof(b), &l, " name%c=\"%s\"", e->name_kind == 2 ? 'C' : 'S', e->name);
+	}
+	ble_cat(b, sizeof(b), &l, " fp=%04X\r\n", ble_fp(e));
+	ble_write(b, l);
+}
