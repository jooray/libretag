+/* strongest first */
+static void ble_print_sorted(void)
+{
+	uint8_t idx[BLE_MAX];
+
+	for (uint8_t i = 0; i < ble_n; i++) {
+		idx[i] = i;
+	}
+	for (uint8_t i = 1; i < ble_n; i++) {
+		for (uint8_t j = i; j > 0 && ble_tab[idx[j]].rssi_max > ble_tab[idx[j - 1]].rssi_max; j--) {
+			uint8_t x = idx[j];
+
+			idx[j] = idx[j - 1];
+			idx[j - 1] = x;
+		}
+	}
+	for (uint8_t i = 0; i < ble_n; i++) {
+		ble_print_dev(&ble_tab[idx[i]]);
+	}
+}
