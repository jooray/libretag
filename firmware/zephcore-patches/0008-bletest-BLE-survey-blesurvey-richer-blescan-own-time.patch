+static void ble_merge(struct ble_seen *e, const struct ble_seen *t)
+{
+	e->rssi_min = MIN(e->rssi_min, t->rssi_min);
+	e->rssi_max = MAX(e->rssi_max, t->rssi_max);
+	e->rssi_sum += t->rssi_sum;
+	e->heard++;
+	e->rsp += t->rsp;
+	e->props |= t->props;
+	if (t->flags) {
+		e->flags = t->flags;
+	}
+	if (t->txp != 127) {
+		e->txp = t->txp;
+	}
+	if (t->appearance) {
+		e->appearance = t->appearance;
+	}
+	if (t->company != 0xFFFF) {
+		size_t l = MIN((size_t)t->mfg_len, sizeof(t->mfg));
+
+		if (e->company != 0xFFFF &&
+		    (e->company != t->company || e->mfg_len != t->mfg_len || memcmp(e->mfg, t->mfg, l))) {
+			e->mfg_chg = (uint8_t)MIN(e->mfg_chg + 1, 255);
+		}
+		e->company = t->company;
+		e->mfg_len = t->mfg_len;
+		memcpy(e->mfg, t->mfg, sizeof(e->mfg));
+	}
+	for (uint8_t i = 0; i < t->n16; i++) {
+		bool have = false;
+
+		for (uint8_t j = 0; j < e->n16; j++) {
+			have |= e->u16[j] == t->u16[i];
+		}
+		if (!have && e->n16 < BLE_U16_MAX) {
+			e->u16[e->n16++] = t->u16[i];
+		}
+	}
+	if (t->n128 && !e->n128) {
+		e->n128 = t->n128;
+		memcpy(e->u128, t->u128, 16);
+	}
+	if (t->sd_uuid && !e->sd_uuid) {
+		e->sd_uuid = t->sd_uuid;
+		e->sd_len = t->sd_len;
+		memcpy(e->sd, t->sd, sizeof(e->sd));
+	}
+	if (t->name_kind > e->name_kind) {
+		e->name_kind = t->name_kind;
+		memcpy(e->name, t->name, sizeof(e->name));
+	}
+}
