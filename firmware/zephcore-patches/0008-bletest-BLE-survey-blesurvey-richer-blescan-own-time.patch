+/* ble_tmr fired: end a scan, or start the next survey round */
+static void ble_timer(void)
+{
+	if (ble_scanning) {
+		if (!bsv.on) {
+			ble_scan_print();
+			return;
+		}
+		bt_le_scan_stop();
+		ble_scanning = false;
+		bsv_round_end();
+		if (++bsv.done >= bsv.rounds) {
+			bsv_final();
+			bsv.on = false;
+			return;
+		}
+		bsv.gap = true;
+		k_timer_start(&ble_tmr, bsv.gap_s ? K_SECONDS(bsv.gap_s) : K_MSEC(50), K_NO_WAIT);
+	} else if (bsv.on && bsv.gap) {
+		bsv.gap = false;
+		int err = ble_scan_start(bsv.active);
+
+		if (err) {
+			out("ERR bluetooth %d\r\nEND\r\n", err);
+			bsv.on = false;
