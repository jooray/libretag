+/* payload identity that does not depend on the address: maker + first maker byte (Apple:
+ * message type), name, uuids, appearance, service data uuid */
+static uint16_t ble_fp(const struct ble_seen *e)
+{
+	uint8_t b[6] = {(uint8_t)e->company, (uint8_t)(e->company >> 8), e->mfg_len ? e->mfg[0] : (uint8_t)0,
+			(uint8_t)e->appearance, (uint8_t)(e->appearance >> 8), e->n128};
+	uint16_t c = crc16_ccitt(0xFFFF, b, sizeof(b));
+
+	c = crc16_ccitt(c, (const uint8_t *)e->name, strlen(e->name));
+	c = crc16_ccitt(c, (const uint8_t *)e->u16, e->n16 * 2);
+	if (e->n128) {
+		c = crc16_ccitt(c, e->u128, 16);
+	}
+	c = crc16_ccitt(c, (const uint8_t *)&e->sd_uuid, 2);
+	return c;
+}
