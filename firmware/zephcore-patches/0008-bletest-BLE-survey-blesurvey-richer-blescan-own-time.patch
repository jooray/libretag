+static void bsv_final(void)
+{
+	char b[200];
+
+	out("S survey %u x %us gap %us %s: %u addresses, %u payloads\r\n", bsv.rounds, bsv.scan_s, bsv.gap_s,
+	    bsv.active ? "active" : "passive", bsv_ntr, bsv_nfp);
+	for (uint8_t i = 0; i < bsv_nfp; i++) {
+		const struct ble_fpt *f = &bsv_fp[i];
+		int l = snprintf(b, sizeof(b), "F fp=%04X seen=%u/%u addrs=%u rssi=%d co=%04X name=\"%s\" r=%08x\r\n",
+				 f->fp, (unsigned)__builtin_popcount(f->rounds), bsv.rounds, f->addrs, f->rssi_max,
+				 f->company, f->name, (unsigned)f->rounds);
+
+		ble_write(b, (size_t)MIN(l, (int)sizeof(b) - 1));
+	}
+	for (uint8_t i = 0; i < bsv_ntr; i++) {
+		const struct ble_track *t = &bsv_tr[i];
+		const uint8_t *v = t->addr.a.val;
+		int l = snprintf(b, sizeof(b), "A %02X:%02X:%02X:%02X:%02X:%02X %s seen=%u/%u rssi=%d fp=%04X r=%08x\r\n",
+				 v[5], v[4], v[3], v[2], v[1], v[0], ble_addr_kind(&t->addr),
+				 (unsigned)__builtin_popcount(t->rounds), bsv.rounds, t->rssi_max, t->fp,
+				 (unsigned)t->rounds);
+
+		ble_write(b, (size_t)MIN(l, (int)sizeof(b) - 1));
+	}
+	out("END\r\n");
+}
