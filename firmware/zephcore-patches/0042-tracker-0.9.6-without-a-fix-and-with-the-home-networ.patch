From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Sun, 22 Nov 2026 16:59:48 +0100
Subject: [PATCH 42/50] tracker 0.9.6: without a fix and with the home network
 silent for 3 listen windows, copy j=1 also goes to the previous network (the
 one before the last automatic switch;
 prev_preset/prev_country/prev_path_hash_size/prev_scope in the state, ext
 magic LT96, a 0.9.5 state migrates); not in manual mode, not over the flood
 cap, only on another radio than home; status and network show it

---
 zephcore/src/lt_version.h     |   2 +-
 zephcore/src/main_tracker.cpp | 128 ++++++++++++++++++++++++++++++++--
 2 files changed, 125 insertions(+), 5 deletions(-)

diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index a9ac947..ecfc574 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.9.5"
+#define LT_FW_VERSION "0.9.6"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index 09ffe41..9bf78bc 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -253,6 +253,14 @@ struct persisted {
 	uint8_t boot_deliberate;  /* the next boot follows `reboot` or `dfu`: not a reset */
 	uint8_t last_wzone;       /* 0.7.8: Wi-Fi zone index + 1 of the last decision, 0 = none (a boot
 				   * inside it keeps it with the "stay" threshold and reports quiet) */
+	/* 0.9.6 (ext magic "LT96"): the network before the last automatic switch. Without a fix and
+	 * with the home network silent, copy j=1 goes there (SPEC 6.4). */
+	uint8_t prev_preset;      /* lt_presets index + 1, 0 = none */
+	uint8_t prev_country;     /* lt_countries index */
+	uint8_t prev_path_hash_size;
+	uint8_t pad9;
+	char prev_scope[30];      /* region, "" = unscoped */
+	uint8_t pad9b[2];
 	uint32_t crc;             /* CRC-32 of everything before it */
 };
 
@@ -264,7 +272,12 @@ struct persisted {
 #define V6_SIZE offsetof(struct persisted, check_s)
 #define V7_SIZE offsetof(struct persisted, ext_magic)
 #define STATE_TMP STATE_DIR "/state.tmp"
-#define STATE_EXT_MAGIC 0x4C543736u /* "LT76" */
+#define STATE_EXT_MAGIC_76 0x4C543736u /* "LT76": 0.7.6 .. 0.9.5, crc right after last_wzone */
+#define STATE_EXT_MAGIC 0x4C543936u    /* "LT96": + the previous network (0.9.6) */
+#define EXT76_SIZE (offsetof(struct persisted, prev_preset) + sizeof(uint32_t))
+BUILD_ASSERT(offsetof(struct persisted, prev_preset) == offsetof(struct persisted, last_wzone) + 1 &&
+		     offsetof(struct persisted, prev_preset) % 4 == 0 && sizeof(struct persisted) % 4 == 0,
+	     "0.9.6 state: the new fields start where the 0.9.5 CRC was");
 #define BORDER_M 3000U /* within this of a border, the neighbour's network is a candidate */
 /* Second copy on the neighbour's network only when the home network was silent in this many
  * listen windows in a row: if home repeaters are audible (often true just across a border), they
@@ -871,6 +884,19 @@ static int state_read(const char *path, struct persisted *p)
 		if (r == (ssize_t)sizeof(*p)) {
 			return p->ext_magic == STATE_EXT_MAGIC && p->crc == state_crc(p) ? ST_OK : ST_BAD;
 		}
+		if (r == (ssize_t)EXT76_SIZE && p->ext_magic == STATE_EXT_MAGIC_76) {
+			/* written by 0.7.6 .. 0.9.5: its CRC sits where prev_preset starts now */
+			uint32_t c76;
+			size_t at = offsetof(struct persisted, prev_preset);
+
+			memcpy(&c76, (uint8_t *)p + at, sizeof(c76));
+			if (c76 != crc32_ieee((const uint8_t *)p, at)) {
+				return ST_BAD;
+			}
+			memset((uint8_t *)p + at, 0, sizeof(*p) - at);
+			p->ext_magic = STATE_EXT_MAGIC;
+			return ST_OK;
+		}
 		if (r == (ssize_t)V7_SIZE) {
 			/* written by 0.7.0 .. 0.7.5 (no CRC there): the extension starts empty */
 			memset((uint8_t *)p + V7_SIZE, 0, sizeof(*p) - V7_SIZE);
@@ -1135,6 +1161,18 @@ static void adopt_net(const lt_net_t *n)
 	bool radio_changed = !lt_preset_same_radio(&cur, p);
 	if (radio_changed) {
 		home_silent = 255; /* nothing known about the new network yet */
+		/* 0.9.6: remember the network we leave (only if its radio is a known preset) */
+		cfg.prev_preset = 0;
+		for (size_t i = 0; i < lt_preset_count; i++) {
+			if (lt_preset_same_radio(&cur, &lt_presets[i])) {
+				cfg.prev_preset = (uint8_t)(i + 1);
+				break;
+			}
+		}
+		cfg.prev_country = cfg.country;
+		cfg.prev_path_hash_size = cfg.path_hash_size;
+		memset(cfg.prev_scope, 0, sizeof(cfg.prev_scope));
+		strncpy(cfg.prev_scope, cfg.scope, sizeof(cfg.prev_scope) - 1);
 	}
 	cfg.freq = p->freq;
 	cfg.bw = p->bw;
@@ -1152,15 +1190,78 @@ static void adopt_net(const lt_net_t *n)
 		(double)p->freq, (double)p->bw, p->sf, p->cr, n->path_hash_size, sc[0] ? sc : "none");
 }
 
+/* 0.9.6: the network before the last automatic switch, if it is usable as a second network
+ * (a known preset on another radio than home). */
+static bool prev_net_get(lt_net_t *out)
+{
+	if (!cfg.prev_preset || cfg.prev_preset > lt_preset_count) {
+		return false;
+	}
+	const lt_preset_t *p = &lt_presets[cfg.prev_preset - 1];
+	lt_preset_t cur = {nullptr, cfg.freq, cfg.bw, cfg.sf, cfg.cr, cfg.path_hash_size};
+
+	if (lt_preset_same_radio(&cur, p)) {
+		return false;
+	}
+	cfg.prev_scope[sizeof(cfg.prev_scope) - 1] = 0;
+	out->country = cfg.prev_country;
+	out->preset = (uint8_t)(cfg.prev_preset - 1);
+	out->path_hash_size = cfg.prev_path_hash_size ? cfg.prev_path_hash_size : p->path_hash_size;
+	out->scope = cfg.prev_scope[0] ? cfg.prev_scope : nullptr;
+	return true;
+}
+
+/* `status`, `network`: the previous network and whether a no-fix copy can go there */
+static void print_prev_net(void)
+{
+	lt_net_t pn;
+
+	if (!cfg.prev_preset || cfg.prev_preset > lt_preset_count) {
+		out("previous network: none\r\n");
+		return;
+	}
+	const lt_preset_t *p = &lt_presets[cfg.prev_preset - 1];
+	bool usable = prev_net_get(&pn);
+
+	out("previous network: country %s, %s %.3f/%.1f/%u/%u path=%uB region %s", country_iso(cfg.prev_country),
+	    p->name, (double)p->freq, (double)p->bw, p->sf, p->cr, cfg.prev_path_hash_size,
+	    cfg.prev_scope[0] ? cfg.prev_scope : "none");
+	if (cfg.region_manual) {
+		out(" (unused: manual)\r\n");
+	} else if (usable) {
+		out(" (copy j=1 without a fix after %u silent windows)\r\n", HOME_SILENT_WINDOWS);
+	} else {
+		out(" (unused: same radio as home)\r\n");
+	}
+}
+
+static bool over_cap(void);
+
+static bool alt_is_prev; /* alt_net of this report is the previous network (no fix), not a border */
+
 /* Pick the network(s) for this position. Returns 1 or 2 (2: alt_net is set). */
 static size_t plan_networks(const lt_report_t *r)
 {
 	lt_net_t nets[LT_REGION_MAX_NETS];
 	size_t nn;
 
-	if (cfg.region_manual || !r->has_fix) {
+	alt_is_prev = false;
+	if (cfg.region_manual) {
 		return 1;
 	}
+	if (!r->has_fix) {
+		/* 0.9.6: without a fix the tag stays on its network. If that one has been silent, it may
+		 * have come back across a border without a fix (bag, car, indoors): copy j=1 also goes
+		 * to the network it was on before the last switch. Not over the daily flood cap. */
+		if (home_silent < HOME_SILENT_WINDOWS || over_cap() || !prev_net_get(&alt_net)) {
+			return 1;
+		}
+		if (alt_net.scope) {
+			lt_scope_key(alt_net.scope, alt_scope_key);
+		}
+		alt_is_prev = true;
+		return 2;
+	}
 	nn = lt_region_plan(r->lat_e7, r->lon_e7, BORDER_M, nets);
 	if (nn == 0) {
 		return 1; /* unknown country or the sea: stay where we are */
@@ -2119,7 +2220,11 @@ static void send_report(bool with_fix, const lt_wake_out_t *d)
 
 		if (txq_add_report(&r, n_cur, 1)) {
 			txq_alt[i] = true;
-			LOG_INF("border: copy j=1 on %s's network", country_iso(alt_net.country));
+			if (alt_is_prev) {
+				LOG_INF("no fix: copy j=1 on %s's network (previous)", country_iso(alt_net.country));
+			} else {
+				LOG_INF("border: copy j=1 on %s's network", country_iso(alt_net.country));
+			}
 		}
 	}
 #if IS_ENABLED(CONFIG_BT_OBSERVER)
@@ -4950,6 +5055,7 @@ static void print_status(void)
 	}
 	out("network %s: country %s, region %s\r\n", cfg.region_manual ? "manual" : "auto (GPS)",
 	    country_iso(cfg.country), cfg.scope[0] ? cfg.scope : "none");
+	print_prev_net();
 	print_quiet();
 #if IS_ENABLED(CONFIG_LIBRETAG_WIFI)
 	wz_print_status();
@@ -5661,7 +5767,7 @@ static void cli_exec(char *l)
 		out("log [count] | history [from_n]\r\n");
 		out("track <interval_s> <minutes> | idle | transport channel|stealth\r\n");
 		out("radio <MHz> <bwkHz> <sf> <cr> | power <dBm> | pathhash 1|2|3 | region <name>|none\r\n");
-		out("network auto|manual | where <lat> <lon> | test [count] [interval_s] | gps | reboot\r\n");
+		out("network [auto|manual] | where <lat> <lon> | test [count] [interval_s] | gps | reboot\r\n");
 		out("dfu [serial|ble|uf2]: reboot into the bootloader (serial DFU by default)\r\n");
 		out("meshscan [s] | discover [s] | neighbours | noise [n] | blescan [s] [passive] [full]\r\n");
 		out("blesurvey <rounds> <scan_s> <gap_s> [passive] [quiet] | blestop | blepair [s]\r\n");
@@ -6060,6 +6166,20 @@ static void cli_exec(char *l)
 		save_cfg();
 		apply_radio_cfg();
 		out("OK (network manual)\r\n");
+	} else if (!strcmp(c, "network") && argc == 1) {
+		const lt_preset_t *p = nullptr;
+		lt_preset_t cur = {nullptr, cfg.freq, cfg.bw, cfg.sf, cfg.cr, cfg.path_hash_size};
+
+		for (size_t i = 0; i < lt_preset_count; i++) {
+			if (lt_preset_same_radio(&cur, &lt_presets[i])) {
+				p = &lt_presets[i];
+				break;
+			}
+		}
+		out("network %s: country %s, %s %.3f/%.1f/%u/%u path=%uB region %s\r\n",
+		    cfg.region_manual ? "manual" : "auto (GPS)", country_iso(cfg.country), p ? p->name : "custom",
+		    (double)cfg.freq, (double)cfg.bw, cfg.sf, cfg.cr, cfg.path_hash_size, cfg.scope[0] ? cfg.scope : "none");
+		print_prev_net();
 	} else if (!strcmp(c, "network") && argc == 2) {
 		cfg.region_manual = !strcmp(argv[1], "manual");
 		save_cfg();
