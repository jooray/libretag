+/* ------------------------------------------------------------------ history
+ * Every report, sealed exactly as sent (copy j=0), plus diagnostics without a position, in a
+ * ring file. The app reads it over USB (`history`) and opens it with K0 like a report from the
+ * radio: the tracker stores only ciphertext and needs no keys for it. `log` prints the
+ * diagnostics: whether the GPS found a fix, how long it searched, whether a repeater relayed
+ * the report. */
+#define HIST_FILE STATE_DIR "/hist"
+#define HIST_CAP  512
+#define HIST_MAGIC 0xA7
+enum {
+	HF_FIX = 1, HF_RELAYED = 2, HF_RETX = 4, HF_DROPPED = 8, HF_CMD = 16, HF_BORDER = 32,
+	HF_DISCOVER = 64, HF_LOW = 128,
+};
+struct histrec {
+	uint8_t magic;
+	uint8_t flags;
+	uint8_t batt;
+	uint8_t mode;
+	uint32_t n;
+	uint32_t unix_s;     /* wake time from the GPS-set clock, 0 = unknown */
+	uint32_t uptime_s;
+	uint16_t search_s;   /* from wake to report: GPS search (and fix timeout) */
+	uint8_t nb_total;
+	uint8_t p_len;
+	uint8_t p[LT_REPORT_P_LEN_STEALTH]; /* sealed report as sent */
+	uint8_t pad;
+} __packed;
+BUILD_ASSERT(sizeof(struct histrec) == 72, "histrec size");
+
+static struct histrec hist_cur;
+static bool hist_open;
+static int64_t wake_ms;
+
+static void hist_write(const struct histrec *h)
+{
+	struct fs_file_t f;
+
+	fs_file_t_init(&f);
+	if (fs_open(&f, HIST_FILE, FS_O_CREATE | FS_O_RDWR) < 0) {
+		return;
+	}
+	if (fs_seek(&f, (off_t)(h->n % HIST_CAP) * sizeof(*h), FS_SEEK_SET) == 0) {
+		fs_write(&f, h, sizeof(*h));
+	}
+	fs_close(&f);
+}
+
+/* calls fn for each stored record with n >= from, oldest first */
+static void hist_each(uint32_t from, void (*fn)(const struct histrec *))
+{
+	static struct histrec all[HIST_CAP]; /* 36 KB, only while the console asks */
+	struct fs_file_t f;
+	size_t cnt = 0;
+
+	fs_file_t_init(&f);
+	if (fs_open(&f, HIST_FILE, FS_O_READ) < 0) {
+		return;
+	}
+	while (cnt < HIST_CAP && fs_read(&f, &all[cnt], sizeof(all[0])) == (ssize_t)sizeof(all[0])) {
+		if (all[cnt].magic == HIST_MAGIC && all[cnt].n >= from) {
+			cnt++;
+		}
+	}
+	fs_close(&f);
+	for (size_t i = 1; i < cnt; i++) { /* insertion sort by n */
+		struct histrec t = all[i];
+		size_t j = i;
+
+		while (j > 0 && all[j - 1].n > t.n) {
+			all[j] = all[j - 1];
+			j--;
+		}
+		all[j] = t;
+	}
+	for (size_t i = 0; i < cnt; i++) {
+		fn(&all[i]);
+	}
+}
+
+static void hist_clear(void)
+{
+	fs_unlink(HIST_FILE);
+	hist_open = false;
+}
