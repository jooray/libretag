+	}
 	out("n=%u mode=%d interval=%umin listen=%us fixto=%us transport=%s\r\n", n_cur, mode,
 	    cfg.interval_min, cfg.listen_s, cfg.fix_timeout_s, cfg.channel_mode ? "channel" : "stealth");
 	out("radio %.3f MHz bw=%.1f sf=%u cr=%u pwr=%d dBm path=%uB\r\n", (double)cfg.freq, (double)cfg.bw,
@@ -1988,20 +2029,20 @@ static void cli_exec(char *l)
 		static uint32_t want;
 		static uint32_t total;
 
-		want = argc >= 2 ? (uint32_t)CLAMP(atoi(argv[1]), 1, HIST_CAP) : 30;
+		want = argc >= 2 ? (uint32_t)CLAMP(atoi(argv[1]), 1, 2 * HIST_SEG_RECS) : 30;
 		total = 0;
