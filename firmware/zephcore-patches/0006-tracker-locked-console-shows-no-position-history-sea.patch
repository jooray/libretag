-						"where", "gps", "noise", "meshscan", "discover", "neighbours",
-						"blescan", "nostr", "buzz", "report", "test"};
+						"buzz"};
 
 	for (size_t i = 0; i < ARRAY_SIZE(open_cmds); i++) {
 		if (!strcmp(c, open_cmds[i])) {
@@ -1710,6 +1746,11 @@ static void print_status(void)
 		out("LIBRETAG KEY %s\r\n", k);
 	}
 	out("firmware LibreTag %s, ZephCore %s\r\n", LT_FW_VERSION, LT_ZEPHCORE_BASE);
+	if (keys.locked && !usb_unlocked()) {
