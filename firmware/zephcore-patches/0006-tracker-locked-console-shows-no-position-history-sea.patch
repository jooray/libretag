 			    h->flags & HF_RELAYED ? "relayed " : "not-relayed ", h->flags & HF_RETX ? "retx " : "",
 			    h->flags & HF_DROPPED ? "DROPPED " : "", h->flags & HF_CMD ? "cmd " : "",
@@ -2015,7 +2056,7 @@ static void cli_exec(char *l)
 			char hx[2 * sizeof(h->p) + 1];
 
 			hex(hx, h->p, MIN(h->p_len, sizeof(h->p)));
