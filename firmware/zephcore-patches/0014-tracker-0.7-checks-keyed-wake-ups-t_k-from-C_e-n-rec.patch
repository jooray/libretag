+/* 0.7: the next wake-up while quiet in IDLE: check k + 1 after report n_report, or the heartbeat when
+ * that check would fall at or after it. Idempotent until the scheduled time passes. 0 = none known. */
+static int64_t quiet_next_wake_ms(void)
+{
+	int64_t now = k_uptime_get();
+	uint32_t hb = lt_wake_heartbeat(&wake_cfg, wake_st.reason);
+
+	if (!n_report_valid || !chk_t0_ms || !hb || !chk_base_s) {
+		return 0;
+	}
+	for (;;) {
+		if (chk_due_ms > now + 500) {
+			return chk_due_ms;
+		}
+		if (chk_hb || chk_k >= 4096) {
+			return 0;
+		}
+		uint16_t k = (uint16_t)(chk_k + 1);
+		uint32_t off = (uint32_t)((int32_t)(chk_off_s + chk_base_s) + lt_check_jitter(chk_key, n_report, k,
+											       chk_base_s));
+		if (off >= hb) {
+			chk_hb = true; /* checks at or after the heartbeat are not made */
+			chk_k = 0;
+			chk_due_ms = chk_t0_ms + (int64_t)hb * 1000;
+			continue;
+		}
+		chk_k = k;
+		chk_off_s = off;
+		chk_due_ms = chk_t0_ms + (int64_t)off * 1000 - (cfg.check_s ? (int64_t)lt_check_guard_ms(off) : 0);
+	}
+}
