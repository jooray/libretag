 }
+/* 0.7.8: the Wi-Fi zone of the last decision survives a reboot (cfg.last_wzone), so the first
+ * wake-up after a boot inside it matches with the "stay" threshold and its report is quiet */
+static void wz_remember(void)
+{
+	int8_t z = wake_prev_wzone();
+	uint8_t v = z >= 0 ? (uint8_t)(z + 1) : 0;
+
+	if (cfg.last_wzone != v) {
+		cfg.last_wzone = v;
+		save_cfg();
+	}
+}
+
+static void wz_restore(void)
+{
+	if (cfg.last_wzone && cfg.last_wzone <= wz.count) {
+		wake_st.zone = (int8_t)(LT_WZONE_BASE + cfg.last_wzone - 1);
+	}
+}
 static void wz_print_status(void);
 #endif
 
