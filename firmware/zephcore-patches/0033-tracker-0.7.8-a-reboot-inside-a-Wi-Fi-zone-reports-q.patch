+/* Parsed NMEA sentences (the GNSS driver, ZephCore patch 0005); NULL without it. */
+extern "C" uint32_t zephcore_gnss_rx_count(void) __attribute__((weak));
+
+/* 0.7.8: `version` and `selftest`, on a locked console too: what works on this board, no keys,
+ * no position. nostr: the AES-256 and BIP-340 self-test at boot; gps: ZephCore's boot probe
+ * (no NMEA within 10 s of power-on = none); wifi: wake-up scans since boot, the first one's AP
+ * count, empty scans repeated; owner: whether one is stored (not which). */
+static void print_selftest(void)
+{
+	uint32_t up = (uint32_t)(k_uptime_get() / 1000);
+	unsigned nmea = zephcore_gnss_rx_count ? (unsigned)zephcore_gnss_rx_count() : 0U;
+
+	out("selftest nostr=%s gps=%s nmea=%u",
+#if NOSTR
+	    nostr_ok ? "ok" : (!nostr_aes_ok ? "failed(aes256)" : "failed(bip340)"),
+#else
+	    "off",
+#endif
+	    gps_is_available() ? (up < 11 && !nmea ? "probing" : "yes") : "none", nmea);
+#if IS_ENABLED(CONFIG_LIBRETAG_WIFI)
+	out(" wifi=%u scan(s)", (unsigned)wscan_wakes);
+	if (wscan_first >= 0) {
+		out(" first=%dAP", wscan_first);
+	}
+	out(" empty_retried=%u", (unsigned)wscan_retries);
+#endif
+	/* whether an owner npub is stored (not which): the pairing wizard's last step */
+	out(" owner=%s uptime=%us\r\n", cfg.has_owner ? "set" : "none", (unsigned)up);
+}
+
 static void print_quiet(void);
 
