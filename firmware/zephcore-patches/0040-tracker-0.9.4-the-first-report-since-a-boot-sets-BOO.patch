From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LibreTag <dev@libretag.invalid>
Date: Fri, 20 Nov 2026 07:45:05 +0100
Subject: [PATCH 40/41] tracker 0.9.4: the first report since a boot sets BOOT
 (byte 2 bit 2), also in its history record; without a fix byte 14 carries the
 reset cause (last_reset= word) and the resets in a row at boot (lt_boot_info)
 instead of the accuracy

---
 zephcore/src/lt_version.h     | 2 +-
 zephcore/src/main_tracker.cpp | 9 +++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/zephcore/src/lt_version.h b/zephcore/src/lt_version.h
index 8bf7756..82bc018 100644
--- a/zephcore/src/lt_version.h
+++ b/zephcore/src/lt_version.h
@@ -1,4 +1,4 @@
 /* Generated by firmware/tools/zephcore.sh; do not edit. */
 #pragma once
-#define LT_FW_VERSION "0.9.3"
+#define LT_FW_VERSION "0.9.4"
 #define LT_ZEPHCORE_BASE "da3513aa6d08"
diff --git a/zephcore/src/main_tracker.cpp b/zephcore/src/main_tracker.cpp
index a559bfd..181ee97 100644
--- a/zephcore/src/main_tracker.cpp
+++ b/zephcore/src/main_tracker.cpp
@@ -894,6 +894,10 @@ static lt_lost_state_t lost_st;    /* 0.7.6: LOST slow-down while the fixes stay
 /* 0.9.1: this boot's reset cause as LT_RST_* bits (helpers/boot_info: RESETREAS on the nRF52, the
  * ROM reset reason on the ESP32; a fatal error the last run recorded counts as a crash) */
 static uint8_t boot_rst;
+/* 0.9.4: the first report since this boot carries BOOT (byte 2 bit 2) and, without a fix, the
+ * cause and the resets in a row as they were at boot (byte 14, lt_boot_info) */
+static bool boot_report_due = true;
+static uint8_t boot_resets_at_boot;
 
 static uint8_t boot_reset_bits(void)
 {
@@ -990,6 +994,7 @@ static void load_cfg(void)
 					      lt_reset_deliberate(boot_rst, board.getBattMilliVolts(),
 								  board.isExternalPowered()));
 	cfg.boot_deliberate = 0;
+	boot_resets_at_boot = cfg.boot_resets;
 
 	struct keyrec a, b;
 	bool ka = false, kb = false;
@@ -1984,6 +1989,9 @@ static void send_report(bool with_fix, const lt_wake_out_t *d)
 	}
 	r.cmd_ack = pending_ack;
 	r.cmd_seq = last_cmd_seq;
+	/* 0.9.4: the first report since the boot says so; its history record (same r) too */
+	r.boot = boot_report_due;
+	r.boot_info = lt_boot_info(lt_boot_cause(boot_rst), boot_resets_at_boot);
 	fill_neighbours(&r); /* nearby repeaters, in every report (PROTOCOL.md 2) */
 	r.checks = cfg.check_s > 0; /* listens at checks while quiet (0.7) and between reports (0.7.3) */
 	if (d->action == LT_WAKE_REPORT_QUIET) {
@@ -2040,6 +2048,7 @@ static void send_report(bool with_fix, const lt_wake_out_t *d)
 	}
 	txq_reset();
 	txq_add_report(&r, n_cur, 0);
+	boot_report_due = false;
 	LOG_INF("report n=%u fix=%d batt=%u%% low=%d mode=%d quiet=%d next_in=%u len=%u", n_cur, r.has_fix, pct, low,
 		mode, r.quiet, lt_next_in_decode(r.next_in), (unsigned)txq_len[0]);
 	{
