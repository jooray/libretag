+	d->ad[d->ad_len++] = type;
+	memcpy(d->ad + d->ad_len, data, len);
+	d->ad_len += (uint8_t)len;
+}
+
+/* the record of one device: names and data first, then what identifies the kind of device */
+static void ble_to_dev(const struct ble_seen *e, lt_ble_dev_t *d)
+{
+	memset(d, 0, sizeof(*d));
+	for (int i = 0; i < 6; i++) {
+		d->addr[i] = e->addr.a.val[5 - i];
+	}
+	d->info = (uint8_t)(ble_kind(e) | ((e->props & (BIT(0) | BIT(1))) ? LT_BI_CONNECTABLE : 0) |
+			    (e->rsp ? LT_BI_SCAN_RSP : 0) | (e->anchor ? LT_BI_ANCHOR : 0));
+	d->rssi = e->rssi_max;
+	d->heard = (uint8_t)MIN(e->heard, 255);
+	if (e->name_kind) {
+		ble_ad_put(d, e->name_kind == 2 ? BT_DATA_NAME_COMPLETE : BT_DATA_NAME_SHORTENED, (const uint8_t *)e->name,
+			   strlen(e->name));
+	}
+	if (e->company != 0xFFFF) {
+		uint8_t m[2 + BLE_MFG_MAX];
+
+		sys_put_le16(e->company, m);
+		size_t l = MIN((size_t)e->mfg_len, sizeof(e->mfg));
+		memcpy(m + 2, e->mfg, l);
+		ble_ad_put(d, BT_DATA_MANUFACTURER_DATA, m, 2 + l);
+	}
+	if (e->sd_uuid) {
+		uint8_t m[2 + sizeof(e->sd)];
+
+		sys_put_le16(e->sd_uuid, m);
+		size_t l = MIN((size_t)e->sd_len, sizeof(e->sd));
+		memcpy(m + 2, e->sd, l);
+		ble_ad_put(d, BT_DATA_SVC_DATA16, m, 2 + l);
+	}
+	if (e->appearance) {
+		uint8_t m[2];
+
+		sys_put_le16(e->appearance, m);
+		ble_ad_put(d, BT_DATA_GAP_APPEARANCE, m, 2);
+	}
+	if (e->n16) {
+		uint8_t m[2 * BLE_U16_MAX];
+
+		for (uint8_t i = 0; i < e->n16; i++) {
+			sys_put_le16(e->u16[i], m + 2 * i);
+		}
+		ble_ad_put(d, BT_DATA_UUID16_SOME, m, 2u * e->n16);
+	}
+	if (e->txp != 127) {
+		uint8_t t = (uint8_t)e->txp;
+
+		ble_ad_put(d, BT_DATA_TX_POWER, &t, 1);
+	}
+	if (e->n128) {
+		ble_ad_put(d, BT_DATA_UUID128_SOME, e->u128, 16);
+	}
+}
+
+/* order of importance: the owner's devices, stable addresses, named rotating ones, the rest; louder first */
+static int ble_rank(const struct ble_seen *e)
+{
+	return e->anchor ? 0 : ble_stable(e) ? 1 : e->name_kind ? 2 : 3;
+}
+
+/* Summarise the last scan (for the next report) and queue up to max_packets BLE packets as copies
+ * j = 5 + k of report n. Returns the number queued. */
+static size_t ble_result_packets(uint32_t n, size_t max_packets, uint8_t seconds, bool active)
+{
+	static lt_ble_dev_t devs[BLE_MAX];
+	static uint8_t pts[LT_BLE_MAX_PACKETS][LT_BLE_PT_LEN];
+	uint8_t idx[BLE_MAX];
+	lt_ble_survey_t sv = {};
+	int8_t best = 0;
+
+	sv.seconds = seconds;
+	sv.active = active;
+	sv.devices = (uint8_t)MIN(ble_n, 255);
+	for (uint8_t i = 0; i < ble_n; i++) {
+		const struct ble_seen *e = &ble_tab[i];
+
+		idx[i] = i;
+		if (ble_stable(e)) {
+			sv.stable++;
+			if (!best || e->rssi_max > best) {
+				best = MIN(e->rssi_max, (int8_t)-1);
+			}
+		} else {
+			sv.rotating++;
+			sv.rotating_apple += e->company == 0x004C;
+			sv.rotating_microsoft += e->company == 0x0006;
+		}
+	}
+	ble_sum_valid = true;
+	ble_sum_devices = sv.devices;
+	ble_sum_stable = sv.stable;
+	ble_sum_rssi = best;
+	if (!max_packets) {
+		return 0;
+	}
+	for (uint8_t i = 1; i < ble_n; i++) {
+		for (uint8_t j = i; j > 0; j--) {
+			const struct ble_seen *a = &ble_tab[idx[j]], *b = &ble_tab[idx[j - 1]];
+
+			if (ble_rank(a) > ble_rank(b) || (ble_rank(a) == ble_rank(b) && a->rssi_max <= b->rssi_max)) {
+				break;
+			}
+			uint8_t x = idx[j];
+			idx[j] = idx[j - 1];
+			idx[j - 1] = x;
+		}
+	}
+	for (uint8_t i = 0; i < ble_n; i++) {
+		ble_to_dev(&ble_tab[idx[i]], &devs[i]);
+	}
+	size_t np = lt_ble_pack(&sv, devs, ble_n, max_packets, pts), q = 0;
+
+	keys_for(n);
+	for (size_t k = 0; k < np && txq_n < TXQ_MAX; k++) {
+		size_t l = lt_build_extra_packet(keys.k.view, cfg.channel_mode ? chan_key : nullptr, n,
+						 (uint8_t)(LT_J_BLE + k), pts[k], LT_BLE_PT_LEN, txq[txq_n], sizeof(txq[0]));
+		if (l) {
+			txq_alt[txq_n] = false;
+			txq_len[txq_n++] = l;
+			q++;
+		}
+	}
+	LOG_INF("BLE: %u device(s), %u packet(s) for n=%u", ble_n, (unsigned)q, n);
+	return q;
+}
+
+/* BLE_SCAN finished: send the packets for the report the command answered, then sleep */
+static void ble_cmd_done(void)
+{
+	ble_scan_halt();
+	txq_reset();
+	size_t q = ble_result_packets(n_report, ble_cmd_packets, ble_cmd_seconds, ble_scan_was_active);
+
+	ble_purpose = BLE_NONE;
+	if (hist_open) {
+		hist_cur.flags2 |= HF2_BLE;
+	}
+	if (!q) {
+		go_to_sleep();
+		return;
+	}
+	txq_no_listen = true;
+	txq_route_all();
+	radio.recoverRxState();
+	try_tx();
+}
+
+#if IS_ENABLED(CONFIG_BT_SMP) && IS_ENABLED(CONFIG_BT_PERIPHERAL)
+/* ---- blepair (experiment): the owner's phone bonds with the tracker for a short window, the
+ * tracker keeps the phone's IRK as an anchor and later resolves its private addresses passively.
+ * Outside the window nothing advertises and nothing can connect. */
+static struct bt_conn *pair_conn;
+static bool pair_on;
+static int64_t pair_until_ms;
+static volatile int pair_event; /* 1 connected, 2 bonded, 3 failed, 4 disconnected */
+static volatile int pair_err;
+static bt_addr_le_t pair_peer;
+
+static void pair_connected(struct bt_conn *conn, uint8_t err)
+{
+	if (err || !pair_on) {
+		return;
+	}
+	pair_conn = bt_conn_ref(conn);
+	pair_event = 1;
+	k_event_post(&events, EV_PAIR);
+}
+
+static void pair_disconnected(struct bt_conn *conn, uint8_t reason)
+{
+	if (conn != pair_conn) {
+		return;
+	}
+	bt_conn_unref(pair_conn);
+	pair_conn = NULL;
+	pair_err = reason;
+	pair_event = 4;
+	k_event_post(&events, EV_PAIR);
+}
+
+BT_CONN_CB_DEFINE(pair_conn_cb) = {
+	.connected = pair_connected,
+	.disconnected = pair_disconnected,
+};
+
+static void pair_complete(struct bt_conn *conn, bool bonded)
+{
+	bt_addr_le_copy(&pair_peer, bt_conn_get_dst(conn)); /* identity address once resolved */
+	pair_err = bonded ? 0 : -1;
+	pair_event = bonded ? 2 : 3;
+	k_event_post(&events, EV_PAIR);
+}
+
+static void pair_failed(struct bt_conn *conn, enum bt_security_err reason)
+{
+	ARG_UNUSED(conn);
+	pair_err = reason;
+	pair_event = 3;
+	k_event_post(&events, EV_PAIR);
+}
+
+static struct bt_conn_auth_info_cb pair_info_cb = {
+	.pairing_complete = pair_complete,
+	.pairing_failed = pair_failed,
+};
+
+static void pair_stop(void)
+{
+	bt_le_adv_stop();
+	if (pair_conn) {
+		bt_conn_disconnect(pair_conn, BT_HCI_ERR_REMOTE_USER_TERM_CONN);
+	}
+	pair_on = false;
+	k_timer_stop(&pair_tmr);
+}
+
+static const uint8_t pair_flags = BT_LE_AD_GENERAL | BT_LE_AD_NO_BREDR;
+static const struct bt_data pair_ad[] = {
+	{BT_DATA_FLAGS, 1, &pair_flags},
+	{BT_DATA_NAME_COMPLETE, 8, (const uint8_t *)"LibreTag"},
+};
+
+static int pair_start(uint32_t sec)
+{
+	static bool cb_set;
+
+	if (!ble_ready) {
+		int err = bt_enable(NULL);
+
+		if (err && err != -EALREADY) {
+			return err;
+		}
+		ble_ready = true;
+	}
+	if (!cb_set) {
+		bt_conn_auth_info_cb_register(&pair_info_cb);
+		cb_set = true;
+	}
+	bt_unpair(BT_ID_DEFAULT, NULL); /* bonds live only for the window; the IRK is kept as an anchor */
+	struct bt_le_adv_param p = BT_LE_ADV_PARAM_INIT(BT_LE_ADV_OPT_CONN | BT_LE_ADV_OPT_USE_IDENTITY,
+							BT_GAP_ADV_FAST_INT_MIN_2, BT_GAP_ADV_FAST_INT_MAX_2, NULL);
+	int err = bt_le_adv_start(&p, pair_ad, ARRAY_SIZE(pair_ad), NULL, 0);
+
+	if (err) {
+		return err;
+	}
+	pair_on = true;
+	pair_until_ms = k_uptime_get() + (int64_t)sec * 1000;
+	k_timer_start(&pair_tmr, K_SECONDS(sec), K_NO_WAIT);
+	return 0;
+}
+
+static void pair_handle(void)
+{
+	int ev = pair_event;
+	char a[BT_ADDR_LE_STR_LEN];
+
+	pair_event = 0;
+	if (ev == 1) {
+		out("PAIR connected, waiting for the phone to bond\r\n");
+	} else if (ev == 2) {
+		struct bt_keys *k = bt_keys_find(BT_KEYS_IRK, BT_ID_DEFAULT, &pair_peer);
+
+		bt_addr_le_to_str(&pair_peer, a, sizeof(a));
+		if (!k) {
+			out("PAIR bonded with %s, but it sent no IRK (no private address to resolve)\r\nEND\r\n", a);
+		} else if (cfg.anchor_count >= ANCHORS_MAX) {
+			out("ERR anchor list full\r\nEND\r\n");
+		} else {
+			struct anchor *x = &cfg.anchors[cfg.anchor_count++];
+			char h[33];
+
+			memset(x, 0, sizeof(*x));
+			x->kind = ANCHOR_IRK;
+			x->len = 22;
+			for (int i = 0; i < 16; i++) {
+				x->data[i] = k->irk.val[15 - i]; /* SMP order is little endian */
+			}
+			for (int i = 0; i < 6; i++) {
+				x->data[16 + i] = pair_peer.a.val[5 - i];
+			}
+			save_cfg();
+			hex(h, x->data, 16);
+			out("PAIR bonded with %s, anchor %u = irk %s\r\nEND\r\n", a, cfg.anchor_count - 1, h);
+		}
+		pair_stop();
+		bt_unpair(BT_ID_DEFAULT, NULL);
+	} else if (ev == 3) {
+		out("PAIR failed (%d)\r\n", pair_err);
+	} else if (ev == 4) {
+		out("PAIR disconnected (0x%02x)\r\n", pair_err);
+		if (pair_on) {
+			/* still in the window: advertise again for another try */
+			pair_stop();
+			int64_t left = pair_until_ms - k_uptime_get();
+			if (left > 2000) {
+				pair_start((uint32_t)(left / 1000));
+			} else {
+				out("PAIR window closed\r\nEND\r\n");
+			}
+		}
+	}
+}
