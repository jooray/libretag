+/* Is this advert one of the owner's devices (cfg.anchors)? Only what the device itself keeps
+ * stable counts: its address, name, maker data prefix, service data prefix, or an RPA that
+ * resolves with its IRK. */
+static bool anchor_match(const struct ble_seen *t)
+{
+	uint8_t a[6];
+	/* the top bits say RPA only for random addresses; a public one may start with 0b01 */
+	bool rpa = t->addr.type == BT_ADDR_LE_RANDOM && BT_ADDR_IS_RPA(&t->addr.a);
+
+	for (int i = 0; i < 6; i++) {
+		a[i] = t->addr.a.val[5 - i];
+	}
+	for (uint8_t i = 0; i < cfg.anchor_count && i < ANCHORS_MAX; i++) {
+		const struct anchor *x = &cfg.anchors[i];
+
+		switch (x->kind) {
+		case ANCHOR_ADDR:
+			if (!memcmp(x->data, a, 6) && !rpa) {
+				return true;
+			}
+			break;
+		case ANCHOR_NAME:
+			if (t->name_kind && strlen(t->name) == x->len && !memcmp(t->name, x->data, x->len)) {
+				return true;
+			}
+			break;
+		case ANCHOR_MFG:
+			if (t->company != 0xFFFF && x->len >= 2 && sys_get_le16(x->data) == t->company &&
+			    t->mfg_len >= x->len - 2 && (size_t)(x->len - 2) <= sizeof(t->mfg) &&
+			    !memcmp(t->mfg, x->data + 2, x->len - 2)) {
+				return true;
+			}
+			break;
+		case ANCHOR_SVC:
+			if (t->sd_uuid && x->len >= 2 && sys_get_le16(x->data) == t->sd_uuid && t->sd_len >= x->len - 2 &&
+			    (size_t)(x->len - 2) <= sizeof(t->sd) && !memcmp(t->sd, x->data + 2, x->len - 2)) {
+				return true;
+			}
+			break;
+		case ANCHOR_IRK:
+			if (rpa ? lt_rpa_matches(x->data, a) : !memcmp(x->data + 16, a, 6)) {
+				return true;
+			}
+			break;
+		default:
+			break;
+		}
+	}
+	return false;
+}
