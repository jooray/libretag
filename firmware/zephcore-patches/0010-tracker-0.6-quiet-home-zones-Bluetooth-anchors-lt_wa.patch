+/* Rough charge model (SPEC 8, X1 figures): enough to tell "a month" from "a week". */
+#define UA_SLEEP 50
+#define UA_AWAKE 18800 /* GNSS searching + MCU */
+#define UA_RX 8550
+#define UA_TX 110500
+#define UA_BLE 6000
+
+static void energy_add(uint32_t ua, int64_t ms)
+{
+	if (ms > 0) {
+		cfg.energy_uah += (uint32_t)(((uint64_t)ua * (uint64_t)ms) / 3600000ULL);
+	}
+}
+
+/* called when a wake-up ends: the time since the last mark was sleep up to wake_start, then awake */
+static void energy_wake_end(int64_t wake_start_ms, int64_t listen_ms)
+{
+	int64_t now = k_uptime_get();
+
+	if (en_mark_ms && wake_start_ms > en_mark_ms) {
+		energy_add(UA_SLEEP, wake_start_ms - en_mark_ms);
+	}
+	int64_t awake = wake_start_ms ? now - wake_start_ms : 0;
+
+	energy_add(UA_RX, listen_ms);
+	energy_add(UA_TX, en_tx_ms);
+	energy_add(UA_BLE, en_ble_ms);
+	energy_add(UA_AWAKE, awake - listen_ms - en_tx_ms);
+	en_mark_ms = now;
+	en_tx_ms = en_ble_ms = 0;
+	/* on a charger (or full) the count starts again */
+	if (board.getBattMilliVolts() >= 4150) {
+		cfg.energy_uah = 0;
+	}
+}
+
+static int64_t listen_start_ms;
+static int64_t wake_start_ms;
