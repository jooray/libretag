+/* zone / anchor / quiet / lostble / blepair (PROTOCOL.md 6): USB only, never over the radio */
+static int parse_mac(const char *s, uint8_t *a)
+{
+	unsigned v[6];
+
+	if (sscanf(s, "%2x:%2x:%2x:%2x:%2x:%2x", &v[0], &v[1], &v[2], &v[3], &v[4], &v[5]) != 6) {
+		return parse_hex(s, a, 6);
+	}
+	for (int i = 0; i < 6; i++) {
+		a[i] = (uint8_t)v[i];
+	}
+	return 0;
+}
+
+static void print_anchor(uint8_t i)
+{
+	const struct anchor *x = &cfg.anchors[i];
+	char h[2 * sizeof(x->data) + 1];
+
+	switch (x->kind) {
+	case ANCHOR_ADDR:
+		out("ANCHOR %u addr %02X:%02X:%02X:%02X:%02X:%02X\r\n", i, x->data[0], x->data[1], x->data[2], x->data[3],
+		    x->data[4], x->data[5]);
+		break;
+	case ANCHOR_NAME:
+		out("ANCHOR %u name %.*s\r\n", i, x->len, (const char *)x->data);
+		break;
+	case ANCHOR_MFG:
+	case ANCHOR_SVC:
+		hex(h, x->data + 2, x->len - 2);
+		out("ANCHOR %u %s %04x %s\r\n", i, x->kind == ANCHOR_MFG ? "mfg" : "svc", sys_get_le16(x->data), h);
+		break;
+	case ANCHOR_IRK:
+		hex(h, x->data, 16);
+		out("ANCHOR %u irk %s %02X:%02X:%02X:%02X:%02X:%02X\r\n", i, h, x->data[16], x->data[17], x->data[18],
+		    x->data[19], x->data[20], x->data[21]);
+		break;
+	default:
+		out("ANCHOR %u ?\r\n", i);
+	}
+}
+
+static void print_quiet(void)
+{
+	uint32_t now = (uint32_t)(k_uptime_get() / 1000);
+
+	if (!wake_st.quiet) {
+		out("QUIET none, %u zone(s), %u anchor(s)\r\n", cfg.zone_count, cfg.anchor_count);
+		return;
+	}
+	uint32_t hb = wake_st.reason == LT_QUIET_ZONE ? wake_cfg.heartbeat_s : wake_cfg.owner_cap_s;
+	out("QUIET %s since %u s, last report %u s ago, next report in %u s, zone %d\r\n",
+	    wake_st.reason == LT_QUIET_ZONE ? "zone" : "owner", now - wake_st.quiet_since_s, now - wake_st.last_tx_s,
+	    wake_st.last_tx_s + hb > now ? wake_st.last_tx_s + hb - now : 0, wake_st.zone);
+}
+
+static bool cli_quiet(int argc, char **argv)
+{
+	const char *c = argv[0];
+	const char *sub = argc >= 2 ? argv[1] : "list";
+
+	if (!strcmp(c, "zone")) {
+		if (!strcmp(sub, "add") && argc == 5) {
+			double la = strtod(argv[2], NULL), lo = strtod(argv[3], NULL);
+			int r = atoi(argv[4]);
+
+			if (cfg.zone_count >= ZONES_MAX || la < -90 || la > 90 || lo < -180 || lo > 180 || r < 20 ||
+			    r > 5000) {
+				out("ERR zone add <lat> <lon> <radius 20..5000 m>, at most %u\r\n", ZONES_MAX);
+				return true;
+			}
+			lt_zone_t *z = &cfg.zones[cfg.zone_count++];
+			z->lat_e7 = (int32_t)llround(la * 1e7);
+			z->lon_e7 = (int32_t)llround(lo * 1e7);
+			z->r_m = (uint16_t)r;
+			save_cfg();
+			out("OK zone %u\r\n", cfg.zone_count - 1);
+		} else if (!strcmp(sub, "del") && argc == 3 && atoi(argv[2]) < cfg.zone_count) {
+			int i = atoi(argv[2]);
+			memmove(&cfg.zones[i], &cfg.zones[i + 1], (cfg.zone_count - i - 1) * sizeof(cfg.zones[0]));
+			cfg.zone_count--;
+			lt_wake_state_init(&wake_st); /* zone indexes moved */
+			save_cfg();
+			out("OK\r\n");
+		} else if (!strcmp(sub, "clear")) {
+			cfg.zone_count = 0;
+			lt_wake_state_init(&wake_st);
+			save_cfg();
+			out("OK\r\n");
+		} else if (!strcmp(sub, "list")) {
+			for (uint8_t i = 0; i < cfg.zone_count; i++) {
+				out("ZONE %u %.7f %.7f %u\r\n", i, cfg.zones[i].lat_e7 / 1e7, cfg.zones[i].lon_e7 / 1e7,
+				    cfg.zones[i].r_m);
+			}
+			out("END %u\r\n", cfg.zone_count);
+		} else {
+			out("ERR zone add <lat> <lon> <r_m> | list | del <i> | clear\r\n");
+		}
+		return true;
+	}
+	if (!strcmp(c, "anchor")) {
+		if (!strcmp(sub, "add") && argc >= 4) {
+			struct anchor x = {};
+			const char *k = argv[2];
+			bool ok = true;
+
+			if (!strcmp(k, "addr")) {
+				x.kind = ANCHOR_ADDR;
+				x.len = 6;
+				ok = parse_mac(argv[3], x.data) == 0;
+			} else if (!strcmp(k, "name")) {
+				/* the rest of the line, single spaces */
+				size_t l = 0;
+				for (int i = 3; i < argc && ok; i++) {
+					size_t w = strlen(argv[i]);
+					ok = l + w + (i > 3) <= sizeof(x.data);
+					if (ok) {
+						if (i > 3) {
+							x.data[l++] = ' ';
+						}
+						memcpy(x.data + l, argv[i], w);
+						l += w;
+					}
+				}
+				x.kind = ANCHOR_NAME;
+				x.len = (uint8_t)l;
+			} else if ((!strcmp(k, "mfg") || !strcmp(k, "svc")) && argc >= 4) {
+				uint16_t id = (uint16_t)strtoul(argv[3], NULL, 16);
+				size_t pl = argc >= 5 ? strlen(argv[4]) / 2 : 0;
+
+				x.kind = !strcmp(k, "mfg") ? ANCHOR_MFG : ANCHOR_SVC;
+				sys_put_le16(id, x.data);
+				ok = pl <= (x.kind == ANCHOR_MFG ? BLE_MFG_MAX : 12) &&
+				     (pl == 0 || parse_hex(argv[4], x.data + 2, pl) == 0);
+				x.len = (uint8_t)(2 + pl);
+			} else if (!strcmp(k, "irk")) {
+				x.kind = ANCHOR_IRK;
+				x.len = 22;
+				ok = parse_hex(argv[3], x.data, 16) == 0 && (argc < 5 || parse_mac(argv[4], x.data + 16) == 0);
+			} else {
+				ok = false;
+			}
+			if (!ok || cfg.anchor_count >= ANCHORS_MAX) {
+				out("ERR anchor add addr <aa:bb:..> | name <text> | mfg <company hex> [prefix hex] | "
+				    "svc <uuid16 hex> [prefix hex] | irk <hex32> [identity]; at most %u\r\n", ANCHORS_MAX);
+				return true;
+			}
+			cfg.anchors[cfg.anchor_count++] = x;
+			save_cfg();
+			print_anchor(cfg.anchor_count - 1);
+		} else if (!strcmp(sub, "del") && argc == 3 && atoi(argv[2]) < cfg.anchor_count) {
+			int i = atoi(argv[2]);
+			memmove(&cfg.anchors[i], &cfg.anchors[i + 1], (cfg.anchor_count - i - 1) * sizeof(cfg.anchors[0]));
+			cfg.anchor_count--;
+			save_cfg();
+			out("OK\r\n");
+		} else if (!strcmp(sub, "clear")) {
+			cfg.anchor_count = 0;
+			save_cfg();
+			out("OK\r\n");
+		} else if (!strcmp(sub, "gps") && argc == 3) {
+			cfg.owner_gps = !strcmp(argv[2], "on");
+			save_cfg();
+			out("OK owner present: %s\r\n", cfg.owner_gps ? "fix kept in the history" : "GPS off");
+		} else if (!strcmp(sub, "scan") && argc == 3) {
+			cfg.anchor_active = !strcmp(argv[2], "active");
+			save_cfg();
+			out("OK presence scan %s\r\n", cfg.anchor_active ? "active" : "passive");
+		} else if (!strcmp(sub, "list")) {
+			for (uint8_t i = 0; i < cfg.anchor_count; i++) {
+				print_anchor(i);
+			}
+			out("END %u gps=%s scan=%s\r\n", cfg.anchor_count, cfg.owner_gps ? "on" : "off",
+			    cfg.anchor_active ? "active" : "passive");
+		} else {
+			out("ERR anchor add <kind> <value> | list | del <i> | clear | gps on|off | scan active|passive\r\n");
+		}
+		return true;
+	}
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+	if (!strcmp(c, "blepkt")) {
