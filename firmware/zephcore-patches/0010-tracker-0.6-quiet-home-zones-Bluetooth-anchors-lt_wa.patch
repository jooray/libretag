+/* next wake-up: the planned one (next_in), the quiet heartbeat, or the interval */
+static uint32_t sleep_s_now(void)
+{
+	uint32_t s;
+
+	if (planned_due_ms) {
+		int64_t w = planned_due_ms - k_uptime_get();
+		s = w > 1000 ? (uint32_t)(w / 1000) : 1U;
+		planned_due_ms = 0;
+	} else {
+		s = next_interval_s();
+	}
+	if (wake_st.quiet && mode == LT_MODE_IDLE) {
+		uint32_t hb = wake_st.reason == LT_QUIET_ZONE ? wake_cfg.heartbeat_s : wake_cfg.owner_cap_s;
+		uint32_t now = (uint32_t)(k_uptime_get() / 1000);
+		uint32_t due = wake_st.last_tx_s + hb;
+
+		s = MIN(s, due > now ? due - now : 1U);
+	}
+	return s;
+}
