+static void print_status(void)
+{
+	char k[2 * LT_KEY_SIZE + 1];
+
+	hex(k, cfg.key, LT_KEY_SIZE);
+	out("LIBRETAG KEY %s\r\n", k);
+	out("firmware LibreTag %s, ZephCore %s\r\n", LT_FW_VERSION, LT_ZEPHCORE_BASE);
+	out("n=%u mode=%d interval=%umin listen=%us fixto=%us transport=%s\r\n", n_cur, mode,
+	    cfg.interval_min, cfg.listen_s, cfg.fix_timeout_s, cfg.channel_mode ? "channel" : "stealth");
+	out("radio %.3f MHz bw=%.1f sf=%u cr=%u pwr=%d dBm path=%uB\r\n", (double)cfg.freq, (double)cfg.bw,
+	    cfg.sf, cfg.cr, cfg.tx_power, cfg.path_hash_size);
+	if (test_left) {
+		out("test %u report(s) left, every %u s\r\n", (unsigned)test_left, (unsigned)test_interval_s);
+	}
+	if (last_sent_valid) {
+		const lt_report_t *q = &last_sent;
+
+		if (q->has_fix) {
+			out("last report: fix %.5f,%.5f\r\n", q->lat_e7 / 1e7, q->lon_e7 / 1e7);
+		} else {
+			out("last report: no fix; last fix %s%u s ago; %u repeater(s)%s:", q->last_fix_time ? "" : "never ",
+			    q->last_fix_time && now_unix() ? (unsigned)(now_unix() - q->last_fix_time) : 0U, q->nb_total,
+			    q->nb_from_discover ? " answered discover" : " heard");
+			for (uint8_t i = 0; i < q->nb_count; i++) {
+				out(" %02x%02x snr %d.%02d", q->nb[i].hash[0], q->nb[i].hash[1], q->nb[i].snr4 / 4,
+				    (abs(q->nb[i].snr4) % 4) * 25);
+			}
+			out("\r\n");
+		}
+	}
+	if (home_silent == 255) {
+		out("home network: not heard yet (a border copy goes out if one applies)\r\n");
+	} else {
+		out("home network: last heard %u listen window(s) ago\r\n", home_silent);
+	}
+	out("network %s: country %s, region %s\r\n", cfg.region_manual ? "manual" : "auto (GPS)",
+	    country_iso(cfg.country), cfg.scope[0] ? cfg.scope : "none");
+	out("battery %u%% (%u mV) phase=%d gps=%s last_fix=%s %.6f,%.6f\r\n", board.getBattPercent(),
+	    board.getBattMilliVolts(), phase, gps_is_available() ? "yes" : "no",
+	    fix_valid ? "yes" : "no", fix_lat, fix_lon);
+#if NOSTR
+	print_nostr();
+#endif
+}
+
+static int parse_hex(const char *s, uint8_t *dst, size_t n)
+{
+	if (strlen(s) != 2 * n) {
+		return -1;
+	}
+	for (size_t i = 0; i < n; i++) {
+		char b[3] = {s[2 * i], s[2 * i + 1], 0};
+		char *e;
+		dst[i] = (uint8_t)strtoul(b, &e, 16);
+		if (*e) {
+			return -1;
+		}
+	}
+	return 0;
+}
