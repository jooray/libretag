+static void cli_exec(char *l)
+{
+	char *argv[6];
+	int argc = 0;
+#if NOSTR
+	char *rest = NULL;
+
+	if (!strncmp(l, "dm ", 3)) {
+		rest = l + 3; /* free text, not tokenised */
+	}
+#endif
+
+	for (char *t = strtok(l, " \t"); t && argc < 6; t = strtok(NULL, " \t")) {
+		argv[argc++] = t;
+	}
+	if (argc == 0) {
+		return;
+	}
+	const char *c = argv[0];
+#if NOSTR
+	if (cli_nostr(argc, argv, rest)) {
+		return;
+	}
+#endif
+
+	if (!strcmp(c, "help")) {
+		/* one line per out(): its buffer is 200 bytes */
+		out("status | key [hex64] | newkey | report | interval <min> | listen <s> | fixto <s>\r\n");
+		out("track <interval_s> <minutes> | idle | transport channel|stealth\r\n");
+		out("radio <MHz> <bwkHz> <sf> <cr> | power <dBm> | pathhash 1|2|3 | region <name>|none\r\n");
+		out("network auto|manual | where <lat> <lon> | test [count] [interval_s] | gps | reboot | dfu\r\n");
+		out("meshscan [s] | discover [s] | neighbours | noise [n] | blescan [s] [passive]\r\n");
+#if NOSTR
+		out("nostr | owner <npub|hex|off> | dm <text> | public <k> | inbox <k> | dmalert on|off\r\n");
+#endif
+	} else if (!strcmp(c, "version")) {
+		out("LibreTag tracker %s on ZephCore %s, board %s\r\n", LT_FW_VERSION, LT_ZEPHCORE_BASE, CONFIG_BOARD);
+	} else if (!strcmp(c, "status") || (!strcmp(c, "key") && argc == 1)) {
+		print_status();
+	} else if (!strcmp(c, "key") && argc == 2) {
+		if (parse_hex(argv[1], cfg.key, LT_KEY_SIZE) == 0) {
+			n_cur = 0;
+			cfg.n_next = N_CHECKPOINT;
+			save_cfg();
+			out("OK key set, counter reset\r\n");
+		} else {
+			out("ERR need 64 hex chars\r\n");
+		}
+	} else if (!strcmp(c, "newkey")) {
+		rng.random(cfg.key, LT_KEY_SIZE);
+		n_cur = 0;
+		cfg.n_next = N_CHECKPOINT;
+		save_cfg();
+		print_status();
+	} else if (!strcmp(c, "report")) {
+		if (phase == PH_SLEEP) {
+			k_timer_stop(&report_timer);
+			start_report();
+			out("OK\r\n");
+		} else {
+			out("ERR busy (phase %d)\r\n", phase);
+		}
+	} else if (!strcmp(c, "meshscan")) {
+		/* meshscan [s]: listen on LoRa, list the repeaters heard directly and the adverts */
+		int sec = argc >= 2 ? atoi(argv[1]) : 60;
+
+		mesh_scan_clear();
+		mesh_scanning = true;
+		if (phase == PH_SLEEP || phase == PH_WAIT_FIX) {
+			radio.recoverRxState(); /* asleep: wake the receiver (TX/listen already receive) */
+		}
+		k_timer_start(&scan_timer, K_SECONDS(CLAMP(sec, 5, 1800)), K_NO_WAIT);
+		out("OK listening %d s\r\n", CLAMP(sec, 5, 1800));
+	} else if (!strcmp(c, "discover")) {
+		/* discover [s]: ask the repeaters in direct range to answer (zero hop), then listen */
+		int sec = argc >= 2 ? CLAMP(atoi(argv[1]), 5, 120) : 20;
+
+		if (phase != PH_SLEEP && phase != PH_WAIT_FIX) {
+			out("ERR busy (phase %d), try again after the report\r\n", phase);
+		} else {
+			if (!disc_start((uint32_t)sec, false)) {
+				out("ERR radio busy\r\n");
+			} else {
+				out("OK discover sent, listening %d s\r\n", sec);
+			}
+		}
+	} else if (!strcmp(c, "noise")) {
+		/* noise [n]: instantaneous RSSI with no packet = the receiver's noise floor here */
+		int cnt = argc >= 2 ? CLAMP(atoi(argv[1]), 1, 50) : 10;
+		bool was_asleep = !radio.isInRecvMode();
+
+		if (was_asleep) {
+			radio.recoverRxState();
+			k_msleep(20);
+		}
+		int sum = 0, mn = 0, mx = -200;
+		for (int i = 0; i < cnt; i++) {
+			int r = radio.getCurrentRSSI();
+
+			sum += r;
+			mn = MIN(mn, r);
+			mx = MAX(mx, r);
+			k_msleep(50);
+		}
+		if (was_asleep) {
+			radio.sleepRadio();
+		}
+		out("noise: avg %d dBm, min %d, max %d (%d samples)\r\n", sum / cnt, mn, mx, cnt);
+	} else if (!strcmp(c, "neighbours")) {
+		mesh_scan_print();
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+	} else if (!strcmp(c, "blescan")) {
+		/* blescan [s] [passive]: list Bluetooth LE devices around */
+		int sec = argc >= 2 ? atoi(argv[1]) : 20;
+		bool active = !(argc >= 3 && !strcmp(argv[2], "passive"));
+		int err = ble_scan_start(active);
+
+		if (err) {
+			out("ERR bluetooth %d\r\n", err);
+		} else {
+			k_timer_start(&scan_timer, K_SECONDS(CLAMP(sec, 2, 600)), K_NO_WAIT);
+			out("OK %s BLE scan %d s\r\n", active ? "active" : "passive", CLAMP(sec, 2, 600));
+		}
+#endif
+	} else if (!strcmp(c, "gps")) {
+		/* satellites, NMEA count, fix age: is the module hearing anything indoors? */
+		char d[160];
+
+		gps_format_diagnostics(d, sizeof(d));
+		out("%s\r\n", d);
+		out("waiting for fix: %s, cold-start window %s\r\n", phase == PH_WAIT_FIX ? "yes" : "no",
+		    first_fix_pending ? "pending" : "spent");
+	} else if (!strcmp(c, "test") && argc <= 3) {
+		/* test [count] [interval_s]: one report now, the rest interval_s apart */
+		int cnt = argc >= 2 ? atoi(argv[1]) : 3;
+		int ivs = argc >= 3 ? atoi(argv[2]) : 300;
+
+		test_left = (uint8_t)CLAMP(cnt, 1, 20);
+		test_interval_s = (uint32_t)CLAMP(ivs, 30, 3600);
+		test_due_ms = k_uptime_get();
+		if (phase == PH_SLEEP) {
+			k_timer_stop(&report_timer);
+			start_report();
+		}
+		/* else: the report under way counts as the first one */
+		out("OK test %u report(s), every %u s\r\n", (unsigned)test_left, (unsigned)test_interval_s);
+	} else if (!strcmp(c, "interval") && argc == 2) {
+		cfg.interval_min = (uint16_t)CLAMP(atoi(argv[1]), 1, 1440);
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "listen") && argc == 2) {
+		cfg.listen_s = (uint16_t)CLAMP(atoi(argv[1]), 0, 600);
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "fixto") && argc == 2) {
+		cfg.fix_timeout_s = (uint16_t)CLAMP(atoi(argv[1]), 10, 600);
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "track") && argc == 3) {
+		lt_command_t cmd = {.seq = last_cmd_seq, .op = LT_OP_SET_MODE};
+		uint16_t iv = (uint16_t)atoi(argv[1]), du = (uint16_t)atoi(argv[2]);
+		cmd.args[0] = LT_MODE_TRACK;
+		cmd.args[1] = iv & 0xFF;
+		cmd.args[2] = iv >> 8;
+		cmd.args[3] = du & 0xFF;
+		cmd.args[4] = du >> 8;
+		apply_command(&cmd);
+		pending_ack = false;
+		out("OK\r\n");
+	} else if (!strcmp(c, "idle")) {
+		mode = LT_MODE_IDLE;
+		out("OK\r\n");
+	} else if (!strcmp(c, "transport") && argc == 2) {
+		cfg.channel_mode = !strcmp(argv[1], "channel");
+		save_cfg();
+		out("OK transport=%s\r\n", cfg.channel_mode ? "channel" : "stealth");
+	} else if (!strcmp(c, "radio") && argc == 5) {
+		cfg.freq = strtof(argv[1], NULL);
+		cfg.bw = strtof(argv[2], NULL);
+		cfg.sf = (uint8_t)atoi(argv[3]);
+		cfg.cr = (uint8_t)atoi(argv[4]);
+		cfg.region_manual = 1;
+		save_cfg();
+		apply_radio_cfg();
+		radio.reconfigure();
+		radio.sleepRadio();
+		out("OK (network manual; `network auto` follows the country again)\r\n");
+	} else if (!strcmp(c, "pathhash") && argc == 2) {
+		cfg.path_hash_size = (uint8_t)CLAMP(atoi(argv[1]), 1, 3);
+		cfg.region_manual = 1;
+		save_cfg();
+		out("OK (network manual)\r\n");
+	} else if (!strcmp(c, "region") && argc == 2) {
+		memset(cfg.scope, 0, sizeof(cfg.scope));
+		if (strcmp(argv[1], "none")) {
+			strncpy(cfg.scope, argv[1], sizeof(cfg.scope) - 1);
+		}
+		cfg.region_manual = 1;
+		save_cfg();
+		apply_radio_cfg();
+		out("OK (network manual)\r\n");
+	} else if (!strcmp(c, "network") && argc == 2) {
+		cfg.region_manual = !strcmp(argv[1], "manual");
+		save_cfg();
+		out("OK network %s\r\n", cfg.region_manual ? "manual" : "auto (applies at the next fix)");
+	} else if (!strcmp(c, "where") && argc == 3) {
+		lt_net_t nets[LT_REGION_MAX_NETS];
+		int32_t la = (int32_t)llround(strtod(argv[1], NULL) * 1e7);
+		int32_t lo = (int32_t)llround(strtod(argv[2], NULL) * 1e7);
+		size_t nn = lt_region_plan(la, lo, BORDER_M, nets);
+
+		out("country %s, %u network(s)\r\n", country_iso(lt_country_at(la, lo)), (unsigned)nn);
+		for (size_t i = 0; i < nn; i++) {
+			const lt_preset_t *p = &lt_presets[nets[i].preset];
+
+			out("  %s: %s %.3f/%.1f/%u/%u path=%uB region %s\r\n", country_iso(nets[i].country),
+			    p->name, (double)p->freq, (double)p->bw, p->sf, p->cr, nets[i].path_hash_size,
+			    nets[i].scope ? nets[i].scope : "none");
+		}
+	} else if (!strcmp(c, "power") && argc == 2) {
+		cfg.tx_power = (int8_t)CLAMP(atoi(argv[1]), -9, 22);
+		save_cfg();
+		apply_radio_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "reboot")) {
+		board.reboot();
+	} else if (!strcmp(c, "dfu")) {
+		board.rebootToBootloader();
+	} else {
+		out("ERR unknown command, try help\r\n");
+	}
+}
+
+static void cli_poll(void)
+{
+	while (cli.available() > 0) {
+		int ch = cli.read();
+
+		if (ch < 0) {
+			break;
+		}
+		if (ch == '\r' || ch == '\n') {
+			if (line_len) {
+				line[line_len] = 0;
+				out("\r\n");
+				cli_exec(line);
+				line_len = 0;
+			}
+		} else if (line_len < sizeof(line) - 1) {
+			line[line_len++] = (char)ch;
+			cli.write((uint8_t)ch); /* echo */
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ main */
+
+#if NOSTR
+/* Device key on first boot, then self-tests: FIPS-197 AES-256 and a timed BIP-340 round trip. */
+static void nostr_init(void)
+{
+	static const uint8_t k256[32] = {0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0a,
+					 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15,
+					 0x16, 0x17, 0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f};
+	static const uint8_t pt[16] = {0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
+				       0x88, 0x99, 0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff};
+	static const uint8_t ct[16] = {0x8e, 0xa2, 0xb7, 0xca, 0x51, 0x67, 0x45, 0xbf,
+				       0xea, 0xfc, 0x49, 0x90, 0x4b, 0x49, 0x60, 0x89};
+	uint8_t o[16], msg[32] = {1}, sig[64];
+	bool have = false;
+
+	lt_channel_key(LT_NOSTR_CHANNEL, nostr_key);
+	for (int i = 0; i < 32; i++) {
+		have |= cfg.nostr_sk[i] != 0;
+	}
+	for (int tries = 0; (!have || !lt_secp_pubkey(cfg.nostr_sk, my_pk)) && tries < 8; tries++) {
+		rng.random(cfg.nostr_sk, sizeof(cfg.nostr_sk));
+		have = true;
+		save_cfg();
+		LOG_INF("generated the Nostr device key");
+	}
+	lt_aes256_encrypt_block(k256, pt, o);
+	bool aes_ok = !memcmp(o, ct, 16);
+	int64_t t0 = k_uptime_get();
+	bool sig_ok = lt_secp_pubkey(cfg.nostr_sk, my_pk) && lt_secp_sign(cfg.nostr_sk, msg, sig);
+	int64_t t1 = k_uptime_get();
+	sig_ok = sig_ok && lt_secp_verify(my_pk, msg, sig);
+	int64_t t2 = k_uptime_get();
+	nostr_ok = aes_ok && sig_ok;
+	LOG_INF("nostr self-test aes256=%d bip340=%d (sign %lld ms, verify %lld ms)", aes_ok, sig_ok,
+		t1 - t0, t2 - t1);
+}
+#endif
+
+int main(void)
+{
+	board.clearBootloaderMagic();
+
+#if ZEPHCORE_USB_STACK && DT_HAS_COMPAT_STATUS_OKAY(zephyr_cdc_acm_uart) && \
+	!IS_ENABLED(CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT)
+	zephcore_usbd_init();
+#endif
+
+#if IS_ENABLED(CONFIG_ZEPHCORE_UI_DISPLAY)
+	if (mc_display_init() == 0) {
+		mc_display_off();
+	}
+#else
+	oled_sleep();
+#endif
+
+	/* The tracker's own state is its role data: without this check every boot
+	 * formatted the volume and generated a new key. */
+	if (!zephcore_fs_exists(STATE_FILE) && !data_store.hasRoleData()) {
+		LOG_WRN("Volume holds no data for this role - formatting before first boot");
+		zephcore_fs_format_all(nullptr);
+	}
+	data_store.begin();
+
+	initNodePrefs(&prefs);
+	load_cfg();
+	apply_radio_cfg();
+	lt_channel_key("#libretag", chan_key);
+#if NOSTR
+	nostr_init();
+#endif
+
+	k_event_init(&events);
+	radio.setRxCallback(post_lora_rx, nullptr);
+	radio.setTxDoneCallback(post_lora_tx_done, nullptr);
+	radio.setPrefs(&prefs);
+	radio.begin();
+	radio.sleepRadio();
+
+	cli.begin(DEVICE_DT_GET(CLI_NODE), post_cli_rx, post_cli_tx_idle);
+
+	gps_manager_init();
+	if (gps_is_available()) {
+		gps_set_fix_callback(gps_fix_cb);
+		gps_set_event_callback(post_gps_event);
+		gps_set_poll_interval_sec(86400); /* we wake it ourselves */
+		gps_enable(true);
+	}
+
+	board.captureBootVoltage();
+	LOG_INF("LibreTag tracker up, n=%u", n_cur);
+	schedule_next(5);
+
+	for (;;) {
+		uint32_t ev = k_event_wait(&events, EV_ALL, false, K_FOREVER);
+
+		k_event_clear(&events, ev);
+
+		if (ev & MESH_EVENT_GPS_ACTION) {
+			gps_process_event();
+		}
+		if (ev & MESH_EVENT_CLI_RX) {
+			cli_poll();
+		}
+		if (ev & EV_REPORT_DUE) {
+			start_report();
+		}
+		if ((ev & EV_FIX_TIMEOUT) && phase == PH_WAIT_FIX) {
+			LOG_INF("no fix in time, reporting without position");
+			/* The long cold-start window is spent once; indoors it would otherwise
+			 * keep the GPS on for minutes at every wake-up. */
+			first_fix_pending = false;
+			gps_stop_acquiring(); /* or the module searches on for minutes */
+			send_report(false);
+		}
+		if ((ev & EV_TX_RETRY) && phase != PH_SLEEP) {
+			try_tx();
+		}
+		if ((ev & MESH_EVENT_LORA_TX_DONE) && disc_tx_pending && phase != PH_TX && radio.isSendComplete()) {
+			radio.onSendFinished();
+			disc_tx_pending = false;
+			radio.recoverRxState(); /* back to receiving the answers */
+		}
+		if ((ev & MESH_EVENT_LORA_TX_DONE) && radio.isSendComplete() && phase == PH_TX) {
+			radio.onSendFinished();
+			tx_finished();
+		}
+		if (ev & MESH_EVENT_LORA_RX) {
+			handle_rx();
+		}
+		if ((ev & EV_LISTEN_END) && phase == PH_LISTEN) {
+			go_to_sleep();
+		}
+		if (ev & EV_SCAN_END) {
+			scan_end();
+		}
+	}
+	return 0;
+}
