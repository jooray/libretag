+/* ------------------------------------------------------------------ CLI output */
+
+static void out(const char *fmt, ...)
+{
+	char buf[200];
+	va_list ap;
+
+	va_start(ap, fmt);
+	int l = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (l > 0) {
+		cli.write((const uint8_t *)buf, MIN((size_t)l, sizeof(buf) - 1));
+	}
+}
+
+static void hex(char *dst, const uint8_t *src, size_t n)
+{
+	static const char *d = "0123456789abcdef";
+
+	for (size_t i = 0; i < n; i++) {
+		dst[2 * i] = d[src[i] >> 4];
+		dst[2 * i + 1] = d[src[i] & 15];
+	}
+	dst[2 * n] = 0;
+}
+
+/* ------------------------------------------------------------------ persistence */
+
+static bool save_cfg(void)
+{
+	struct fs_file_t f;
+
+	fs_file_t_init(&f);
+	if (fs_open(&f, STATE_FILE, FS_O_CREATE | FS_O_WRITE | FS_O_TRUNC) < 0) {
+		LOG_ERR("cannot write %s", STATE_FILE);
+		return false;
+	}
+	ssize_t w = fs_write(&f, &cfg, sizeof(cfg));
+	fs_close(&f);
+	return w == (ssize_t)sizeof(cfg);
+}
+
+static void defaults(void)
+{
+	memset(&cfg, 0, sizeof(cfg));
+	cfg.magic = STATE_MAGIC;
+	cfg.interval_min = CONFIG_LIBRETAG_REPORT_INTERVAL_MIN;
+	cfg.listen_s = CONFIG_LIBRETAG_LISTEN_SEC;
+	cfg.fix_timeout_s = CONFIG_LIBRETAG_FIX_TIMEOUT_SEC;
+	cfg.channel_mode = IS_ENABLED(CONFIG_LIBRETAG_CHANNEL_MODE) ? 1 : 0;
+	cfg.low_batt_pct = CONFIG_LIBRETAG_LOW_BATT_PCT;
+	cfg.freq = prefs.freq;
+	cfg.bw = prefs.bw;
+	cfg.sf = prefs.sf;
+	cfg.cr = prefs.cr;
+	cfg.tx_power = prefs.tx_power_dbm;
+	rng.random(cfg.key, sizeof(cfg.key));
+	/* One packet per wake-up by default: no inbox poll (the owner's bridge recognises the
+	 * regular report, it knows the key), no low-battery DM (the app reads LOW_BATT). */
+	cfg.inbox_every = 0;
+	cfg.dm_alerts = 0;
+	cfg.path_hash_size = 1; /* until the first fix picks the country's network */
+}
+
+static void load_cfg(void)
+{
+	struct fs_file_t f;
+	struct fs_dirent st;
+
+	if (fs_stat(STATE_DIR, &st) < 0) {
+		fs_mkdir(STATE_DIR);
+	}
+	fs_file_t_init(&f);
+	bool ok = false;
+	if (fs_open(&f, STATE_FILE, FS_O_READ) == 0) {
+		ssize_t r = fs_read(&f, &cfg, sizeof(cfg));
+		fs_close(&f);
+		ok = r == (ssize_t)sizeof(cfg) && cfg.magic == STATE_MAGIC;
+		uint32_t was = cfg.magic;
+		size_t keep = was == STATE_MAGIC_V1 ? V1_SIZE : was == STATE_MAGIC_V2 ? V2_SIZE :
+			      was == STATE_MAGIC_V3 ? V3_SIZE : 0;
+		if (!ok && keep && r >= (ssize_t)keep) {
+			LOG_INF("migrating LibreTag state %08x -> v4", was);
+			memset((uint8_t *)&cfg + keep, 0, sizeof(cfg) - keep);
+			cfg.magic = STATE_MAGIC;
+			if (keep < V3_SIZE) {
+				cfg.region_manual = 0;
+				cfg.path_hash_size = 1;
+			}
+			ok = true;
+		}
+	}
+	if (!ok) {
+		LOG_WRN("no LibreTag state, generating a new key");
+		defaults();
+	}
+	/* LOST/TRACK and the last command survive a reboot (a brownout must not end LOST) */
+	last_cmd_seq = cfg.last_cmd_seq;
+	if (cfg.mode != LT_MODE_IDLE && cfg.mode <= LT_MODE_LOST && cfg.mode_left_min) {
+		mode = (lt_mode_t)cfg.mode;
+		mode_until_ms = k_uptime_get() + (int64_t)cfg.mode_left_min * 60000;
+		track_interval_s = cfg.track_interval_s >= 30 ? cfg.track_interval_s : 120;
+		LOG_INF("resuming mode %d for %u min", mode, cfg.mode_left_min);
+	}
+	/* Skip ahead past anything that may have been sent since the checkpoint. */
+	n_cur = cfg.n_next;
+	cfg.n_next = n_cur + N_CHECKPOINT;
+	save_cfg();
+}
+
+/* Persist mode changes (and the remaining time, coarsely) so a reboot resumes them. */
+static void save_mode(void)
+{
+	uint16_t left = 0;
+
+	if (mode != LT_MODE_IDLE) {
+		int64_t ms = mode_until_ms - k_uptime_get();
+
+		left = ms > 0 ? (uint16_t)MIN(ms / 60000 + 1, 65535) : 0;
+	}
+	bool changed = cfg.mode != (uint8_t)mode || cfg.last_cmd_seq != last_cmd_seq ||
+		       cfg.track_interval_s != track_interval_s ||
+		       (left > cfg.mode_left_min ? left - cfg.mode_left_min : cfg.mode_left_min - left) > 10;
+
+	if (changed) {
+		cfg.mode = (uint8_t)mode;
+		cfg.mode_left_min = left;
+		cfg.last_cmd_seq = last_cmd_seq;
+		cfg.track_interval_s = (uint16_t)MIN(track_interval_s, 65535U);
+		save_cfg();
+	}
+}
+
+static void checkpoint_counter(void)
+{
+	if (n_cur + 1 >= cfg.n_next) {
+		cfg.n_next = n_cur + N_CHECKPOINT;
+		save_cfg();
+	}
+}
+
+static void apply_radio_cfg(void)
+{
+	prefs.freq = cfg.freq;
+	prefs.bw = cfg.bw;
+	prefs.sf = cfg.sf;
+	prefs.cr = cfg.cr;
+	prefs.tx_power_dbm = cfg.tx_power;
+	cfg.scope[sizeof(cfg.scope) - 1] = 0;
+	if (cfg.scope[0]) {
+		lt_scope_key(cfg.scope, scope_key);
+	}
+}
+
+/* ------------------------------------------------------------------ network by country (SPEC 6.4) */
+
+static const char *country_iso(uint8_t c)
+{
+	return c < lt_country_count ? lt_countries[c].iso : "??";
+}
+
+/* Make nets[0] the network the tracker lives on (radio, path hash size, region). */
+static void adopt_net(const lt_net_t *n)
+{
+	const lt_preset_t *p = &lt_presets[n->preset];
+	const char *sc = n->scope ? n->scope : "";
+	lt_preset_t cur = {nullptr, cfg.freq, cfg.bw, cfg.sf, cfg.cr, cfg.path_hash_size};
+
+	if (lt_preset_same_radio(&cur, p) && cfg.path_hash_size == n->path_hash_size &&
+	    cfg.country == n->country && !strcmp(cfg.scope, sc)) {
+		return;
+	}
+	bool radio_changed = !lt_preset_same_radio(&cur, p);
+	if (radio_changed) {
+		home_silent = 255; /* nothing known about the new network yet */
+	}
+	cfg.freq = p->freq;
+	cfg.bw = p->bw;
+	cfg.sf = p->sf;
+	cfg.cr = p->cr;
+	cfg.path_hash_size = n->path_hash_size;
+	cfg.country = n->country;
+	strncpy(cfg.scope, sc, sizeof(cfg.scope) - 1);
+	save_cfg();
+	apply_radio_cfg();
+	if (radio_changed) {
+		radio.reconfigure();
+	}
+	LOG_INF("network: %s, %s (%.3f/%.1f/%u/%u), %u-byte path, region %s", country_iso(n->country), p->name,
+		(double)p->freq, (double)p->bw, p->sf, p->cr, n->path_hash_size, sc[0] ? sc : "none");
+}
+
+/* Pick the network(s) for this position. Returns 1 or 2 (2: alt_net is set). */
+static size_t plan_networks(const lt_report_t *r)
+{
+	lt_net_t nets[LT_REGION_MAX_NETS];
+	size_t nn;
+
+	if (cfg.region_manual || !r->has_fix) {
+		return 1;
+	}
+	nn = lt_region_plan(r->lat_e7, r->lon_e7, BORDER_M, nets);
+	if (nn == 0) {
+		return 1; /* unknown country or the sea: stay where we are */
+	}
+	/* Hysteresis: near a border (both networks are candidates) stay on the one we are on;
+	 * switch only when the current network is no longer a candidate, i.e. more than
+	 * BORDER_M inside the other country. */
+	size_t pri = 0;
+	lt_preset_t cur = {nullptr, cfg.freq, cfg.bw, cfg.sf, cfg.cr, cfg.path_hash_size};
+
+	for (size_t i = 0; i < nn; i++) {
+		if (lt_preset_same_radio(&cur, &lt_presets[nets[i].preset])) {
+			pri = i;
+			break;
+		}
+	}
+	adopt_net(&nets[pri]);
+	if (nn < 2 || home_silent < HOME_SILENT_WINDOWS) {
+		return 1;
+	}
+	alt_net = nets[1 - pri];
+	if (alt_net.scope) {
+		lt_scope_key(alt_net.scope, alt_scope_key);
+	}
+	return 2;
+}
+
+/* Path hash size and region into every queued packet. */
+static void txq_route_all(void)
+{
+	for (int i = 0; i < txq_n; i++) {
+		size_t l;
+
+		if (txq_alt[i]) {
+			l = lt_packet_set_route(txq[i], txq_len[i], sizeof(txq[0]), alt_net.path_hash_size,
+						alt_net.scope ? alt_scope_key : nullptr);
+		} else {
+			l = lt_packet_set_route(txq[i], txq_len[i], sizeof(txq[0]), cfg.path_hash_size,
+						cfg.scope[0] ? scope_key : nullptr);
+		}
+		if (l) {
+			txq_len[i] = l;
+		} else {
+			LOG_WRN("packet %d: cannot set route, sent unscoped", i);
+		}
+	}
+}
+
+/* The alternate network is a temporary radio override; back home for listening. */
+static void radio_home(void)
+{
+	if (radio.hasRadioOverride()) {
+		radio.clearRadioOverride();
+	}
+}
+
+/* ------------------------------------------------------------------ scheduling */
+
+static void schedule_next(uint32_t delay_s)
+{
+	k_timer_start(&report_timer, K_SECONDS(MAX(delay_s, 1U)), K_NO_WAIT);
+}
+
+static uint32_t next_interval_s(void)
+{
+	if (mode != LT_MODE_IDLE && k_uptime_get() >= mode_until_ms) {
+		LOG_INF("mode %d expired, back to IDLE", mode);
+		mode = LT_MODE_IDLE;
+	}
+	uint32_t base = (mode == LT_MODE_TRACK || mode == LT_MODE_LOST)
+				? track_interval_s
+				: (uint32_t)cfg.interval_min * 60U;
+	/* +-10 % jitter so the period is not a fingerprint */
+	int32_t span = (int32_t)base / 5;
+	int32_t j = span > 0 ? (int32_t)(sys_rand32_get() % (uint32_t)span) - span / 2 : 0;
+	return (uint32_t)MAX((int32_t)base + j, 10);
+}
+
+static void go_to_sleep(void)
+{
+	if (phase == PH_LISTEN) {
+		home_silent = home_heard ? 0 : (uint8_t)MIN(home_silent + 1, 255);
+		home_heard = false;
+	}
+	radio_home();
+	if (mesh_scanning) {
+		radio.recoverRxState(); /* a scan is running: keep listening */
+	} else {
+		radio.sleepRadio();
+	}
+	phase = PH_SLEEP;
+	if (ping_requested) {
+		ping_requested = false;
+		schedule_next(1);
+		return;
+	}
+	if (test_left && --test_left) {
+		/* due times count from the test start, not from the end of this wake-up
+		 * (a cold GPS start alone can take 5 min) */
+		test_due_ms += (int64_t)test_interval_s * 1000;
+		int64_t wait_ms = test_due_ms - k_uptime_get();
+		uint32_t wait_s = wait_ms > 1000 ? (uint32_t)(wait_ms / 1000) : 1U;
+
+		LOG_INF("test: %u report(s) left, next in %u s", test_left, wait_s);
+		schedule_next(wait_s);
+		return;
+	}
+	uint32_t s = next_interval_s();
+	save_mode();
+	LOG_INF("sleeping %u s (mode %d)", s, mode);
+	schedule_next(s);
+}
+
+/* ------------------------------------------------------------------ report */
+
+static void txq_reset(void)
+{
+	memset(txq_alt, 0, sizeof(txq_alt));
+	txq_n = 0;
+	txq_i = 0;
+	tx_tries = 0;
+}
+
+static void try_tx(void)
+{
+	if (txq_i >= txq_n) {
+		go_to_sleep();
+		return;
+	}
+	if (txq_alt[txq_i] && !radio.hasRadioOverride()) {
+		const lt_preset_t *p = &lt_presets[alt_net.preset];
+
+		radio.setRadioOverride(p->freq, p->bw, p->sf, p->cr);
+	} else if (!txq_alt[txq_i]) {
+		radio_home();
+	}
+	if (radio.startSendRaw(txq[txq_i], (int)txq_len[txq_i])) {
+		phase = PH_TX;
+		return;
+	}
+	if (++tx_tries > 30) {
+		LOG_WRN("TX refused 30x, dropping packet %d of %d", txq_i + 1, txq_n);
+		tx_tries = 0;
+		if (++txq_i >= txq_n) {
+			go_to_sleep();
+			return;
+		}
+	}
+	k_timer_start(&retry_timer, K_MSEC(200 + (sys_rand32_get() % 400)), K_NO_WAIT);
+}
+
+/* one packet sent: next one after a short random gap, or open the RX window */
+static void tx_finished(void)
+{
+	if (++txq_i < txq_n) {
+		tx_tries = 0;
+		k_timer_start(&retry_timer, K_MSEC(300 + (sys_rand32_get() % 500)), K_NO_WAIT);
+		return;
+	}
+	radio_home();
+	if (cfg.listen_s == 0) {
+		go_to_sleep();
+	} else {
+		phase = PH_LISTEN;
+		k_timer_start(&listen_timer, K_SECONDS(cfg.listen_s), K_NO_WAIT);
+	}
+}
+
+#if NOSTR
+static bool txq_add_nostr(const uint8_t *frame, size_t len)
+{
+	if (txq_n >= TXQ_MAX) {
+		return false;
+	}
+	uint8_t *b = txq[txq_n];
+
+	b[0] = LT_MC_HDR_REPORT_FLOOD; /* flood GRP_DATA */
+	b[1] = 0;                      /* no path yet */
+	size_t w = lt_channel_wrap(nostr_key, LT_NOSTR_DATA_TYPE, frame, len, b + 2, sizeof(txq[0]) - 2);
+	if (!w) {
+		return false;
+	}
+	txq_len[txq_n++] = w + 2;
+	return true;
+}
+
+static bool txq_add_dm(const char *text)
+{
+	uint8_t iv[16], fr[LT_NOSTR_MAX_FRAME];
+	uint32_t t = now_unix();
+
+	if (!nostr_ok || !cfg.has_owner || !t) {
+		return false;
+	}
+	rng.random(iv, sizeof(iv));
+	size_t l = lt_nostr_dm_frame(cfg.nostr_sk, cfg.owner, t, text, MIN(strlen(text), LT_NOSTR_DM_REF_MAX_TEXT),
+				     iv, true, fr, sizeof(fr));
+	return l && txq_add_nostr(fr, l);
+}
+
+static bool txq_add_poll(void)
+{
+	uint8_t fr[LT_NOSTR_POLL_FRAME_LEN];
+	uint32_t t = now_unix();
+
+	return nostr_ok && t && lt_nostr_poll_frame(cfg.nostr_sk, t, fr) && txq_add_nostr(fr, sizeof(fr));
+}
+
+static const char *mode_name(lt_mode_t m)
+{
+	static const char *names[] = {"IDLE", "TRACK", "LISTEN", "LOST"};
+
+	return m <= LT_MODE_LOST ? names[m] : "?";
+}
+
+/* Is this wake-up's report the public one? LOST mode: always; else every k-th (public <k>). */
+static bool public_due(void)
+{
+	return nostr_ok && now_unix() &&
+	       (mode == LT_MODE_LOST || (cfg.public_every && report_cycle % cfg.public_every == 0));
+}
+
+/* Optional extras, both off by default: low-battery DM and the inbox poll. */
+static void add_nostr_extras(uint8_t pct, bool low)
+{
+	if (!nostr_ok || !now_unix()) {
+		return;
+	}
+	bool dm_sent = false;
+	if (cfg.dm_alerts && low && !low_alert_sent) {
+		char msg[48];
+
+		snprintf(msg, sizeof(msg), "LibreTag: battery %u%%, mode %s", pct, mode_name(mode));
+		dm_sent = txq_add_dm(msg);
+		low_alert_sent = dm_sent;
+	}
+	if (pct > cfg.low_batt_pct + 10) {
+		low_alert_sent = false;
+	}
+	/* a DM uplink opens the bridge's queue too, so the poll is only needed without one */
+	if (!dm_sent && cfg.has_owner && cfg.inbox_every && report_cycle % cfg.inbox_every == 0) {
+		txq_add_poll();
+	}
+}
+#endif
+
+/* One report into the TX queue: public (#nostr) or the encrypted one. */
+static bool txq_add_report(const lt_report_t *r, uint32_t n, bool pub)
+{
+	if (txq_n >= TXQ_MAX) {
+		return false;
+	}
+#if NOSTR
+	if (pub) {
+		uint8_t pt[LT_REPORT_PT_LEN], fr[LT_NOSTR_PUBLIC_FRAME_LEN];
+
+		lt_report_encode(r, pt);
+		return lt_nostr_public_frame(cfg.key, n, pt, r->time, fr) && txq_add_nostr(fr, sizeof(fr));
+	}
+#else
+	ARG_UNUSED(pub);
+#endif
+	size_t l = cfg.channel_mode ? lt_build_channel_report_packet(cfg.key, chan_key, n, r, txq[txq_n])
+				    : lt_build_report_packet(cfg.key, n, r, txq[txq_n]);
+	if (!l) {
+		return false;
+	}
+	txq_len[txq_n++] = l;
+	return true;
+}
+
+static bool disc_start(uint32_t sec, bool quiet);
+static void fill_neighbours(lt_report_t *r);
+static void mesh_scan_clear(void);
+
+static void send_report(bool with_fix)
+{
+	k_timer_stop(&fix_timer);
+
+	uint8_t pct = board.getBattPercent();
+	bool low = pct <= cfg.low_batt_pct;
+
+	if (low && pct < 10 && mode != LT_MODE_IDLE) {
+		LOG_WRN("battery %u %%, leaving mode %d", pct, mode);
+		mode = LT_MODE_IDLE;
+	}
+
+	lt_report_t r = {};
+	r.has_fix = with_fix && fix_valid;
+	r.time = r.has_fix ? fix_time : now_unix();
+	r.lat_e7 = r.has_fix ? (int32_t)llround(fix_lat * 1e7) : 0;
+	r.lon_e7 = r.has_fix ? (int32_t)llround(fix_lon * 1e7) : 0;
+	r.alt_m = r.has_fix ? (int16_t)CLAMP(fix_alt_m, -32768, 32767) : 0;
+	r.hacc_m = 255;
+	r.speed_kmh = 255;
+	r.heading = 0xFFFF;
+	r.battery = pct;
+	r.mode = mode;
+	r.cmd_ack = pending_ack;
+	r.cmd_seq = last_cmd_seq;
+	r.low_batt = low;
+	if (!r.has_fix) {
+		fill_neighbours(&r); /* last fix and nearby repeaters (PROTOCOL.md 3) */
+	}
+	last_wake_fix = r.has_fix;
+	last_sent = r;
+	last_sent_valid = true;
+	if (!mesh_scanning) {
+		mesh_scan_clear(); /* next report: what was heard after this one */
+	}
+
+	size_t nets = plan_networks(&r);
+
+	txq_reset();
+	bool pub = false;
+#if NOSTR
+	/* The public report REPLACES the encrypted one: one packet per wake-up either way. It
+	 * carries the same sealed report, so the owner's app still opens it (on #nostr). */
+	pub = public_due() && r.time;
+#endif
+	if (!txq_add_report(&r, n_cur, pub) && pub) {
+		pub = false;
+		txq_add_report(&r, n_cur, false);
+	}
+	LOG_INF("%s report n=%u fix=%d batt=%u%% low=%d mode=%d len=%u", pub ? "public" : "private", n_cur,
+		r.has_fix, pct, low, mode, (unsigned)txq_len[0]);
+	checkpoint_counter();
+	n_report = n_cur; /* app commands are bound to this report, public or not */
+	n_report_valid = true;
+	n_report_alt_valid = false;
+	n_cur++;
+	/* Near a border, the same report once more on the neighbour's network. A new counter
+	 * makes it a different packet: repeaters that heard the first copy would drop an
+	 * identical second one. */
+	if (nets == 2) {
+		int i = txq_n;
+
+		checkpoint_counter();
+		if (txq_add_report(&r, n_cur, pub)) {
+			txq_alt[i] = true;
+			n_report_alt = n_cur;
+			n_report_alt_valid = true;
+			LOG_INF("border: copy n=%u on %s's network", n_cur, country_iso(alt_net.country));
+			n_cur++;
+		}
+	}
+	pending_ack = false;
+#if NOSTR
+	add_nostr_extras(pct, low);
+#endif
+	report_cycle++;
+	txq_route_all();
+
+	radio.recoverRxState(); /* wake the chip; TX goes out from RX (LBT) */
+	try_tx();
+}
+
+static void start_report(void)
+{
+	if (phase != PH_SLEEP) {
+		return;
+	}
+	if (gps_is_available() && gps_is_enabled()) {
+		phase = PH_WAIT_FIX;
+		fix_valid = false;
+		gps_request_fresh_fix();
+		uint32_t to = first_fix_pending ? CONFIG_ZEPHCORE_GPS_FIRST_FIX_TIMEOUT_SEC
+						: cfg.fix_timeout_s;
+		k_timer_start(&fix_timer, K_SECONDS(to), K_NO_WAIT);
+		LOG_INF("waiting up to %u s for a fix", to);
+		/* Indoors last time (or LOST): ask the repeaters around while the GPS searches.
+		 * One 8-byte zero-hop packet; answers come within seconds. */
+		if ((!last_wake_fix || mode == LT_MODE_LOST) && !mesh_scanning) {
+			disc_start(WAKE_DISCOVER_S, true);
+		}
+	} else {
+		send_report(false);
+	}
+}
+
+static void gps_fix_cb(double lat, double lon, int64_t utc)
+{
+	if (utc > 1600000000) {
+		clock_unix = utc;
+		clock_uptime_ms = k_uptime_get();
+	}
+	if (phase != PH_WAIT_FIX) {
+		return;
+	}
+	struct gps_position pos;
+	gps_get_position(&pos);
+	fix_valid = true;
+	fix_lat = lat;
+	fix_lon = lon;
+	fix_alt_m = pos.altitude_mm / 1000;
+	fix_time = utc > 0 ? (uint32_t)utc : now_unix();
+	first_fix_pending = false;
+	if (fix_time) {
+		/* the next report without a fix carries this (with its GPS time) */
+		cfg.last_fix_time = fix_time;
+		cfg.last_lat_e7 = (int32_t)llround(lat * 1e7);
+		cfg.last_lon_e7 = (int32_t)llround(lon * 1e7);
+		save_cfg();
+	}
+	send_report(true);
+}
+
+/* ------------------------------------------------------------------ commands */
+
+static uint16_t u16le(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+
+static void apply_command(const lt_command_t *c)
+{
+	switch (c->op) {
+	case LT_OP_SET_MODE: {
+		uint8_t m = c->args[0];
+		uint16_t interval = u16le(c->args + 1);
+		uint16_t dur_min = u16le(c->args + 3);
+
+		mode = (lt_mode_t)(m <= LT_MODE_LOST ? m : LT_MODE_IDLE);
+		if (interval) {
+			track_interval_s = MAX(interval, 30);
+		}
+		mode_until_ms = k_uptime_get() + (int64_t)(dur_min ? dur_min : 120) * 60000;
+		break;
+	}
+	case LT_OP_PING:
+		ping_requested = true;
+		break;
+	case LT_OP_SET_IDLE: {
+		uint16_t iv = u16le(c->args), ls = u16le(c->args + 2);
+
+		if (iv) {
+			cfg.interval_min = iv;
+		}
+		if (ls) {
+			cfg.listen_s = MIN(ls, 600);
+		}
+		save_cfg();
+		break;
+	}
+	case LT_OP_BUZZ:
+		LOG_INF("buzz %u s (not implemented on this board yet)", c->args[0]);
+		break;
+	default:
+		return;
+	}
+	last_cmd_seq = c->seq;
+	pending_ack = true;
+	save_mode();
+	LOG_INF("command op=%u seq=%u applied", c->op, c->seq);
+}
+
+#if NOSTR
+static bool word(const char **p, const char *w)
+{
+	size_t l = strlen(w);
+
+	if (strncasecmp(*p, w, l) || ((*p)[l] && (*p)[l] != ' ')) {
+		return false;
+	}
+	*p += l;
+	while (**p == ' ') {
+		(*p)++;
+	}
+	return true;
+}
+
+/* A text command from the owner; returns the reply DM. */
+static void dm_command(const char *t, char *reply, size_t cap)
+{
+	if (word(&t, "ping") || word(&t, "report")) {
+		ping_requested = true;
+		snprintf(reply, cap, "ok, report follows");
+	} else if (word(&t, "status")) {
+		if (fix_valid) {
+			snprintf(reply, cap, "b%u%% %s %.5f,%.5f", board.getBattPercent(), mode_name(mode), fix_lat,
+				 fix_lon);
+		} else {
+			snprintf(reply, cap, "b%u%% %s nofix", board.getBattPercent(), mode_name(mode));
+		}
+	} else if (word(&t, "track")) {
+		int mins = atoi(t), ivs = 0;
+		const char *sp = strchr(t, ' ');
+
+		if (sp) {
+			ivs = atoi(sp + 1);
+		}
+		mode = LT_MODE_TRACK;
+		track_interval_s = ivs >= 30 ? (uint32_t)ivs : 120;
+		mode_until_ms = k_uptime_get() + (int64_t)(mins > 0 ? mins : 60) * 60000;
+		snprintf(reply, cap, "ok track %d min every %u s", mins > 0 ? mins : 60, track_interval_s);
+	} else if (word(&t, "lost")) {
+		int mins = atoi(t);
+
+		mode = LT_MODE_LOST;
+		track_interval_s = (uint32_t)(mins >= 5 ? mins : 30) * 60U;
+		mode_until_ms = k_uptime_get() + 24LL * 3600 * 1000;
+		snprintf(reply, cap, "ok LOST 24 h, public report every %u min", track_interval_s / 60);
+	} else if (word(&t, "idle")) {
+		mode = LT_MODE_IDLE;
+		snprintf(reply, cap, "ok idle, every %u min", cfg.interval_min);
+	} else if (word(&t, "public")) {
+		cfg.public_every = (uint8_t)CLAMP(atoi(t), 0, 255);
+		save_cfg();
+		snprintf(reply, cap, "ok public every %u", cfg.public_every);
+	} else {
+		snprintf(reply, cap, "cmds: ping status track [min s] lost [min] idle public k");
+	}
+}
+
+/* DM from the owner on #nostr: verify, decrypt, act, answer. */
+static bool handle_nostr_rx(const uint8_t *raw, size_t len)
+{
+	const uint8_t *p;
+	uint8_t frame[LT_NOSTR_MAX_FRAME + 16];
+	char text[LT_NOSTR_DM_REF_MAX_TEXT + 64], reply[LT_NOSTR_DM_REF_MAX_TEXT + 1];
+	lt_dm_info_t info;
+	size_t pl = lt_packet_grp_payload(raw, len, &p);
+
+	if (!pl || !nostr_ok || !cfg.has_owner) {
+		return false;
+	}
+	int fl = lt_channel_unwrap(nostr_key, LT_NOSTR_DATA_TYPE, p, pl, frame, sizeof(frame));
+	if (fl <= 0) {
+		return false;
+	}
+	int tl = lt_nostr_open_dm(frame, (size_t)fl, cfg.nostr_sk, my_pk, cfg.owner, text, sizeof(text), &info);
+	if (tl < 0) {
+		if (tl != -1) {
+			LOG_WRN("DM for us rejected (%d)", tl);
+		}
+		return false;
+	}
+	if (info.created_at < cfg.last_dm_at ||
+	    (info.created_at == cfg.last_dm_at && !memcmp(info.id, last_dm_id, sizeof(last_dm_id)))) {
+		return false; /* replay or a second copy */
+	}
+	cfg.last_dm_at = info.created_at;
+	memcpy(last_dm_id, info.id, sizeof(last_dm_id));
+	save_cfg();
+	LOG_INF("DM from owner: %s", text);
+	dm_command(text, reply, sizeof(reply));
+	txq_reset();
+	if (txq_add_dm(reply)) {
+		k_timer_stop(&listen_timer);
+		txq_route_all();
+		radio.recoverRxState();
+		try_tx(); /* then a fresh LISTEN window: the owner may write again */
+	}
+	return true;
+}
+#endif
+
+static void mesh_scan_record(const uint8_t *b, size_t n, int16_t rssi, int8_t snr);
+
+static void handle_rx(void)
+{
+	uint8_t buf[256];
+	int len;
+
+	while ((len = radio.recvRaw(buf, sizeof(buf))) > 0) {
+		mesh_scan_record(buf, (size_t)len, (int16_t)radio.getLastRSSI(), (int8_t)radio.getLastSNR());
+		if (phase == PH_LISTEN && !radio.hasRadioOverride()) {
+			home_heard = true;
+		}
+		if (phase != PH_LISTEN) {
+			continue;
+		}
+		lt_command_t c;
+		bool ok = false;
+
+		for (int k = 0; k < 2 && !ok; k++) {
+			uint32_t n = k ? n_report_alt : n_report;
+
+			if (!(k ? n_report_alt_valid : n_report_valid)) {
+				continue;
+			}
+			ok = cfg.channel_mode
+				     ? lt_parse_channel_command_packet(cfg.key, chan_key, n, buf, (size_t)len, &c)
+				     : lt_parse_command_packet(cfg.key, n, buf, (size_t)len, &c);
+		}
+		if (ok) {
+			apply_command(&c);
+			k_timer_stop(&listen_timer);
+			go_to_sleep();
+			return;
+		}
+#if NOSTR
+		if (handle_nostr_rx(buf, (size_t)len)) {
+			return;
+		}
+#endif
+	}
+}
+
+
+/* ------------------------------------------------------------------ position without GPS (experiment)
+ *
+ * meshscan: which repeaters does the tracker hear directly, how loud, and where are they
+ * (from their adverts)? The phone could estimate a position from that.
+ * blescan: which Bluetooth devices are around (addresses, names, makers).
+ * Both print to the CLI only; nothing goes over the air yet. */
+
+struct mesh_nb {
+	uint8_t hash[3];   /* first bytes of the repeater's public key */
+	uint8_t hash_size; /* as heard in the path */
+	int16_t rssi_max;
+	int8_t snr_max;    /* dB */
+	uint16_t heard;
+};
+
+struct mesh_adv {
+	uint8_t key[4];
+	uint8_t type;      /* 1 chat, 2 repeater, 3 room, 4 sensor */
+	uint8_t hops;
+	bool has_loc;
+	int32_t lat_e6, lon_e6;
+	int16_t rssi;
+	int8_t snr;
+	char name[24];
+};
+
+#define MESH_NB_MAX 24
+#define MESH_ADV_MAX 24
+static struct mesh_nb mesh_nb[MESH_NB_MAX];
+static struct mesh_adv mesh_adv[MESH_ADV_MAX];
+static uint8_t mesh_nb_n, mesh_adv_n;
+static uint32_t mesh_pkts;
+static int16_t mesh_noise_avg = 0, mesh_noise_max = -200; /* measured at the end of a scan */
+
+/* discover: zero-hop CTL_TYPE_NODE_DISCOVER_REQ, every repeater in range answers once */
+struct mesh_disc {
+	uint8_t key[8];   /* public key prefix */
+	int8_t their_snr4; /* how the repeater heard us, dB x4 */
+	int8_t snr;        /* how we heard its answer */
+	int16_t rssi;
+};
+#define MESH_DISC_MAX 24
+static struct mesh_disc mesh_disc[MESH_DISC_MAX];
+static uint8_t mesh_disc_n;
+static uint32_t disc_tag;
+static bool disc_tx_pending;
+static bool disc_quiet;      /* automatic discover at a wake-up: no CLI output */
+
+static void mesh_scan_clear(void)
+{
+	mesh_disc_n = 0;
+	mesh_nb_n = 0;
+	mesh_adv_n = 0;
+	mesh_pkts = 0;
+}
+
+static void mesh_note_neighbor(const uint8_t *h, uint8_t hs, int16_t rssi, int8_t snr)
+{
+	hs = MIN(hs, (uint8_t)3);
+	for (uint8_t i = 0; i < mesh_nb_n; i++) {
+		struct mesh_nb *e = &mesh_nb[i];
+		size_t cmp = MIN(hs, e->hash_size);
+
+		if (memcmp(e->hash, h, cmp) == 0) {
+			if (hs > e->hash_size) {
+				memcpy(e->hash, h, hs);
+				e->hash_size = hs;
+			}
+			e->rssi_max = MAX(e->rssi_max, rssi);
+			e->snr_max = MAX(e->snr_max, snr);
+			e->heard++;
+			return;
+		}
+	}
+	if (mesh_nb_n < MESH_NB_MAX) {
+		struct mesh_nb *e = &mesh_nb[mesh_nb_n++];
+
+		memcpy(e->hash, h, hs);
+		e->hash_size = hs;
+		e->rssi_max = rssi;
+		e->snr_max = snr;
+		e->heard = 1;
+	}
+}
+
+static void mesh_note_advert(const uint8_t *p, size_t n, uint8_t hops, int16_t rssi, int8_t snr)
+{
+	/* pubkey 32, timestamp 4, signature 64, app data: flags [lat lon] [name] */
+	if (n < 101) {
+		return;
+	}
+	const uint8_t *ad = p + 100;
+	size_t an = n - 100;
+	uint8_t flags = ad[0];
+	struct mesh_adv a = {};
+
+	memcpy(a.key, p, 4);
+	a.type = flags & 0x0F;
+	a.hops = hops;
+	a.rssi = rssi;
+	a.snr = snr;
+	size_t o = 1;
+	if ((flags & 0x10) && an >= o + 8) {
+		a.has_loc = true;
+		a.lat_e6 = (int32_t)sys_get_le32(ad + o);
+		a.lon_e6 = (int32_t)sys_get_le32(ad + o + 4);
+		o += 8;
+	}
+	if (flags & 0x20) o += 2;
+	if (flags & 0x40) o += 2;
+	if ((flags & 0x80) && an > o) {
+		size_t l = MIN(an - o, sizeof(a.name) - 1);
+		memcpy(a.name, ad + o, l);
+		a.name[l] = 0;
+	}
+	for (uint8_t i = 0; i < mesh_adv_n; i++) {
+		if (memcmp(mesh_adv[i].key, a.key, 4) == 0) {
+			if (hops < mesh_adv[i].hops || (hops == mesh_adv[i].hops && rssi > mesh_adv[i].rssi)) {
+				mesh_adv[i] = a;
+			}
+			return;
+		}
+	}
+	if (mesh_adv_n < MESH_ADV_MAX) {
+		mesh_adv[mesh_adv_n++] = a;
+	}
+}
+
+/* Every received packet: who transmitted what we heard? */
+static void mesh_scan_record(const uint8_t *b, size_t n, int16_t rssi, int8_t snr)
+{
+	if (n < 2) {
+		return;
+	}
+	uint8_t route = b[0] & 0x03, ptype = (b[0] >> 2) & 0x0F;
+	size_t o = 1;
+
+	mesh_pkts++;
+	/* discover answer: direct, zero hop, CONTROL, 0x9n, snr, tag, key prefix */
+	if (route == 0x02 && ptype == 0x0B && n >= 2 + 6 + 8 && b[1] == 0 && (b[2] & 0xF0) == 0x90 &&
+	    disc_tag && sys_get_le32(b + 4) == disc_tag) {
+		for (uint8_t i = 0; i < mesh_disc_n; i++) {
+			if (memcmp(mesh_disc[i].key, b + 8, 8) == 0) {
+				return;
+			}
+		}
+		if (mesh_disc_n < MESH_DISC_MAX) {
+			struct mesh_disc *d = &mesh_disc[mesh_disc_n++];
+
+			memcpy(d->key, b + 8, 8);
+			d->their_snr4 = (int8_t)b[3];
+			d->snr = snr;
+			d->rssi = rssi;
+		}
+		return;
+	}
+	if (route == 0x00 || route == 0x03) {
+		o += 4; /* transport codes */
+	}
+	if (n < o + 1) {
+		return;
+	}
+	uint8_t pl = b[o++];
+	uint8_t hs = (pl >> 6) + 1, hops = pl & 0x3F;
+	size_t path_bytes = (size_t)hs * hops;
+
+	if (n < o + path_bytes) {
+		return;
+	}
+	bool flood = route == 0x00 || route == 0x01;
+
+	if (flood && hops > 0) {
+		/* the last hop in a flood path is the repeater we just heard */
+		mesh_note_neighbor(b + o + path_bytes - hs, hs, rssi, snr);
+	}
+	if (ptype == 0x04) {
+		const uint8_t *p = b + o + path_bytes;
+
+		if (flood && hops == 0 && n >= o + path_bytes + 32) {
+			mesh_note_neighbor(p, 3, rssi, snr); /* zero-hop advert: the sender itself */
+		}
+		mesh_note_advert(p, n - o - path_bytes, hops, rssi, snr);
+	}
+}
+
+static const char *mesh_type_name(uint8_t t)
+{
+	switch (t) {
+	case 1: return "chat";
+	case 2: return "repeater";
+	case 3: return "room";
+	case 4: return "sensor";
+	default: return "?";
+	}
+}
+
+static void mesh_scan_print(void)
+{
+	out("meshscan: %u packet(s), %u discover answer(s), %u direct neighbour(s), %u advert(s), "
+	    "noise avg %d max %d dBm\r\n",
+	    (unsigned)mesh_pkts, mesh_disc_n, mesh_nb_n, mesh_adv_n, mesh_noise_avg, mesh_noise_max);
+	for (uint8_t i = 0; i < mesh_disc_n; i++) {
+		const struct mesh_disc *d = &mesh_disc[i];
+		char h[17];
+
+		hex(h, d->key, 8);
+		out(" disc %s heard us at snr %d.%02d, we heard it rssi %d snr %d\r\n", h, d->their_snr4 / 4,
+		    (abs(d->their_snr4) % 4) * 25, d->rssi, d->snr);
+	}
+	for (uint8_t i = 0; i < mesh_nb_n; i++) {
+		const struct mesh_nb *e = &mesh_nb[i];
+		char h[8];
+
+		hex(h, e->hash, e->hash_size);
+		/* match the hash to an advert we heard, if any */
+		const struct mesh_adv *a = NULL;
+		for (uint8_t j = 0; j < mesh_adv_n && !a; j++) {
+			if (memcmp(mesh_adv[j].key, e->hash, MIN(e->hash_size, (uint8_t)4)) == 0) {
+				a = &mesh_adv[j];
+			}
+		}
+		out(" nb %s rssi %d snr %d x%u%s%s\r\n", h, e->rssi_max, e->snr_max, e->heard,
+		    a ? " = " : "", a ? a->name : "");
+	}
+	for (uint8_t i = 0; i < mesh_adv_n; i++) {
+		const struct mesh_adv *a = &mesh_adv[i];
+		char h[10];
+
+		hex(h, a->key, 4);
+		if (a->has_loc) {
+			out(" adv %s %s \"%s\" hops %u rssi %d snr %d at %.5f,%.5f\r\n", h, mesh_type_name(a->type),
+			    a->name, a->hops, a->rssi, a->snr, a->lat_e6 / 1e6, a->lon_e6 / 1e6);
+		} else {
+			out(" adv %s %s \"%s\" hops %u rssi %d snr %d (no location)\r\n", h,
+			    mesh_type_name(a->type), a->name, a->hops, a->rssi, a->snr);
+		}
+	}
+}
