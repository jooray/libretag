+void gps_stop_acquiring(void)
+{
+#if HAS_GNSS
+	if (gps_available && gps_enabled && gps_current_state == GPS_STATE_ACQUIRING &&
+	    gps_duty_cycling()) {
+		k_work_reschedule(&gps_timeout_work, K_NO_WAIT);
+	}
+#endif
+}
