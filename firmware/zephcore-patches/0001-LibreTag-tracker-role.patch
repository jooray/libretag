+++ b/zephcore/src/main_tracker.cpp
@@ -0,0 +1,2073 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * ZephCore - LibreTag tracker role
+ *
+ * A sleeping GPS tracker over MeshCore (LibreTag PROTOCOL.md):
+ *
+ *   SLEEP --report due--> WAIT_FIX --fix/timeout--> TX --done--> LISTEN --window--> SLEEP
+ *
+ * No mesh identity, no adverts, no forwarding. The radio sleeps outside the
+ * LISTEN window; the GNSS is woken only for a fix. A text CLI on the USB CDC
+ * port shows the pairing key and changes settings (type `help`).
+ *
+ * With CONFIG_LIBRETAG_NOSTR (docs/nostr-mesh-bridge.md) one wake-up may send
+ * several packets before listening: the encrypted report, the public Nostr
+ * report (LOST mode or every k-th), a NIP-04 DM to the owner (low battery,
+ * replies) and the inbox poll that makes nostrmesh bridges hand over DMs the
+ * owner sent from any Nostr client. DMs from the owner carry text commands.
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/devicetree.h>
+#include <zephyr/drivers/gpio.h>
+#include <zephyr/fs/fs.h>
+#include <zephyr/random/random.h>
+#include <zephyr/sys/util.h>
+#include <zephyr/sys/byteorder.h>
+#include <zephyr/spinlock.h>
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+#include <zephyr/bluetooth/bluetooth.h>
+#include <zephyr/bluetooth/hci.h>
+#endif
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(zephcore_tracker, CONFIG_ZEPHCORE_MAIN_LOG_LEVEL);
+
+#define ZEPHCORE_USB_STACK \
+	(IS_ENABLED(CONFIG_USB_CDC_ACM) || IS_ENABLED(CONFIG_USBD_CDC_ACM_CLASS))
+
+#if ZEPHCORE_USB_STACK && !IS_ENABLED(CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT)
+#include <ZephyrUSBCDC.h>
+#endif
+
+#if ZEPHCORE_USB_STACK && DT_HAS_COMPAT_STATUS_OKAY(zephyr_cdc_acm_uart) && \
+	!IS_ENABLED(CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT)
+#define CLI_NODE DT_COMPAT_GET_ANY_STATUS_OKAY(zephyr_cdc_acm_uart)
+#else
+#define CLI_NODE DT_CHOSEN(zephyr_console)
+#endif
+
+#include <app/RepeaterDataStore.h>
+#include <src/RadioIncludes.h>
+#include <src/mesh_events.h>
+#include <helpers/NodePrefs.h>
+#include <adapters/transport/ZephyrUartStream.h>
+#include "ZephyrGPSManager.h"
+#include "../adapters/datastore/ZephyrFsFormat.h"
+#include "../adapters/datastore/ZephyrFsUtil.h"
+#include "oled_power.h"
+#if IS_ENABLED(CONFIG_ZEPHCORE_UI_DISPLAY)
+#include "display.h"
+#endif
+
+extern "C" {
+#include "lt_core.h"
+#include "lt_region.h"
+#include "lt_version.h"
+#if IS_ENABLED(CONFIG_LIBRETAG_NOSTR)
+#include "lt_nostr.h"
+#endif
+}
+
+#define NOSTR IS_ENABLED(CONFIG_LIBRETAG_NOSTR)
+
+#if IS_ENABLED(CONFIG_BT_CTLR_ASSERT_HANDLER)
+/* nrf52_common.conf turns the controller assert handler on; the BLE scan pulls it in */
+extern "C" void bt_ctlr_assert_handle(char *file, uint32_t line)
+{
+	LOG_ERR("BT controller assert %s:%u", file, line);
+	k_panic();
+}
+#endif
+
+/* ------------------------------------------------------------------ events */
+
+#define EV_REPORT_DUE  BIT(MESH_EVENT_ROLE_BASE + 0)
+#define EV_FIX_TIMEOUT BIT(MESH_EVENT_ROLE_BASE + 1)
+#define EV_LISTEN_END  BIT(MESH_EVENT_ROLE_BASE + 2)
+#define EV_TX_RETRY    BIT(MESH_EVENT_ROLE_BASE + 3)
+#define EV_SCAN_END    BIT(MESH_EVENT_ROLE_BASE + 4)
+#define EV_ALL (MESH_EVENT_LORA_RX | MESH_EVENT_LORA_TX_DONE | MESH_EVENT_CLI_RX | \
+		MESH_EVENT_GPS_ACTION | EV_REPORT_DUE | EV_FIX_TIMEOUT | EV_LISTEN_END | EV_TX_RETRY | \
+		EV_SCAN_END)
+
+static struct k_event events;
+
+#define TIMER(name, ev)                                                      \
+	static void name##_fn(struct k_timer *t) { ARG_UNUSED(t); k_event_post(&events, ev); } \
+	K_TIMER_DEFINE(name, name##_fn, NULL)
+
+TIMER(report_timer, EV_REPORT_DUE);
+TIMER(fix_timer, EV_FIX_TIMEOUT);
+TIMER(listen_timer, EV_LISTEN_END);
+TIMER(retry_timer, EV_TX_RETRY);
+TIMER(scan_timer, EV_SCAN_END);
+
+static void post_lora_rx(void *) { k_event_post(&events, MESH_EVENT_LORA_RX); }
+static void post_lora_tx_done(void *) { k_event_post(&events, MESH_EVENT_LORA_TX_DONE); }
+static void post_cli_rx(void) { k_event_post(&events, MESH_EVENT_CLI_RX); }
+static void post_cli_tx_idle(void) {}
+static void post_gps_event(void) { k_event_post(&events, MESH_EVENT_GPS_ACTION); }
+
+/* ------------------------------------------------------------------ hardware */
+
+static mesh::ZephyrBoard board;
+static const struct device *const lora_dev = DEVICE_DT_GET(DT_ALIAS(lora0));
+static mesh::LoRaRadio radio(lora_dev, board);
+static mesh::ZephyrRNG rng;
+static RepeaterDataStore data_store;
+static ZephyrUartStream cli;
+static NodePrefs prefs;
+
+/* ------------------------------------------------------------------ state */
+
+#define STATE_DIR  "/lfs/libretag"
+#define STATE_FILE STATE_DIR "/state"
+#define STATE_MAGIC_V1 0x4C544731u /* "LTG1" */
+#define STATE_MAGIC_V2 0x4C544732u /* "LTG2": v1 + Nostr fields appended */
+#define STATE_MAGIC_V3 0x4C544733u /* "LTG3": v2 + network (path hash size, region) */
+#define STATE_MAGIC 0x4C544734u    /* "LTG4": v3 + last fix, mode, last command */
+#define N_CHECKPOINT 16
+
+struct persisted {
+	uint32_t magic;
+	uint8_t key[LT_KEY_SIZE];
+	uint32_t n_next;          /* counter to use after a reboot (checkpointed ahead) */
+	uint16_t interval_min;
+	uint16_t listen_s;
+	uint16_t fix_timeout_s;
+	uint8_t channel_mode;
+	uint8_t low_batt_pct;
+	float freq;
+	float bw;
+	uint8_t sf;
+	uint8_t cr;
+	int8_t tx_power;
+	uint8_t region_manual;    /* 0: radio preset and region follow the country (SPEC 6.4) */
+	/* v2: Nostr (the device key never leaves the device; `nostr` prints the npub) */
+	uint8_t nostr_sk[32];
+	uint8_t owner[32];
+	uint8_t has_owner;
+	uint8_t public_every;  /* 0 off, k = every k-th report (LOST mode: every report) */
+	uint8_t inbox_every;   /* inbox poll every k-th wake-up, 0 off */
+	uint8_t dm_alerts;     /* DM the owner on low battery */
+	uint32_t last_dm_at;   /* replay guard for DMs from the owner */
+	/* v3: network the reports go to */
+	uint8_t path_hash_size; /* 1..3 bytes per hop in the flood path */
+	uint8_t country;        /* lt_countries index the network was chosen for, 0 = none */
+	char scope[30];         /* region (flood scope), "" = unscoped */
+	/* v4: survives a reboot */
+	uint32_t last_fix_time;   /* unix s of the last fix (GPS time), 0 = none */
+	int32_t last_lat_e7;
+	int32_t last_lon_e7;
+	uint8_t mode;             /* lt_mode_t; LOST must survive a brownout */
+	uint8_t last_cmd_seq;     /* acknowledged in reports; 0 after a reboot faked ACKs */
+	uint16_t mode_left_min;   /* minutes of TRACK/LOST left when saved */
+	uint16_t track_interval_s;
+};
+
+#define V1_SIZE offsetof(struct persisted, nostr_sk)
+#define V2_SIZE offsetof(struct persisted, path_hash_size)
+#define V3_SIZE offsetof(struct persisted, last_fix_time)
+#define BORDER_M 3000U /* within this of a border, the neighbour's network is a candidate */
+/* Second copy on the neighbour's network only when the home network was silent in this many
+ * listen windows in a row: if home repeaters are audible (often true just across a border), they
+ * carry the report and a second flood only loads the mesh. */
+#define HOME_SILENT_WINDOWS 3
+
+static struct persisted cfg;
+static uint8_t chan_key[16];
+static uint8_t scope_key[16]; /* of cfg.scope */
+static lt_net_t alt_net;      /* the neighbour's network near a border */
+static uint8_t alt_scope_key[16];
+
+enum phase { PH_SLEEP, PH_WAIT_FIX, PH_TX, PH_LISTEN };
+static enum phase phase = PH_SLEEP;
+
+static uint32_t n_cur;            /* next report counter */
+static uint32_t n_report;         /* counter of the last encrypted report: commands are bound to it */
+static bool n_report_valid;
+static uint32_t n_report_alt;     /* the copy on the neighbour's network, if any */
+static bool n_report_alt_valid;
+static lt_mode_t mode = LT_MODE_IDLE;
+static uint32_t track_interval_s = 120;
+static int64_t mode_until_ms;
+static uint8_t last_cmd_seq;
+static bool pending_ack;
+static bool ping_requested;
+static bool mesh_scanning; /* meshscan: keep the radio in RX while asleep */
+static bool last_wake_fix; /* the previous wake-up got a fix (outside, no need to ask); unknown at boot */
+static lt_report_t last_sent; /* for `status` */
+static bool last_sent_valid;
+#define WAKE_DISCOVER_S 15
+static uint8_t home_silent = 255;  /* listen windows in a row without a packet on the home radio */
+static bool home_heard;           /* a packet arrived on the home radio in this listen window */
+/* "test" CLI: reports left (this one included) and the gap between them, no jitter */
+static uint8_t test_left;
+static uint32_t test_interval_s;
+static int64_t test_due_ms; /* when the last test report was due; the next is interval_s later */
+static bool first_fix_pending = true;
+
+/* packets of one wake-up, sent back to back before the LISTEN window */
+#define TXQ_MAX 4
+static uint8_t txq[TXQ_MAX][192];
+static size_t txq_len[TXQ_MAX];
+static bool txq_alt[TXQ_MAX]; /* goes out on alt_net */
+static int txq_n, txq_i;
+static int tx_tries;
+static uint32_t report_cycle;
+
+#if NOSTR
+static uint8_t nostr_key[16]; /* #nostr channel */
+static uint8_t my_pk[32];
+static bool nostr_ok;         /* secp256k1 and AES-256 self-test passed */
+static bool low_alert_sent;
+static uint8_t last_dm_id[8];
+#endif
+
+/* wall clock: GNSS time anchored to uptime */
+static int64_t clock_unix;
+static int64_t clock_uptime_ms;
+
+/* last fix */
+static bool fix_valid;
+static double fix_lat, fix_lon;
+static int32_t fix_alt_m;
+static uint32_t fix_time;
+
+static uint32_t now_unix(void)
+{
+	if (clock_unix == 0) {
+		return 0;
+	}
+	return (uint32_t)(clock_unix + (k_uptime_get() - clock_uptime_ms) / 1000);
+}
