+if ZEPHCORE_ROLE_TRACKER
+
+config LIBRETAG_REPORT_INTERVAL_MIN
+	int "Report interval in IDLE mode (minutes)"
+	default 60
+
+config LIBRETAG_LISTEN_SEC
+	int "RX window after each report (seconds)"
+	default 60
+
+config LIBRETAG_FIX_TIMEOUT_SEC
+	int "How long to wait for a GNSS fix before reporting without one"
+	default 90
+
+config LIBRETAG_LOW_BATT_PCT
+	int "Battery percentage that sets the LOW_BATT flag"
+	default 20
+
+config LIBRETAG_CHANNEL_MODE
+	bool "Send reports on the #libretag hashtag channel (for MeshCore Open apps)"
+	default y
+	help
+	  y: reports are MeshCore channel datagrams on #libretag, readable by
