+#define BLE_MAX 48
+static struct ble_seen ble_tab[BLE_MAX];
+static uint8_t ble_n;
+static uint32_t ble_adv_total;
+static struct k_spinlock ble_lock;
+static bool ble_ready, ble_scanning;
+
+static bool ble_ad(struct bt_data *d, void *user)
+{
+	struct ble_seen *e = (struct ble_seen *)user;
+
+	switch (d->type) {
+	case BT_DATA_NAME_COMPLETE:
+	case BT_DATA_NAME_SHORTENED: {
+		size_t l = MIN((size_t)d->data_len, sizeof(e->name) - 1);
+
+		memcpy(e->name, d->data, l);
+		e->name[l] = 0;
+		break;
+	}
+	case BT_DATA_MANUFACTURER_DATA:
+		if (d->data_len >= 2) {
+			e->company = sys_get_le16(d->data);
+		}
+		break;
+	default:
+		break;
+	}
+	return true;
+}
+
+static void ble_scan_cb(const bt_addr_le_t *addr, int8_t rssi, uint8_t type, struct net_buf_simple *ad)
+{
+	struct ble_seen t = {};
+
+	bt_addr_le_copy(&t.addr, addr);
+	t.rssi = rssi;
+	t.adv_type = type;
+	t.company = 0xFFFF;
+	bt_data_parse(ad, ble_ad, &t);
+
+	k_spinlock_key_t key = k_spin_lock(&ble_lock);
+
+	ble_adv_total++;
+	for (uint8_t i = 0; i < ble_n; i++) {
+		struct ble_seen *e = &ble_tab[i];
+
+		if (bt_addr_le_eq(&e->addr, addr)) {
+			e->rssi = MAX(e->rssi, rssi);
+			e->heard++;
+			if (!e->name[0] && t.name[0]) {
+				memcpy(e->name, t.name, sizeof(e->name));
+			}
+			if (e->company == 0xFFFF) {
+				e->company = t.company;
+			}
+			k_spin_unlock(&ble_lock, key);
+			return;
+		}
+	}
+	if (ble_n < BLE_MAX) {
+		t.heard = 1;
+		ble_tab[ble_n++] = t;
+	}
+	k_spin_unlock(&ble_lock, key);
+}
+
+static const char *ble_addr_kind(const bt_addr_le_t *a)
+{
+	if (a->type == BT_ADDR_LE_PUBLIC) {
+		return "public";
+	}
+	if (BT_ADDR_IS_STATIC(&a->a)) {
+		return "static";
+	}
+	if (BT_ADDR_IS_RPA(&a->a)) {
+		return "rpa";
+	}
+	return "nrpa";
+}
+
+static int ble_scan_start(bool active)
+{
+	if (!ble_ready) {
+		int err = bt_enable(NULL);
+
+		if (err && err != -EALREADY) {
+			return err;
+		}
+		ble_ready = true;
+	}
+	ble_n = 0;
+	ble_adv_total = 0;
+	struct bt_le_scan_param p = {
+		.type = active ? BT_LE_SCAN_TYPE_ACTIVE : BT_LE_SCAN_TYPE_PASSIVE,
+		.options = BT_LE_SCAN_OPT_NONE,
+		.interval = BT_GAP_SCAN_FAST_INTERVAL,
+		.window = BT_GAP_SCAN_FAST_WINDOW,
+	};
+	int err = bt_le_scan_start(&p, ble_scan_cb);
+
+	ble_scanning = err == 0;
+	return err;
+}
+
+static void ble_scan_print(void)
+{
+	bt_le_scan_stop();
+	ble_scanning = false;
+	out("blescan: %u advert(s) from %u device(s)\r\n", (unsigned)ble_adv_total, ble_n);
+	for (uint8_t i = 0; i < ble_n; i++) {
+		const struct ble_seen *e = &ble_tab[i];
+		const uint8_t *v = e->addr.a.val;
+
+		out(" %02X:%02X:%02X:%02X:%02X:%02X %-6s rssi %d x%u co %04X \"%s\"\r\n", v[5], v[4], v[3], v[2], v[1],
+		    v[0], ble_addr_kind(&e->addr), e->rssi, e->heard, e->company, e->name);
+	}
+}
+#endif /* CONFIG_BT_OBSERVER */
+
+/* Zero-hop CTL_TYPE_NODE_DISCOVER_REQ: every repeater in direct range answers once with the
+ * SNR it heard us at. Then listen `sec` seconds; answers land in mesh_disc[]. */
+static bool disc_start(uint32_t sec, bool quiet)
+{
+	uint8_t pkt[2 + 6];
+
+	mesh_scan_clear();
+	mesh_scanning = true;
+	disc_quiet = quiet;
+	do {
+		disc_tag = sys_rand32_get();
+	} while (!disc_tag);
+	pkt[0] = (0x0B << 2) | 0x02; /* CONTROL, direct: zero hop */
+	pkt[1] = 0;                  /* no path */
+	pkt[2] = 0x80 | 0x01;        /* NODE_DISCOVER_REQ, key prefix only */
+	pkt[3] = 1 << 2;             /* filter: repeaters (ADV_TYPE_REPEATER) */
+	sys_put_le32(disc_tag, pkt + 4);
+	radio.recoverRxState();
+	k_msleep(20);
+	if (!radio.startSendRaw(pkt, sizeof(pkt))) {
+		mesh_scanning = false;
+		return false;
+	}
+	disc_tx_pending = true;
+	k_timer_start(&scan_timer, K_SECONDS(sec), K_NO_WAIT);
+	return true;
+}
+
+/* The report without a fix: the two loudest repeaters (discover answers, else heard ones). */
+static void fill_neighbours(lt_report_t *r)
+{
+	r->last_fix_time = cfg.last_fix_time;
+	r->last_lat_e7 = cfg.last_lat_e7;
+	r->last_lon_e7 = cfg.last_lon_e7;
+	if (mesh_disc_n) {
+		uint8_t idx[MESH_DISC_MAX];
+
+		for (uint8_t i = 0; i < mesh_disc_n; i++) {
+			idx[i] = i;
+		}
+		for (uint8_t i = 0; i < mesh_disc_n; i++) { /* by their SNR of us, loudest first */
+			for (uint8_t j = i + 1; j < mesh_disc_n; j++) {
+				if (mesh_disc[idx[j]].their_snr4 > mesh_disc[idx[i]].their_snr4) {
+					uint8_t t = idx[i];
+					idx[i] = idx[j];
+					idx[j] = t;
+				}
+			}
+		}
+		r->nb_from_discover = true;
+		r->nb_total = mesh_disc_n;
+		r->nb_count = (uint8_t)MIN(mesh_disc_n, LT_REPORT_MAX_NB);
+		for (uint8_t i = 0; i < r->nb_count; i++) {
+			memcpy(r->nb[i].hash, mesh_disc[idx[i]].key, 2);
+			r->nb[i].snr4 = mesh_disc[idx[i]].their_snr4;
+		}
+		return;
+	}
+	/* passive: repeaters heard directly since this wake-up began (2-byte hashes only) */
+	uint8_t best[LT_REPORT_MAX_NB] = {0xFF, 0xFF};
+
+	for (uint8_t i = 0; i < mesh_nb_n; i++) {
+		if (mesh_nb[i].hash_size < 2) {
+			continue;
+		}
+		r->nb_total++;
+		for (uint8_t k = 0; k < LT_REPORT_MAX_NB; k++) {
+			if (best[k] == 0xFF || mesh_nb[i].snr_max > mesh_nb[best[k]].snr_max) {
+				for (uint8_t m = LT_REPORT_MAX_NB - 1; m > k; m--) {
+					best[m] = best[m - 1];
+				}
+				best[k] = i;
+				break;
+			}
+		}
+	}
+	for (uint8_t k = 0; k < LT_REPORT_MAX_NB && best[k] != 0xFF; k++) {
+		memcpy(r->nb[k].hash, mesh_nb[best[k]].hash, 2);
+		r->nb[k].snr4 = (int8_t)CLAMP(mesh_nb[best[k]].snr_max * 4, -128, 127);
+		r->nb_count++;
+	}
+}
+
+static void scan_end(void)
+{
+	if (mesh_scanning) {
+		mesh_scanning = false;
+		disc_tag = 0;
+		{
+			/* noise floor while still receiving: on USB next to a laptop it was ~30 dB
+			 * above thermal; measure it where the tracker really is */
+			int sum = 0, mx = -200;
+
+			for (int i = 0; i < 20; i++) {
+				int r = radio.getCurrentRSSI();
+
+				sum += r;
+				mx = MAX(mx, r);
+				k_msleep(25);
+			}
+			mesh_noise_avg = (int16_t)(sum / 20);
+			mesh_noise_max = (int16_t)mx;
+		}
+		if (phase == PH_SLEEP || phase == PH_WAIT_FIX) {
+			radio.sleepRadio();
+		}
+		if (!disc_quiet) {
+			mesh_scan_print();
+		}
+		disc_quiet = false;
+	}
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+	if (ble_scanning) {
+		ble_scan_print();
+	}
+#endif
+}
