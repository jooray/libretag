+static bool cli_nostr(int argc, char **argv, char *rest)
+{
+	const char *c = argv[0];
+
+	if (!strcmp(c, "nostr")) {
+		print_nostr();
+	} else if (!strcmp(c, "owner") && argc == 2) {
+		if (!strcmp(argv[1], "off")) {
+			cfg.has_owner = 0;
+		} else if (lt_parse_pubkey(argv[1], cfg.owner)) {
+			cfg.has_owner = 1;
+			cfg.last_dm_at = 0;
+		} else {
+			out("ERR need npub1... or 64 hex\r\n");
+			return true;
+		}
+		save_cfg();
+		print_nostr();
+	} else if (!strcmp(c, "public") && argc == 2) {
+		cfg.public_every = (uint8_t)CLAMP(atoi(argv[1]), 0, 255);
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "inbox") && argc == 2) {
+		cfg.inbox_every = (uint8_t)CLAMP(atoi(argv[1]), 0, 255);
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "dmalert") && argc == 2) {
+		cfg.dm_alerts = !strcmp(argv[1], "on");
+		save_cfg();
+		out("OK\r\n");
+	} else if (!strcmp(c, "dm") && rest && *rest) {
+		if (phase != PH_SLEEP) {
+			out("ERR busy (phase %d)\r\n", phase);
+			return true;
+		}
+		txq_reset();
+		if (!txq_add_dm(rest)) {
+			out("ERR no owner, no clock (needs one GNSS fix) or self-test failed\r\n");
+			return true;
+		}
+		k_timer_stop(&report_timer);
+		txq_route_all();
+		radio.recoverRxState();
+		try_tx();
+		out("OK sent, listening %u s for an answer\r\n", cfg.listen_s);
+	} else {
+		return false;
+	}
+	return true;
+}
