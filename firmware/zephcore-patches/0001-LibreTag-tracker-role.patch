--- /dev/null
+++ b/zephcore/boards/common/tracker.conf
@@ -0,0 +1,18 @@
+# LibreTag tracker role (see the LibreTag repo, PROTOCOL.md).
+# Build: west build -b wio_tracker_l1 zephcore -- -DEXTRA_CONF_FILE="boards/common/tracker.conf"
+CONFIG_ZEPHCORE_ROLE_TRACKER=y
+
+# BLE as an observer only (experiment: blescan lists devices around when there is no GPS).
+# No advertising, no connections: the tracker stays invisible on Bluetooth.
+CONFIG_BT=y
+CONFIG_BT_OBSERVER=y
+CONFIG_BT_BROADCASTER=n
+CONFIG_BT_PERIPHERAL=n
+CONFIG_BT_CENTRAL=n
+CONFIG_BT_SMP=n
+CONFIG_BT_SETTINGS=n
+CONFIG_ENTROPY_GENERATOR=y
+
+# The USB CDC port carries the text CLI; keep the console driver off it.
+CONFIG_UART_CONSOLE=n
+CONFIG_SHELL=n
diff --git a/zephcore/src/lt_platform_zephyr.c b/zephcore/src/lt_platform_zephyr.c
new file mode 100644
index 0000000..e5da116
--- /dev/null
+++ b/zephcore/src/lt_platform_zephyr.c
@@ -0,0 +1,93 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * LibreTag lt_core platform hooks over PSA Crypto (same backend as mesh::Utils).
+ */
+
+#include <psa/crypto.h>
+#include <string.h>
+
+#include "lt_core.h"
+
+void lt_sha256(const uint8_t *msg, size_t len, uint8_t out[32])
+{
+	size_t olen;
+
+	if (psa_hash_compute(PSA_ALG_SHA_256, msg, len, out, 32, &olen) != PSA_SUCCESS) {
+		memset(out, 0, 32);
+	}
+}
+
+/* HMAC-SHA256 over the hash primitive (keys here are at most 32 bytes). */
+void lt_hmac_sha256(const uint8_t *key, size_t key_len, const uint8_t *msg, size_t msg_len,
+		    uint8_t out[32])
+{
+	uint8_t k[64] = {0}, pad[64], inner[32];
+	psa_hash_operation_t op = PSA_HASH_OPERATION_INIT;
+	size_t olen;
+
+	if (key_len > 64) {
+		lt_sha256(key, key_len, k);
+	} else {
+		memcpy(k, key, key_len);
+	}
+
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x36;
+	}
+	psa_hash_setup(&op, PSA_ALG_SHA_256);
+	psa_hash_update(&op, pad, 64);
+	psa_hash_update(&op, msg, msg_len);
+	psa_hash_finish(&op, inner, 32, &olen);
+
+	for (int i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x5c;
+	}
+	op = (psa_hash_operation_t)PSA_HASH_OPERATION_INIT;
+	psa_hash_setup(&op, PSA_ALG_SHA_256);
+	psa_hash_update(&op, pad, 64);
+	psa_hash_update(&op, inner, 32);
+	psa_hash_finish(&op, out, 32, &olen);
+}
+
+static void aes_block_bits(const uint8_t *key, size_t bits, const uint8_t in[16], uint8_t out[16], bool enc)
+{
+	psa_key_attributes_t attr = PSA_KEY_ATTRIBUTES_INIT;
+	psa_key_id_t id;
+	size_t olen;
+
+	psa_set_key_type(&attr, PSA_KEY_TYPE_AES);
+	psa_set_key_bits(&attr, bits);
+	psa_set_key_usage_flags(&attr, enc ? PSA_KEY_USAGE_ENCRYPT : PSA_KEY_USAGE_DECRYPT);
+	psa_set_key_algorithm(&attr, PSA_ALG_ECB_NO_PADDING);
+	if (psa_import_key(&attr, key, bits / 8, &id) != PSA_SUCCESS) {
+		memset(out, 0, 16);
+		return;
+	}
+	if (enc) {
+		psa_cipher_encrypt(id, PSA_ALG_ECB_NO_PADDING, in, 16, out, 16, &olen);
+	} else {
+		psa_cipher_decrypt(id, PSA_ALG_ECB_NO_PADDING, in, 16, out, 16, &olen);
+	}
+	psa_destroy_key(id);
+}
+
+void lt_aes128_encrypt_block(const uint8_t key[16], const uint8_t in[16], uint8_t out[16])
+{
+	aes_block_bits(key, 128, in, out, true);
+}
+
+void lt_aes128_decrypt_block(const uint8_t key[16], const uint8_t in[16], uint8_t out[16])
+{
+	aes_block_bits(key, 128, in, out, false);
+}
+
+/* NIP-04 (lt_nostr) */
+void lt_aes256_encrypt_block(const uint8_t key[32], const uint8_t in[16], uint8_t out[16])
+{
+	aes_block_bits(key, 256, in, out, true);
+}
+
+void lt_aes256_decrypt_block(const uint8_t key[32], const uint8_t in[16], uint8_t out[16])
+{
+	aes_block_bits(key, 256, in, out, false);
+}
