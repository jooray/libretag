+TIMER(alive_tmr, EV_ALIVE);     /* 0.9.7: hourly "alive" record */
+
+/* 0.9.7: event log (STATE_DIR/ev0, ev1): state changes and an hourly record, for a tag that went
+ * silent (`events`). Types: */
+enum {
+	EVT_BOOT = 1,    /* a = LT_RST_* bits, x = RESETREAS */
+	EVT_ALIVE = 2,   /* hourly: a = listen windows without the home network, b = resets in a row,
+			  * c = energy mAh, x = seconds to the watchdog deadline */
+	EVT_QUIET = 3,   /* quiet began or its reason changed: a = reason, b = zone + 1 */
+	EVT_ACTIVE = 4,  /* quiet ended: a = the reason it had */
+	EVT_MODE = 5,    /* a = old mode, b = new */
+	EVT_NET = 6,     /* network switch: a = old country, b = new, x = new frequency in kHz */
+	EVT_STILL = 7,   /* parked condition met (a = wake-ups in a row at one place) */
+	EVT_MOVING = 8,  /* no longer at one place */
+	EVT_TXFAIL = 9,  /* the radio lost a packet of the queue: a = index, b = queue length */
+	EVT_TXFLOOR = 10, /* a = 1 below the transmit floor, 0 back above it */
+	EVT_CAP = 11,    /* a = 1 over the daily flood cap, 0 below again */
+	EVT_CLOCK = 12,  /* the clock became known in this run: x = unix time */
+	EVT_REBOOT = 13, /* console reboot (a = 0) or dfu (a = 1) */
+	EVT_BCON = 14,   /* a = 1 Bluetooth console window open, 0 closed */
+	EVT_CMD = 15,    /* a command taken: a = op, b = seq */
+	EVT_STALL = 16,  /* the main loop runs past its watchdog deadline: a reset follows (b = 1: wdtest) */
+};
+static void ev_log(uint8_t type, uint8_t a, uint8_t b, uint16_t c, uint32_t x);
+
+/* 0.9.7: what the main thread is doing, in the breadcrumb; restored when the scope ends */
