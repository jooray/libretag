diff --git a/zephcore/src/lt_diag.c b/zephcore/src/lt_diag.c
new file mode 100644
index 0000000..c9670d3
--- /dev/null
+++ b/zephcore/src/lt_diag.c
@@ -0,0 +1,212 @@
+/*
+ * SPDX-License-Identifier: MIT
+ * LibreTag 0.9.7: breadcrumb in RAM the boot keeps, and the watchdog. See lt_diag.h.
+ */
+
+#include "lt_diag.h"
+
+#include <zephyr/kernel.h>
+#include <zephyr/irq.h>
+#include <zephyr/logging/log.h>
+#include <string.h>
+
+#include <helpers/boot_info.h>
+
+#if defined(CONFIG_SOC_SERIES_NRF52)
+#include <hal/nrf_wdt.h>
+#define LT_HAS_WDT 1
+#else
+#define LT_HAS_WDT 0
+#endif
+
+LOG_MODULE_REGISTER(lt_diag, LOG_LEVEL_INF);
+
+#define CRUMB_MAGIC 0x4C544244u /* "LTBD" */
+
+static __noinit struct lt_crumb s_crumb;
+static struct lt_crumb s_prev;
+static bool s_prev_valid;
+static int64_t s_deadline_ms;
+static int s_wdt;
+
+static uint32_t crumb_check(const struct lt_crumb *c)
+{
+	const uint32_t *w = (const uint32_t *)c;
+	uint32_t sum = CRUMB_MAGIC;
+
+	for (size_t i = 0; i < offsetof(struct lt_crumb, check) / sizeof(uint32_t); i++) {
+		sum = (sum << 7 | sum >> 25) ^ w[i];
+		sum *= 0x9E3779B1u;
+	}
+	return sum;
+}
+
+/* callers hold the irq lock */
+static void crumb_seal(void)
+{
+	s_crumb.magic = CRUMB_MAGIC;
+	s_crumb.check = crumb_check(&s_crumb);
+}
+
+static void wdt_reload(void)
+{
+#if LT_HAS_WDT
+	/* every channel the WDT was started with (a previous run's too), as the bootloader does */
+	for (uint8_t i = 0; i < 8; i++) {
+		if (nrf_wdt_reload_request_enable_check(NRF_WDT, (nrf_wdt_rr_register_t)i)) {
+			nrf_wdt_reload_request_set(NRF_WDT, (nrf_wdt_rr_register_t)i);
+		}
+	}
+#endif
+}
+
+static void feed_fn(struct k_timer *t)
+{
+	ARG_UNUSED(t);
+	int64_t now = k_uptime_get();
+	unsigned int key = irq_lock();
+
+	s_crumb.up_s = (uint32_t)(now / 1000);
+	if (now < s_deadline_ms) {
+		wdt_reload();
+	} else {
+		s_crumb.flags |= LT_DF_STARVED;
+	}
+	crumb_seal();
+	irq_unlock(key);
+}
+
+K_TIMER_DEFINE(lt_feed_timer, feed_fn, NULL);
+
+void lt_diag_init(void)
+{
+	unsigned int key = irq_lock();
+
+	if (s_crumb.magic == CRUMB_MAGIC && s_crumb.check == crumb_check(&s_crumb)) {
+		s_prev = s_crumb;
+		s_prev_valid = true;
+	}
+	memset(&s_crumb, 0, sizeof(s_crumb));
+	s_crumb.phase = LT_PHASE_BOOT;
+	s_crumb.act = LT_ACT_INIT;
+	s_deadline_ms = k_uptime_get() + 600 * 1000;
+	crumb_seal();
+	irq_unlock(key);
+
+#if LT_HAS_WDT
+	if (nrf_wdt_started_check(NRF_WDT)) {
+		/* a soft reset (reboot, dfu, a fatal error) keeps the WDT running with the settings it
+		 * was started with; they cannot be changed until the next pin, power or WDT reset */
+		s_wdt = 2;
+		wdt_reload();
+	} else {
+		/* run while the CPU sleeps (a deadlock looks like sleep), pause under a debugger */
+		nrf_wdt_behaviour_set(NRF_WDT, NRF_WDT_BEHAVIOUR_RUN_SLEEP_MASK);
+		nrf_wdt_reload_value_set(NRF_WDT, (uint32_t)LT_WDT_TIMEOUT_S * 32768U);
+		nrf_wdt_reload_request_enable(NRF_WDT, NRF_WDT_RR0);
+		nrf_wdt_task_trigger(NRF_WDT, NRF_WDT_TASK_START);
+		s_wdt = 1;
+	}
+#endif
+	/* without a watchdog the timer only moves the breadcrumb's uptime: rarely, so an ESP32 in
+	 * light sleep is not woken every 30 s for it */
+	uint32_t period = LT_HAS_WDT ? LT_WDT_FEED_S : 600;
+
+	k_timer_start(&lt_feed_timer, K_SECONDS(period), K_SECONDS(period));
+	if (s_prev_valid) {
+		LOG_INF("previous run: up %u s, phase %u act %u, n %u", s_prev.up_s, s_prev.phase, s_prev.act,
+			s_prev.n);
+	} else {
+		LOG_INF("previous run: no breadcrumb");
+	}
+}
+
+bool lt_diag_prev(struct lt_crumb *out)
+{
+	if (!s_prev_valid) {
+		return false;
+	}
+	*out = s_prev;
+	return true;
+}
+
+void lt_diag_phase(uint8_t phase, uint32_t budget_s)
+{
+	int64_t now = k_uptime_get();
+	unsigned int key = irq_lock();
+
+	s_crumb.phase = phase;
+	s_crumb.phase_s = (uint32_t)(now / 1000);
+	s_crumb.up_s = s_crumb.phase_s;
+	s_crumb.flags &= (uint8_t)~LT_DF_STARVED;
+	s_deadline_ms = now + (int64_t)budget_s * 1000;
+	crumb_seal();
+	irq_unlock(key);
+}
+
+void lt_diag_deadline(uint32_t s)
+{
+	int64_t now = k_uptime_get();
+	unsigned int key = irq_lock();
+
+	s_deadline_ms = now + (int64_t)s * 1000;
+	s_crumb.flags &= (uint8_t)~LT_DF_STARVED;
+	crumb_seal();
+	irq_unlock(key);
+}
+
+int32_t lt_diag_deadline_left_s(void)
+{
+	int64_t left = s_deadline_ms - k_uptime_get();
+
+	return (int32_t)(left / 1000);
+}
+
+uint8_t lt_diag_act(uint8_t act)
+{
+	unsigned int key = irq_lock();
+	uint8_t was = s_crumb.act;
+
+	s_crumb.act = act;
+	s_crumb.up_s = (uint32_t)(k_uptime_get() / 1000);
+	crumb_seal();
+	irq_unlock(key);
+	return was;
+}
+
+void lt_diag_state(uint32_t n, uint8_t mode, uint8_t quiet, uint8_t flags, uint16_t batt_mv, uint32_t unix_s,
+		   uint32_t ev)
+{
+	uint32_t now_s = (uint32_t)(k_uptime_get() / 1000);
+	unsigned int key = irq_lock();
+
+	s_crumb.n = n;
+	s_crumb.mode = mode;
+	s_crumb.quiet = quiet;
+	s_crumb.flags = (uint8_t)((flags & (uint8_t)~LT_DF_STARVED) | (s_crumb.flags & LT_DF_STARVED));
+	s_crumb.batt_mv = batt_mv;
+	s_crumb.unix_s = unix_s;
+	s_crumb.ev = ev;
+	s_crumb.loop_s = now_s;
+	s_crumb.up_s = now_s;
+	crumb_seal();
+	irq_unlock(key);
+}
+
+void lt_diag_now(struct lt_crumb *out)
+{
+	unsigned int key = irq_lock();
+
+	*out = s_crumb;
+	irq_unlock(key);
+}
+
+int lt_diag_wdt(void)
+{
+	return s_wdt;
+}
+
+uint32_t lt_diag_resetreas(void)
+{
+	return zephcore_boot_reset_raw();
+}
diff --git a/zephcore/src/lt_diag.h b/zephcore/src/lt_diag.h
new file mode 100644
index 0000000..0ad481d
--- /dev/null
+++ b/zephcore/src/lt_diag.h
@@ -0,0 +1,113 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * LibreTag 0.9.7: what the tracker was doing when a run ended, and a hardware watchdog.
+ *
+ * Breadcrumb: a small record in RAM that the boot does not clear (survives a pin, soft, watchdog
+ * or lockup reset, not a power loss), with a magic and a checksum. The main loop writes its phase,
+ * what it is busy with, n, mode, quiet, battery and the clock into it; a 30 s timer writes the
+ * uptime. The next boot reads it (lt_diag_prev) into its boot record.
+ *
+ * Watchdog (nRF52 only): the nRF WDT with LT_WDT_TIMEOUT_S, running while the CPU sleeps. A timer
+ * reloads it every LT_WDT_FEED_S, but only until the deadline the main loop last set
+ * (lt_diag_deadline). The main loop moves the deadline when its phase changes, and while asleep
+ * to the end of the planned sleep, never on every event: a loop that keeps handling events but
+ * sits in one phase (a transmission that never finishes, say) runs into the deadline as well as a
+ * thread that blocks. Past the deadline nothing reloads the WDT and it resets the SoC: RESETREAS
+ * DOG, and the breadcrumb says where.
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define LT_WDT_TIMEOUT_S 240
+#define LT_WDT_FEED_S    30
+
+/* what the main thread is busy with (act) */
+enum {
+	LT_ACT_INIT = 0,  /* main() before the loop */
+	LT_ACT_WAIT = 1,  /* idle in k_event_wait */
+	LT_ACT_EVENT = 2, /* handling the events of one loop pass */
+	LT_ACT_CLI = 3,   /* a console command (USB or Bluetooth) */
+	LT_ACT_FLASH = 4, /* writing the state, history or diagnostics */
+	LT_ACT_RX = 5,    /* a LoRa packet */
+	LT_ACT_BLECON = 6,
+	LT_ACT_GPS = 7,   /* the GPS driver's event */
+	LT_ACT_DFU = 8,   /* going to the bootloader */
+	LT_ACT_REBOOT = 9,
+	LT_ACT_COUNT
+};
+
+/* flags in the breadcrumb and the event log */
+enum {
+	LT_DF_GPS_ON = 1,     /* GPS acquiring */
+	LT_DF_RX = 2,         /* LoRa receiver on */
+	LT_DF_TX = 4,         /* LoRa transmission in flight */
+	LT_DF_BLE = 8,        /* Bluetooth scan running */
+	LT_DF_USB = 16,       /* external (USB) power */
+	LT_DF_BCON = 32,      /* Bluetooth console window open */
+	LT_DF_STARVED = 64,   /* the deadline passed: the watchdog is no longer reloaded */
+	LT_DF_TXINH = 128,    /* below the transmit floor */
+};
+
+#define LT_PHASE_BOOT 0xF0 /* before the main loop's first phase */
+
+struct lt_crumb {
+	uint32_t magic;
+	uint32_t up_s;     /* uptime at the last write (the 30 s timer or the main loop) */
+	uint32_t loop_s;   /* uptime of the main loop's last pass */
+	uint32_t phase_s;  /* uptime when the phase began */
+	uint32_t unix_s;   /* wall clock at the last main loop write, 0 = unknown */
+	uint32_t n;
+	uint32_t ev;       /* events of the last loop pass */
+	uint16_t batt_mv;
+	uint8_t phase;     /* the tracker's enum phase, or LT_PHASE_BOOT */
+	uint8_t act;       /* LT_ACT_* */
+	uint8_t mode;
+	uint8_t quiet;     /* 0, or the quiet reason + 1 */
+	uint8_t flags;     /* LT_DF_* */
+	uint8_t rsv;
+	uint32_t check;
+};
+
+/* Takes the previous run's breadcrumb (valid or not), starts a new one and the watchdog. Call once,
+ * early in main(). */
+void lt_diag_init(void);
+
+/* The previous run's breadcrumb; false if there was none (power loss, first boot, damaged). */
+bool lt_diag_prev(struct lt_crumb *out);
+
+/* A new phase: sets phase_s and the deadline to now + budget_s. */
+void lt_diag_phase(uint8_t phase, uint32_t budget_s);
+
+/* Moves the deadline to now + s, without a new phase (the sleep's planned end). */
+void lt_diag_deadline(uint32_t s);
+
+/* Seconds until the deadline (negative: past it). */
+int32_t lt_diag_deadline_left_s(void);
+
+/* What the main thread does now; returns the previous value, for lt_diag_act() after it. */
+uint8_t lt_diag_act(uint8_t act);
+
+/* The rest of the breadcrumb, from the main loop; also sets loop_s. */
+void lt_diag_state(uint32_t n, uint8_t mode, uint8_t quiet, uint8_t flags, uint16_t batt_mv, uint32_t unix_s,
+		   uint32_t ev);
+
+/* A copy of the current breadcrumb. */
+void lt_diag_now(struct lt_crumb *out);
+
+/* Watchdog: 1 running (started by this run), 2 running (left on by the previous run, a soft reset
+ * keeps it), 0 none on this SoC. */
+int lt_diag_wdt(void);
+
+/* Raw reset register as read at boot (nRF52 RESETREAS, ESP32 esp_reset_reason()); see boot_info. */
+uint32_t lt_diag_resetreas(void);
+
+#ifdef __cplusplus
+}
+#endif
