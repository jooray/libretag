+/* ------------------------------------------------------------------ diagnostics (0.9.7)
+ * Boot records (STATE_DIR/boot0, boot1) and the event log (ev0, ev1): two append-only segments
+ * each, like the history; the older segment is dropped when the current one is full. A boot
+ * record keeps the raw reset register and the previous run's breadcrumb (lt_diag.h); the event
+ * log keeps state changes and an hourly record. Neither holds a position. */
+#define BOOT_SEG_RECS 16 /* the newest 16..32 boots */
+#define EV_SEG_RECS 128  /* the newest 128..256 events: at one an hour plus changes, about a week */
+#define BOOT_MAGIC 0xB7
+#define EVREC_MAGIC 0xE7
+/* phase budgets for the watchdog deadline (lt_diag.h): the longest legitimate wake-up phase is a
+ * GPS search of up to 600 s (fixto) plus a LOST scan or discover; a sleep ends when report_timer
+ * fires, so its deadline is that time plus a margin */
+#define PHASE_BUDGET_S 1200
+#define SLEEP_SLACK_S 600
+#define ALIVE_S 3600
+
+struct bootrec {
+	uint8_t magic;
+	uint8_t rst;        /* LT_RST_* bits of this boot */
+	uint8_t resets;     /* resets in a row after this boot */
+	uint8_t deliberate; /* the previous run announced it (reboot, dfu) */
+	uint32_t seq;
+	uint32_t resetreas; /* raw register (nRF52 RESETREAS) */
+	uint32_t n;         /* n at boot */
+	uint32_t unix_s;    /* estimate of the boot time from the breadcrumb's clock, 0 = unknown */
+	uint16_t batt_mv;
+	uint8_t crumb;      /* 1: the previous run left a breadcrumb (below) */
+	uint8_t crash;      /* 1: the previous run ended in a fatal error (below) */
+	/* previous run, from its breadcrumb */
+	uint32_t p_up_s, p_loop_s, p_phase_s, p_unix_s, p_n, p_ev;
+	uint16_t p_batt_mv;
+	uint8_t p_phase, p_act, p_mode, p_quiet, p_flags;
+	uint8_t wdt;        /* lt_diag_wdt() of this boot */
+	/* the fatal error the previous run recorded (helpers/fatal_reboot.c) */
+	uint32_t c_reason, c_pc, c_lr;
+	char c_thread[12];
+} __packed;
+BUILD_ASSERT(sizeof(struct bootrec) == 80, "bootrec size");
+
+struct evrec {
+	uint8_t magic;
+	uint8_t type;   /* EVT_* */
+	uint8_t phase;
+	uint8_t mode;
+	uint32_t seq;
+	uint32_t up_s;
+	uint32_t unix_s; /* 0 = clock unknown */
+	uint32_t n;
+	uint16_t batt_mv;
+	uint8_t flags;   /* LT_DF_* */
+	uint8_t quiet;   /* quiet reason + 1, 0 = not quiet */
+	uint8_t a, b;
+	uint16_t c;
+	uint32_t x;
+} __packed;
+BUILD_ASSERT(sizeof(struct evrec) == 32, "evrec size");
+
+struct ring {
+	const char *fmt;
+	uint16_t rec_size;
+	uint16_t seg_recs;
+	uint8_t seg;
+	uint16_t count;
+	uint32_t seq;
+	bool ready;
+};
+static struct ring boot_ring = {STATE_DIR "/boot%u", sizeof(struct bootrec), BOOT_SEG_RECS, 0, 0, 0, false};
+static struct ring ev_ring = {STATE_DIR "/ev%u", sizeof(struct evrec), EV_SEG_RECS, 0, 0, 0, false};
+
+/* every record type here starts with magic, three bytes, then u32 seq */
+static void ring_init(struct ring *r)
+{
+	struct fs_dirent st;
+	char name[40];
+	size_t sz[2] = {0, 0};
+	uint8_t buf[sizeof(struct bootrec)];
+
+	for (unsigned i = 0; i < 2; i++) {
+		snprintf(name, sizeof(name), r->fmt, i);
+		if (fs_stat(name, &st) == 0) {
+			sz[i] = st.size / r->rec_size;
+		}
+	}
+	r->seg = (sz[0] >= r->seg_recs && sz[1] < r->seg_recs) ? 1 : 0;
+	if (sz[0] >= r->seg_recs && sz[1] >= r->seg_recs) {
+		r->seg = 0;
+		snprintf(name, sizeof(name), r->fmt, 0);
+		fs_unlink(name);
+		sz[0] = 0;
+	}
+	r->count = (uint16_t)MIN(sz[r->seg], (size_t)r->seg_recs);
+	r->seq = 0;
+	for (unsigned i = 0; i < 2; i++) {
+		struct fs_file_t f;
+
+		snprintf(name, sizeof(name), r->fmt, i);
+		fs_file_t_init(&f);
+		if (fs_open(&f, name, FS_O_READ) < 0) {
+			continue;
+		}
+		while (fs_read(&f, buf, r->rec_size) == (ssize_t)r->rec_size) {
+			uint32_t q = sys_get_le32(buf + 4);
+
+			r->seq = MAX(r->seq, q + 1);
+		}
+		fs_close(&f);
+	}
+	r->ready = true;
+}
+
+static void ring_append(struct ring *r, void *rec)
+{
+	diag_act da(LT_ACT_FLASH);
+	struct fs_file_t f;
+	char name[40];
+
+	if (!r->ready) {
+		return;
+	}
+	if (r->count >= r->seg_recs) {
+		r->seg ^= 1;
+		r->count = 0;
+		snprintf(name, sizeof(name), r->fmt, r->seg);
+		fs_unlink(name);
+	}
+	snprintf(name, sizeof(name), r->fmt, r->seg);
+	fs_file_t_init(&f);
+	if (fs_open(&f, name, FS_O_CREATE | FS_O_WRITE | FS_O_APPEND) < 0) {
+		return;
+	}
+	sys_put_le32(r->seq, (uint8_t *)rec + 4);
+	if (fs_write(&f, rec, r->rec_size) == (ssize_t)r->rec_size) {
+		r->count++;
+		r->seq++;
+	}
+	fs_close(&f);
+}
+
+/* records oldest first; fn gets each one with the expected magic */
+static void ring_each(struct ring *r, uint8_t magic, void (*fn)(const void *))
+{
+	unsigned order[2] = {(unsigned)(r->seg ^ 1), r->seg};
+	uint8_t buf[sizeof(struct bootrec)];
+
+	for (unsigned k = 0; k < 2; k++) {
+		struct fs_file_t f;
+		char name[40];
+
+		snprintf(name, sizeof(name), r->fmt, order[k]);
+		fs_file_t_init(&f);
+		if (fs_open(&f, name, FS_O_READ) < 0) {
+			continue;
+		}
+		while (fs_read(&f, buf, r->rec_size) == (ssize_t)r->rec_size) {
+			if (buf[0] == magic) {
+				fn(buf);
+			}
+		}
+		fs_close(&f);
+	}
+}
+
+static const char *phase_name(uint8_t p)
+{
+	static const char *const names[] = {"sleep", "gps", "tx", "listen", "blescan", "check"};
+
+	if (p == LT_PHASE_BOOT) {
+		return "boot";
+	}
+	return p < ARRAY_SIZE(names) ? names[p] : "?";
+}
+
+static const char *act_name(uint8_t a)
+{
+	static const char *const names[] = {"init", "wait", "event", "cli", "flash", "rx", "blecon", "gps", "dfu",
+					    "reboot"};
+
+	return a < ARRAY_SIZE(names) ? names[a] : "?";
+}
+
+static const char *rst_word(uint8_t rst)
+{
+	static const char *const names[] = {"pin", "power", "soft", "debug", "brownout", "watchdog", "crash"};
+	uint8_t c = lt_boot_cause(rst);
+
+	return c ? names[c - 1] : "none";
+}
+
+/* nRF52840 RESETREAS bits as words; the raw value is printed next to them */
+static void resetreas_words(uint32_t r, char *b, size_t n)
+{
+#if defined(CONFIG_SOC_SERIES_NRF52)
+	static const struct {
+		uint32_t bit;
+		const char *w;
+	} t[] = {{BIT(0), "RESETPIN"}, {BIT(1), "DOG"},   {BIT(2), "SREQ"}, {BIT(3), "LOCKUP"}, {BIT(16), "OFF"},
+		 {BIT(17), "LPCOMP"},  {BIT(18), "DIF"},  {BIT(19), "NFC"},  {BIT(20), "VBUS"}};
+	size_t l = 0;
+
+	b[0] = 0;
+	for (size_t i = 0; i < ARRAY_SIZE(t) && l + 10 < n; i++) {
+		if (r & t[i].bit) {
+			l += (size_t)snprintf(b + l, n - l, "%s%s", l ? "+" : "", t[i].w);
+		}
+	}
+	if (!l) {
+		snprintf(b, n, "%s", r ? "other" : "none(power-on/brownout)");
+	}
+#else
+	snprintf(b, n, "esp%u", (unsigned)r);
+#endif
+}
+
+static uint8_t diag_quiet(void)
+{
+	return wake_st.quiet ? (uint8_t)(wake_st.reason + 1) : 0;
+}
+
+static uint8_t diag_flags(void)
+{
+	struct gps_state_info gi;
+	uint8_t f = 0;
+
+	gps_get_state_info(&gi);
+	if (gi.state == 2) {
+		f |= LT_DF_GPS_ON;
+	}
+	if (radio.isTxActive()) {
+		f |= LT_DF_TX;
+	} else if (radio.isInRecvMode()) {
+		f |= LT_DF_RX;
+	}
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+	if (ble_scanning) {
+		f |= LT_DF_BLE;
+	}
+#endif
+#if BCON
+	if (bcon_on) {
+		f |= LT_DF_BCON;
+	}
+#endif
+	if (board.isExternalPowered()) {
+		f |= LT_DF_USB;
+	}
+	if (tx_inhibited) {
+		f |= LT_DF_TXINH;
+	}
+	return f;
+}
+
+static void ev_log(uint8_t type, uint8_t a, uint8_t b, uint16_t c, uint32_t x)
+{
+	struct evrec e = {};
+
+	e.magic = EVREC_MAGIC;
+	e.type = type;
+	e.phase = (uint8_t)phase;
+	e.mode = (uint8_t)mode;
+	e.up_s = (uint32_t)(k_uptime_get() / 1000);
+	e.unix_s = now_unix();
+	e.n = n_cur;
+	e.batt_mv = board.getBattMilliVolts();
+	e.flags = diag_flags();
+	e.quiet = diag_quiet();
+	e.a = a;
+	e.b = b;
+	e.c = c;
+	e.x = x;
+	ring_append(&ev_ring, &e);
+}
+
+/* the boot record: once, after the file system and the state are loaded */
+static void boot_record(void)
+{
+	struct bootrec r = {};
+	struct lt_crumb p;
+	struct zephcore_crash cr;
+
+	ring_init(&boot_ring);
+	ring_init(&ev_ring);
+	r.magic = BOOT_MAGIC;
+	r.rst = boot_rst;
+	r.resets = cfg.boot_resets;
+	r.deliberate = boot_was_deliberate;
+	r.resetreas = lt_diag_resetreas();
+	r.n = n_cur;
+	r.batt_mv = board.getBattMilliVolts();
+	r.wdt = (uint8_t)lt_diag_wdt();
+	if (lt_diag_prev(&p)) {
+		r.crumb = 1;
+		r.p_up_s = p.up_s;
+		r.p_loop_s = p.loop_s;
+		r.p_phase_s = p.phase_s;
+		r.p_unix_s = p.unix_s;
+		r.p_n = p.n;
+		r.p_ev = p.ev;
+		r.p_batt_mv = p.batt_mv;
+		r.p_phase = p.phase;
+		r.p_act = p.act;
+		r.p_mode = p.mode;
+		r.p_quiet = p.quiet;
+		r.p_flags = p.flags;
+		/* the clock at the last breadcrumb, moved on to the last uptime the timer wrote */
+		r.unix_s = p.unix_s ? p.unix_s + (p.up_s - MIN(p.loop_s, p.up_s)) : 0;
+	}
+	if (zephcore_boot_crash(&cr)) {
+		r.crash = 1;
+		r.c_reason = cr.reason;
+		r.c_pc = cr.pc;
+		r.c_lr = cr.lr;
+		strncpy(r.c_thread, cr.thread, sizeof(r.c_thread) - 1);
+	}
+	ring_append(&boot_ring, &r);
+	ev_log(EVT_BOOT, boot_rst, r.crumb ? r.p_phase : 0xFF, 0, r.resetreas);
+	LOG_INF("boot record %u: reset %s RESETREAS 0x%08x, previous run %s up %u s phase %s act %s",
+		(unsigned)(boot_ring.seq - 1), rst_word(boot_rst), (unsigned)r.resetreas, r.crumb ? "" : "(no breadcrumb)",
+		(unsigned)r.p_up_s, r.crumb ? phase_name(r.p_phase) : "-", r.crumb ? act_name(r.p_act) : "-");
+}
+
+/* what the event log follows from one loop pass to the next */
+static struct {
+	bool init;
+	uint8_t phase;
+	uint8_t mode;
+	uint8_t quiet;
+	int8_t zone;
+	bool still;
+	bool txinh;
+	bool cap;
+	bool clock;
+	bool stall;
+	uint8_t country;
+	float freq;
+#if BCON
+	bool bcon;
+#endif
+} dw;
+
+/* end of every main loop pass: breadcrumb, watchdog deadline, state changes for the event log */
+static void diag_pass(uint32_t ev)
+{
+	uint8_t q = diag_quiet();
+	bool still = cfg.still_after && wake_st.still_count >= cfg.still_after;
+	bool cap = over_cap();
+
+	if (!dw.init) {
+		dw.init = true;
+		dw.phase = LT_PHASE_BOOT;
+		dw.mode = (uint8_t)mode;
+		dw.quiet = q;
+		dw.zone = wake_st.zone;
+		dw.still = still;
+		dw.txinh = tx_inhibited;
+		dw.cap = cap;
+		dw.country = cfg.country;
+		dw.freq = cfg.freq;
+	}
+	if ((uint8_t)phase != dw.phase) {
+		dw.phase = (uint8_t)phase;
+		dw.stall = false;
+		lt_diag_phase((uint8_t)phase, phase == PH_SLEEP ? SLEEP_SLACK_S : PHASE_BUDGET_S);
+	}
+	if (phase == PH_SLEEP) {
+		/* asleep until report_timer fires: the deadline follows it (a sleep without it never ends,
+		 * and then the watchdog does it) */
+		uint32_t rem = k_timer_remaining_get(&report_timer);
+
+		if (rem) {
+			lt_diag_deadline(rem / 1000 + SLEEP_SLACK_S);
+		}
+	}
+	if (lt_diag_deadline_left_s() < 0 && !dw.stall) {
+		dw.stall = true;
+		LOG_ERR("phase %s past its watchdog deadline", phase_name((uint8_t)phase));
+		ev_log(EVT_STALL, (uint8_t)phase, 0, 0, (uint32_t)(-lt_diag_deadline_left_s()));
+	}
+	if ((uint8_t)mode != dw.mode) {
+		ev_log(EVT_MODE, dw.mode, (uint8_t)mode, 0, 0);
+		dw.mode = (uint8_t)mode;
+	}
+	if (q != dw.quiet || (q && wake_st.zone != dw.zone)) {
+		if (q) {
+			ev_log(EVT_QUIET, wake_st.reason, (uint8_t)(wake_st.zone + 1), 0, 0);
+		} else {
+			ev_log(EVT_ACTIVE, dw.quiet ? (uint8_t)(dw.quiet - 1) : 0, 0, 0, 0);
+		}
+		dw.quiet = q;
+		dw.zone = wake_st.zone;
+	}
+	if (still != dw.still) {
+		ev_log(still ? EVT_STILL : EVT_MOVING, wake_st.still_count, 0, 0, 0);
+		dw.still = still;
+	}
+	if (tx_inhibited != dw.txinh) {
+		ev_log(EVT_TXFLOOR, tx_inhibited, 0, 0, 0);
+		dw.txinh = tx_inhibited;
+	}
+	if (cap != dw.cap) {
+		ev_log(EVT_CAP, cap, 0, 0, floods_24h());
+		dw.cap = cap;
+	}
+	if (cfg.country != dw.country || cfg.freq != dw.freq) {
+		ev_log(EVT_NET, dw.country, cfg.country, 0, (uint32_t)lroundf(cfg.freq * 1000.0f));
+		dw.country = cfg.country;
+		dw.freq = cfg.freq;
+	}
+	if (!dw.clock && clock_unix) {
+		dw.clock = true;
+		ev_log(EVT_CLOCK, 0, 0, 0, now_unix());
+	}
+#if BCON
+	if (bcon_on != dw.bcon) {
+		ev_log(EVT_BCON, bcon_on, 0, 0, 0);
+		dw.bcon = bcon_on;
+	}
+#endif
+	if (ev & EV_ALIVE) {
+		ev_log(EVT_ALIVE, home_silent, cfg.boot_resets, (uint16_t)MIN(cfg.energy_uah / 1000, 65535U),
+		       (uint32_t)lt_diag_deadline_left_s());
+	}
+	lt_diag_state(n_cur, (uint8_t)mode, q, diag_flags(), board.getBattMilliVolts(), now_unix(), ev);
+}
+
+static void print_boot(const struct bootrec *r)
+{
+	char w[48];
+
+	resetreas_words(r->resetreas, w, sizeof(w));
+	out("B %u reset=%s resetreas=0x%08x(%s) n=%u batt=%umV resets=%u%s wdt=%u t=%u\r\n", (unsigned)r->seq,
+	    rst_word(r->rst), (unsigned)r->resetreas, w, (unsigned)r->n, r->batt_mv, r->resets,
+	    r->deliberate ? " announced" : "", r->wdt, (unsigned)r->unix_s);
+	if (r->crumb) {
+		out("  before: up=%us loop=%us phase=%s since=%us act=%s n=%u mode=%u quiet=%u flags=0x%02x ev=0x%x "
+		    "batt=%umV t=%u\r\n",
+		    (unsigned)r->p_up_s, (unsigned)r->p_loop_s, phase_name(r->p_phase), (unsigned)r->p_phase_s,
+		    act_name(r->p_act), (unsigned)r->p_n, r->p_mode, r->p_quiet, r->p_flags, (unsigned)r->p_ev,
+		    r->p_batt_mv, (unsigned)r->p_unix_s);
+	} else {
+		out("  before: no breadcrumb (power loss, or a run before 0.9.7)\r\n");
+	}
+	if (r->crash) {
+		out("  crash: reason=%u pc=0x%08x lr=0x%08x thread=%.12s\r\n", (unsigned)r->c_reason, (unsigned)r->c_pc,
+		    (unsigned)r->c_lr, r->c_thread);
+	}
+}
+
+static const char *evt_name(uint8_t t)
+{
+	static const char *const names[] = {"?",      "boot",   "alive", "quiet",  "active", "mode",
+					    "net",    "still",  "moving", "txfail", "txfloor", "cap",
+					    "clock",  "reboot", "blecon", "cmd",    "stall"};
+
+	return t < ARRAY_SIZE(names) ? names[t] : "?";
+}
+
+static void print_ev(const struct evrec *e)
+{
+	out("E %u %s up=%u t=%u n=%u phase=%s mode=%u quiet=%u batt=%umV flags=0x%02x a=%u b=%u c=%u x=%u\r\n",
+	    (unsigned)e->seq, evt_name(e->type), (unsigned)e->up_s, (unsigned)e->unix_s, (unsigned)e->n,
+	    phase_name(e->phase), e->mode, e->quiet, e->batt_mv, e->flags, e->a, e->b, e->c, (unsigned)e->x);
+}
+
+static void print_diag_status(void)
+{
+	struct lt_crumb now, p;
+	struct zephcore_crash cr;
+	char w[48];
+
+	lt_diag_now(&now);
+	resetreas_words(lt_diag_resetreas(), w, sizeof(w));
+	out("reset %s resetreas=0x%08x(%s)%s\r\n", boot_rst_name(), (unsigned)lt_diag_resetreas(), w,
+	    boot_was_deliberate ? ", announced by the previous run" : "");
+	if (zephcore_boot_crash(&cr)) {
+		out("previous run crashed: reason %u pc 0x%08x lr 0x%08x thread %s\r\n", (unsigned)cr.reason,
+		    (unsigned)cr.pc, (unsigned)cr.lr, cr.thread[0] ? cr.thread : "?");
+	}
+	if (lt_diag_prev(&p)) {
+		out("previous run: up %u s, phase %s since %u s, act %s, n=%u, batt %u mV, flags 0x%02x\r\n",
+		    (unsigned)p.up_s, phase_name(p.phase), (unsigned)p.phase_s, act_name(p.act), (unsigned)p.n,
+		    p.batt_mv, p.flags);
+	} else {
+		out("previous run: no breadcrumb (power loss, or before 0.9.7)\r\n");
+	}
+	if (lt_diag_wdt()) {
