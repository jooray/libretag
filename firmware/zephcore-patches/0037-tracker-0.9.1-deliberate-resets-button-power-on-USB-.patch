 	    (unsigned)floods_24h(), (unsigned)LT_FLOOD_CAP_24H, over_cap() ? "yes" : "no",
 	    (cfg.low_flags & LT_LOW_REPORTED) ? ((cfg.low_flags & LT_LOW_DM) ? "sent" : "reported") : "armed",
-	    cfg.boot_resets, (unsigned)lt_boot_delay_s(cfg.boot_resets), (unsigned)LT_TX_MIN_MV,
+	    cfg.boot_resets, boot_rst_name(), (unsigned)lt_boot_delay_s(cfg.boot_resets), (unsigned)LT_TX_MIN_MV,
