 	    mode == LT_MODE_LOST ? (lt_lost_interval_s(&lost_st, 1, lost_elapsed_s()) > 1 ? " lost=slow" : " lost=fast")
 				 : "");
@@ -5928,8 +5982,8 @@ int main(void)
 	 * a row later and later, up to an hour (lt_boot_delay_s) */
 	uint32_t boot_delay = lt_boot_delay_s(cfg.boot_resets);
 
-	LOG_INF("LibreTag tracker up, n=%u, resets in a row %u, first report in %u s", n_cur, cfg.boot_resets,
