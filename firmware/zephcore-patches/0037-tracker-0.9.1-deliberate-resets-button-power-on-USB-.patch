 #include <hal/nrf_power.h>
 #endif
@@ -875,6 +877,57 @@ static int state_read(const char *path, struct persisted *p)
 static int64_t lost_since_ms;      /* 0.7.6: LOST began (or resumed after a boot) */
 static lt_lost_state_t lost_st;    /* 0.7.6: LOST slow-down while the fixes stay in one place */
 
+/* 0.9.1: this boot's reset cause as LT_RST_* bits (helpers/boot_info: RESETREAS on the nRF52, the
+ * ROM reset reason on the ESP32; a fatal error the last run recorded counts as a crash) */
+static uint8_t boot_rst;
+
+static uint8_t boot_reset_bits(void)
+{
+	uint32_t c = 0;
+	uint8_t r = 0;
+	struct zephcore_crash crash;
+
+	(void)zephcore_boot_reset_cause(&c);
+	if (c & RESET_PIN) {
+		r |= LT_RST_PIN;
+	}
+	if (c & RESET_POR) {
+		r |= LT_RST_POWER_ON;
+	}
+	if (c & RESET_SOFTWARE) {
+		r |= LT_RST_SOFT;
+	}
+	if (c & RESET_DEBUG) {
+		r |= LT_RST_DEBUG;
+	}
+	if (c & RESET_BROWNOUT) {
+		r |= LT_RST_BROWNOUT;
+	}
+	if (c & RESET_WATCHDOG) {
+		r |= LT_RST_WATCHDOG;
+	}
+	if ((c & (RESET_CPU_LOCKUP | RESET_PARITY | RESET_PLL | RESET_CLOCK | RESET_TEMPERATURE | RESET_HARDWARE)) ||
+	    zephcore_boot_crash(&crash)) {
+		r |= LT_RST_CRASH;
+	}
+	return r;
+}
+
+static const char *boot_rst_name(void)
+{
+	static const char *const names[] = {"pin", "power", "soft", "debug", "brownout", "watchdog", "crash"};
+
+	/* the bit that decided: faults first, then the deliberate ones */
+	static const uint8_t order[] = {6, 5, 4, 0, 3, 1, 2};
+
+	for (size_t i = 0; i < ARRAY_SIZE(order); i++) {
+		if (boot_rst & (1U << order[i])) {
+			return names[order[i]];
+		}
+	}
+	return "none";
+}
+
 static void load_cfg(void)
 {
 	static struct persisted tmp;
@@ -915,13 +968,14 @@ static void load_cfg(void)
 		lost_since_ms = k_uptime_get(); /* not kept: the first 2 h of LOST start again */
 		LOG_INF("resuming mode %d for %u min", mode, cfg.mode_left_min);
 	}
-	/* 0.7.6: resets in a row; a console reboot or dfu does not count */
-	if (cfg.boot_deliberate) {
-		cfg.boot_resets = 1;
-		cfg.boot_deliberate = 0;
-	} else {
-		cfg.boot_resets = (uint8_t)MIN(cfg.boot_resets + 1, 250);
-	}
+	/* 0.7.6: resets in a row; a console reboot or dfu does not count. 0.9.1: nor does a reset the
+	 * owner made (button, power, the USB-serial chip's reset, flashing): only brown-outs, watchdogs,
+	 * crashes and unannounced software resets make a loop (lt_reset_deliberate) */
+	boot_rst = boot_reset_bits();
+	cfg.boot_resets = lt_boot_resets_next(cfg.boot_resets, cfg.boot_deliberate,
+					      lt_reset_deliberate(boot_rst, board.getBattMilliVolts(),
+								  board.isExternalPowered()));
+	cfg.boot_deliberate = 0;
 
 	struct keyrec a, b;
 	bool ka = false, kb = false;
@@ -4688,10 +4742,10 @@ static void print_status(void)
