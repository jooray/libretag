+/* ---- 0.10.0: field-log records per wake-up (docs/design/quiet-mesh.md, "Tag field log") ----
+ * Three records at the end of every wake-up that sent a report (FL_SUM1..3, the same n), and one
+ * per slot window (FL_CHK), so a trip shows the tag was listening when a command missed:
+ * FL_SUM1 16 u32 n, 20 why (LT_WHY_*), 21 link before | link after << 4, 22 flood level (FF none),
+ *         23 flags (1 fix, 2 ACKed, 4 routed ACK, 8 early sleep, 16 SYNC sent, 32 quick answer,
+ *         64 parked flood, 128 budget used up), 24 u16 search s, 26 hacc m, 27 copies,
+ *         28 4 x (j, u16 ms after the first copy), 40 u32 fix time (0 none), 44 u16 moved m,
+ *         46 floods_24h, 47 IDLE budget left
+ * FL_SUM2 16 u32 n, 20 u16 ms to the first repeat of a flood copy (FFFF none), 22 3 B its repeater
+ *         hash, 25 ACK k (FF none), 26 u16 ACK ms after the first copy (FFFF none), 28 i8 ACK SNR x4,
+ *         29 command op (0 none), 30 seq, 31 command flags (1 taken, 2 repeat, 4 direct, 8 data type
+ *         0xFF6C, 16 Bluetooth), 32 u16 command k, 34 u16 command ms after its window opened,
+ *         36 u32 anchor n, 40 prev slots left, 41 next_in byte, 42 u16 listen ms, 44 u16 slot k,
+ *         46 events (LT_EV_*), 47 stalls in this wake-up
+ * FL_SUM3 16 u32 n, 20 path entries | hash size << 4, 21 6 B path, 27 battery %, 28 u32 path age s
+ *         (FFFFFFFF none), 32 u16 mV, 34 u16 energy mAh, 36 boot cause, 37 boot resets, 38 TX
+ *         failures in this wake-up, 40 u32 next_in s
+ * FL_CHK  16 u32 n_report, 20 u16 slot k, 22 flags (1 anchor's grid, 2 previous grid, 4 ACK, 8
+ *         command, 16 pending, 32 discover, 64 listen only), 23 prev slots left, 24 u32 anchor n,
+ *         28 u32 receiver ms, 32 i32 ms the receiver opened before t_k, 36 u16 mV, 38 link */
+
+static void fl_summary(void)
+{
+	uint8_t r[LT_FL_REC] = {};
+	uint32_t now = uptime_s();
+
+	fl_hdr(r, FL_SUM1);
+	sys_put_le32(rp.n, r + 16);
+	r[20] = rp.why;
+	r[21] = (uint8_t)(rp.link_before | (lk.link << 4));
+	r[22] = rp.flood_sent ? rp.lvl : 0xFF;
+	r[23] = (rp.r.has_fix ? 1 : 0) | (rp.acked ? 2 : 0) | (rp.ack_routed ? 4 : 0) | (rp.early ? 8 : 0) |
+		(rp.r.sync ? 16 : 0) | (rp.answer ? 32 : 0) | (rp.o.parked ? 64 : 0) | (rp.o.budget_hit ? 128 : 0);
+	sys_put_le16(rp.search_s, r + 24);
+	r[26] = rp.r.hacc_m;
+	r[27] = rp.copies;
+	for (uint8_t i = 0; i < 4 && i < rp.copies; i++) {
+		r[28 + 3 * i] = rp.copy_j[i];
+		sys_put_le16((uint16_t)MIN(rp.copy_ms[i], 65535U), r + 29 + 3 * i);
+	}
+	sys_put_le32(rp.r.has_fix ? rp.r.fix_time : 0, r + 40);
+	sys_put_le16((uint16_t)MIN(rp.o.moved_m, 65535U), r + 44);
+	r[46] = (uint8_t)MIN(floods_24h(), 255U);
+	r[47] = lt_link_budget_left(&lk, now);
+	lt_fl_put(r);
+
+	memset(r, 0, sizeof(r));
+	fl_hdr(r, FL_SUM2);
+	sys_put_le32(rp.n, r + 16);
+	sys_put_le16(rp.rep_heard ? (uint16_t)MIN(rp.rep_ms, 65534U) : 0xFFFF, r + 20);
+	memcpy(r + 22, rp.rep_hash, 3);
+	r[25] = rp.acked ? (uint8_t)MIN(rp.ack_k, 254) : 0xFF;
+	sys_put_le16(rp.acked ? (uint16_t)MIN(rp.ack_ms, 65534U) : 0xFFFF, r + 26);
+	r[28] = (uint8_t)rp.ack_snr4;
+	if (lc.taken) {
+		r[29] = lc.op;
+		r[30] = lc.seq;
+		r[31] = 1 | (lc.dup ? 2 : 0) | (lc.direct ? 4 : 0) | (lc.retry ? 8 : 0) | (lc.ble ? 16 : 0);
+		sys_put_le16(lc.k, r + 32);
+		sys_put_le16((uint16_t)MIN(lc.ms, 65535U), r + 34);
+		memset(&lc, 0, sizeof(lc));
+	}
+	sys_put_le32(sched.anchor.valid ? sched.anchor.n : 0xFFFFFFFFu, r + 36);
+	r[40] = sched.prev_slots_left;
+	r[41] = rp.r.next_in;
+	sys_put_le16(listen_start_ms ? (uint16_t)MIN(k_uptime_get() - listen_start_ms, 65535) : 0, r + 42);
+	sys_put_le16(chk_k, r + 44);
+	r[46] = rp.events;
+	r[47] = wake_stall;
+	lt_fl_put(r);
+
+	memset(r, 0, sizeof(r));
+	fl_hdr(r, FL_SUM3);
+	sys_put_le32(rp.n, r + 16);
+	r[20] = (uint8_t)(lk.path_n | (lk.path_hs << 4));
+	memcpy(r + 21, lk.path, 6);
+	r[27] = rp.r.battery;
+	sys_put_le32(lk.path_n && path_t_ok ? now - path_t_s : 0xFFFFFFFFu, r + 28);
+	sys_put_le16(board.getBattMilliVolts(), r + 32);
+	sys_put_le16((uint16_t)MIN(cfg.energy_uah / 1000, 65535U), r + 34);
+	r[36] = lt_boot_cause(boot_rst);
+	r[37] = boot_resets_at_boot;
+	r[38] = wake_txfail;
+	sys_put_le32(rp.next_in_s, r + 40);
+	lt_fl_put(r);
+}
+
+static void fl_check(void)
+{
+	uint8_t r[LT_FL_REC] = {};
+	int g = slot_on[0] ? 0 : 1;
+
+	fl_hdr(r, FL_CHK);
+	sys_put_le32(n_report, r + 16);
+	sys_put_le16(gx[g].k, r + 20);
+	r[22] = (slot_on[0] ? 1 : 0) | (slot_on[1] ? 2 : 0) | (check_acked ? 4 : 0) | (check_cmd ? 8 : 0) |
+		(lk.pending ? 16 : 0) | (check_disc ? 32 : 0) | (listen_only ? 64 : 0);
+	r[23] = sched.prev_slots_left;
+	sys_put_le32(grid_of(g)->valid ? grid_of(g)->n : 0xFFFFFFFFu, r + 24);
+	sys_put_le32((uint32_t)(k_uptime_get() - check_rx_ms), r + 28);
+	sys_put_le32((uint32_t)(int32_t)(grid_valid(g) ? slot_tk_ms(g) - check_rx_ms : 0), r + 32);
+	sys_put_le16(board.getBattMilliVolts(), r + 36);
+	r[38] = lk.link;
+	lt_fl_put(r);
+}
