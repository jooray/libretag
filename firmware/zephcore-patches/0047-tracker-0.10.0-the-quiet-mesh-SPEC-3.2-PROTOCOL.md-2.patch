+/* ---- 0.10.0: phase deadlines in the main loop (SPEC 3.2): past one the phase ends the normal way
+ * with a `stall` event, no reset (the watchdog stays the last resort) ---- */
+static void phase_deadline(void)
+{
+	int64_t now = k_uptime_get();
+
+	if ((uint8_t)phase != phase_was) {
+		phase_was = (uint8_t)phase;
+		phase_ms = now;
+		return;
+	}
+	int64_t since = now - phase_ms, lim_ms;
+
+	switch (phase) {
+	case PH_TX:
+		since = tx_start_ms ? now - tx_start_ms : 0;
+		lim_ms = 15000;
+		break;
+	case PH_LISTEN:
+		since = listen_start_ms ? now - listen_start_ms : since;
+		lim_ms = (int64_t)listen_len_ms() + 60000;
+		break;
+	case PH_CHECK:
+		lim_ms = (int64_t)check_window_s() * 1000 + 60000;
+		break;
+	case PH_BLESCAN:
+		lim_ms = 30000;
+		break;
+	case PH_WAIT_FIX:
+		lim_ms = (int64_t)(first_fix_pending ? CONFIG_ZEPHCORE_GPS_FIRST_FIX_TIMEOUT_SEC : cfg.fix_timeout_s) * 1000 +
+			 60000;
+		break;
+	default:
+		return;
+	}
+	if (since < lim_ms) {
+		return;
+	}
+	LOG_ERR("phase %u past its deadline (%lld s): ended", (unsigned)phase, (long long)(since / 1000));
+	ev_log(EVT_STALL, (uint8_t)phase, 2, (uint16_t)MIN(since / 1000, 65535), 0);
+	wake_stall++;
+	phase_ms = now;
+	switch (phase) {
+	case PH_TX:
+		wake_txfail++;
+		if (txq_i == 0) {
+			hist_cur.flags |= HF_DROPPED;
+		}
+		tx_finished();
+		break;
+	case PH_WAIT_FIX:
+		gps_stop_acquiring();
+		gps_wait = false;
+		lost_scan_pending = false;
+		lost_disc_wait = false;
+		search_done(false);
+		break;
+	case PH_BLESCAN:
+#if IS_ENABLED(CONFIG_BT_OBSERVER)
+		ble_scan_halt();
+		ble_purpose = BLE_NONE;
+#endif
+		go_to_sleep();
+		break;
+	default:
+		search_suspended = false;
+		go_to_sleep();
+		break;
+	}
+}
+
+/* ---- 0.10.0: scopetest (PROTOCOL.md 6.1): one flood per level of the current position, each its
+ * own payload, 10 s apart; per level whether a repeater was heard repeating it, and its hash ---- */
+
+static void scope_send(void)
+{
+	uint8_t dg[16], pkt[96], key[16];
+
+	rng.random(dg, sizeof(dg));
+	pkt[0] = LT_MC_HDR_REPORT_FLOOD;
+	pkt[1] = 0;
+	size_t l = lt_channel_wrap(chan_key, LT_CHANNEL_DATA_TYPE, dg, sizeof(dg), pkt + 2, sizeof(pkt) - 2);
+
+	if (st.lv[st.i]) {
+		lt_scope_key(st.lv[st.i], key);
+	}
+	l = l ? lt_packet_set_route(pkt, l + 2, sizeof(pkt), cfg.path_hash_size, st.lv[st.i] ? key : nullptr) : 0;
+	const uint8_t *gp;
+	size_t gl = l ? lt_packet_grp_payload(pkt, l, &gp) : 0;
+
+	st.pll = MIN(gl, sizeof(st.pl));
+	if (gl) {
+		memcpy(st.pl, gp, st.pll);
+	}
+	radio_home();
+	radio.recoverRxState();
+	k_msleep(20);
+	if (!l || !radio.startSendRaw(pkt, (int)l)) {
+		out("SCOPE %u %s ERR radio busy\r\n", st.i, st.lv[st.i] ? st.lv[st.i] : "none");
+	} else {
+		fl_tx(pkt, l, FLK_SCOPE, 0, false);
+		flood_count();
+		side_tx_pending = true;
+	}
+	k_timer_start(&scope_tmr, K_SECONDS(10), K_NO_WAIT);
+}
+
+static void scope_rx(const uint8_t *b, size_t n)
+{
+	const uint8_t *gp;
+	size_t gl;
+
+	if (!st.on || !st.pll || (gl = lt_packet_grp_payload(b, n, &gp)) != st.pll || memcmp(gp, st.pl, gl)) {
+		return;
+	}
+	uint8_t route, pl;
+	const uint8_t *path;
+
+	if (!st.heard[st.i] && lt_packet_route(b, n, &route, &pl, &path) && (pl & 0x3F)) {
+		size_t hs = (size_t)(pl >> 6) + 1;
+
+		st.heard[st.i] = true;
+		st.by_len[st.i] = (uint8_t)MIN(hs, (size_t)3);
+		memcpy(st.by[st.i], path + ((pl & 0x3F) - 1) * hs, st.by_len[st.i]);
+	}
+}
+
+static void scope_step(void)
+{
+	if (!st.on) {
+		return;
+	}
+	char h[8] = "-";
+
+	if (st.heard[st.i]) {
+		hex(h, st.by[st.i], st.by_len[st.i]);
+	}
+	out("SCOPE %u %s repeated=%s by=%s\r\n", st.i, st.lv[st.i] ? st.lv[st.i] : "none", st.heard[st.i] ? "yes" : "no", h);
+	if (++st.i < st.n) {
+		scope_send();
+		return;
+	}
+	out("END\r\n");
+	st.on = false;
+	st.pll = 0;
+	if (phase == PH_SLEEP && !mesh_scanning) {
+		radio.sleepRadio();
+	}
+}
+
+static bool scope_start(void)
+{
+	char net[3] = {0};
+	const lt_area_t *a = NULL;
+
+	if (st.on || phase != PH_SLEEP || !tx_ok_now()) {
+		return false;
+	}
+	strncpy(net, country_iso(cfg.country), 2);
+	if (cfg.last_fix_time) {
+		a = lt_area_at(true, cfg.last_lat_e7, cfg.last_lon_e7, cfg.areas, LT_AREA_ROWS, net);
+		if (!a) {
+			a = lt_area_at(true, cfg.last_lat_e7, cfg.last_lon_e7, lt_areas_baked, lt_areas_baked_n, net);
+		}
+	}
+	memset(&st, 0, sizeof(st));
+	st.n = (uint8_t)lt_levels(a ? a->scope : NULL, cfg.scope[0] ? cfg.scope : NULL, false, st.lv);
+	st.on = true;
+	scope_send();
+	return true;
+}
