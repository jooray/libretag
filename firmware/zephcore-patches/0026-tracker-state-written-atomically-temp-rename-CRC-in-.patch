+/* 0.7.6: `dfu [serial|ble|uf2]` (needs the unlock like every setting). The Adafruit nRF52
+ * bootloader on the Wio Tracker L1 (Seeed build, SoftDevice S140 7.3.0) picks its mode from
+ * GPREGRET0 at reset:
+ *   0x4E  serial-only DFU: USB CDC only, no mass-storage drive (adafruit-nrfutil `--touch 1200`, an app)
+ *   0xA8  BLE OTA DFU (legacy Nordic DFU, the bootloader advertises; same as ZephCore's buttonless DFU)
+ *   0x57  UF2: mass-storage drive plus CDC (what `dfu` did up to 0.7.5 and the 1200 baud touch does)
+ * The answer `dfu: rebooting to <mode>` is the last line before the USB port goes away. */
+#if defined(CONFIG_SOC_SERIES_NRF52)
+#define DFU_MAGIC_SERIAL 0x4E
+#define DFU_MAGIC_BLE    0xA8
+#define DFU_MAGIC_UF2    0x57
+#endif
+
+static void cli_dfu(const char *how)
+{
+#if defined(CONFIG_SOC_SERIES_NRF52)
+	uint8_t magic;
+
+	if (!strcmp(how, "serial")) {
+		magic = DFU_MAGIC_SERIAL;
+	} else if (!strcmp(how, "ble")) {
+		magic = DFU_MAGIC_BLE;
+	} else if (!strcmp(how, "uf2")) {
+		magic = DFU_MAGIC_UF2;
+	} else {
+		out("ERR dfu serial|ble|uf2\r\n");
+		return;
+	}
+	out("dfu: rebooting to %s\r\n", how);
+	cfg.boot_deliberate = 1; /* the first boot of the new firmware is not a reset */
+	save_mode();
+	save_cfg();
+	for (int i = 0; i < 50 && cli.availableForWrite() < 64; i++) {
+		k_msleep(2);
+	}
+	k_msleep(300); /* the host reads the answer before the port goes away */
+	radio.sleepRadio();
+	gps_stop_acquiring();
+#if ZEPHCORE_USB_STACK && !IS_ENABLED(CONFIG_CDC_ACM_SERIAL_INITIALIZE_AT_BOOT)
+	zephcore_usbd_detach();
+	k_msleep(100);
+#endif
+	nrf_power_gpregret_set(NRF_POWER, 0, magic);
+	sys_reboot(SYS_REBOOT_COLD);
+#else
+	ARG_UNUSED(how);
+	out("ERR dfu: not on this board\r\n");
+#endif
+}
