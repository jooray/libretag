+			out("ERR wzone snap <name, 1..%u chars> [scans 1..%u], at most %u zones\r\n", WZ_NAME - 1, WZ_SNAP_MAX,
+			    WZONES_MAX);
+			return true;
+		}
+		static lt_wfp_acc_t acc;
+
+		lt_wfp_acc_init(&acc);
+		for (int k = 0; k < scans; k++) {
+			size_t n = wz_scan(aps, ARRAY_SIZE(aps), ws, &nws);
+
+			lt_wfp_acc_add(&acc, ws, nws);
+			out("SNAP %d %u AP %u for zones\r\n", k, (unsigned)n, (unsigned)nws);
+		}
+		lt_wfp_t f;
+		lt_wfp_finish(&acc, &f);
+		if (!f.n) {
+			out("ERR no access point seen in at least half of the scans\r\n");
+			return true;
+		}
+		if (slot < 0) {
+			slot = wz.count++;
+		}
+		wz.fp[slot] = f;
+		memset(wz.name[slot], 0, WZ_NAME);
+		memcpy(wz.name[slot], argv[2], nl);
+		if (wake_prev_wzone() == slot) {
+			wake_st.zone = -1; /* the fingerprint changed: enter it afresh */
+		}
+		wz_save();
+		wz_print_zone((uint8_t)slot, true);
+		out("OK wzone %d\r\n", slot);
+	} else if (!strcmp(sub, "list")) {
+		for (uint8_t i = 0; i < wz.count; i++) {
+			wz_print_zone(i, false);
+		}
+		out("END %u\r\n", wz.count);
+	} else if (!strcmp(sub, "show") && argc == 3 && atoi(argv[2]) >= 0 && atoi(argv[2]) < wz.count) {
+		wz_print_zone((uint8_t)atoi(argv[2]), true);
+	} else if (!strcmp(sub, "del") && argc == 3 && atoi(argv[2]) >= 0 && atoi(argv[2]) < wz.count) {
+		int i = atoi(argv[2]);
+
+		memmove(&wz.fp[i], &wz.fp[i + 1], (wz.count - i - 1) * sizeof(wz.fp[0]));
+		memmove(&wz.name[i], &wz.name[i + 1], (wz.count - i - 1) * sizeof(wz.name[0]));
+		wz.count--;
+		lt_wake_state_init(&wake_st); /* zone indexes moved */
+		wz_save();
+		out("OK\r\n");
+	} else if (!strcmp(sub, "clear")) {
+		wz.count = 0;
+		memset(wz.fp, 0, sizeof(wz.fp));
+		memset(wz.name, 0, sizeof(wz.name));
+		lt_wake_state_init(&wake_st);
+		wz_save();
+		out("OK\r\n");
+	} else if (!strcmp(sub, "test")) {
+		int scans = argc >= 3 ? CLAMP(atoi(argv[2]), 1, 20) : 1;
+		int8_t prev = wake_prev_wzone();
+
+		for (int k = 0; k < scans; k++) {
+			uint8_t sc;
+			size_t n = wz_scan(aps, ARRAY_SIZE(aps), ws, &nws);
+			int8_t z = lt_wzone_match(&wz_cfg, wz.fp, wz.count, ws, nws, prev, &sc);
+
+			out("TEST %d %u AP %u for zones: zone %d score %u (was %d)\r\n", k, (unsigned)n, (unsigned)nws, z, sc,
+			    prev);
+			wz_print_scores(k, ws, nws);
+			prev = z;
+		}
+		out("END\r\n");
+	} else if (!strcmp(sub, "thr") && argc >= 4) {
+		int e = atoi(argv[2]), s = atoi(argv[3]), m = argc >= 5 ? atoi(argv[4]) : wz.min_match;
+
+		if (e < 1 || e > 100 || s < 1 || s > e || m < 1 || m > LT_WFP_MAX) {
+			out("ERR wzone thr <enter 1..100> <stay 1..enter> [min_match 1..%u]\r\n", LT_WFP_MAX);
+			return true;
+		}
+		wz.enter = (uint8_t)e;
+		wz.stay = (uint8_t)s;
+		wz.min_match = (uint8_t)m;
+		wz_save();
+		out("OK enter %d stay %d min_match %d\r\n", e, s, m);
+	} else {
+		out("ERR wzone snap <name> [scans] | list | show <i> | del <i> | clear | test [scans] | "
+		    "thr <enter> <stay> [min_match]\r\n");
+	}
+	return true;
+}
