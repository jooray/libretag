diff --git a/zephcore/src/lt_wifi_esp32.c b/zephcore/src/lt_wifi_esp32.c
new file mode 100644
index 0000000..e38bde9
--- /dev/null
+++ b/zephcore/src/lt_wifi_esp32.c
@@ -0,0 +1,180 @@
+/*
+ * LibreTag: Wi-Fi scan for the tracker on ESP32 boards (lt_wifi_scan(), LibreTag
+ * docs/design/fw-wifi-esp32.md). One blocking scan through Zephyr's Wi-Fi management API
+ * (NET_REQUEST_WIFI_SCAN, results as NET_EVENT_WIFI_SCAN_RESULT), then the Wi-Fi radio is stopped
+ * again so the SoC can light-sleep (the Wi-Fi library holds a sleep lock while the radio is on).
+ *
+ * Privacy: an active scan sends probe requests from the station MAC. Before each scan the station
+ * gets a fresh random locally administered MAC, so probe requests cannot follow the tag from place
+ * to place. A passive scan (`wifiscan passive`) sends nothing at all and takes longer.
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/net/net_if.h>
+#include <zephyr/net/net_mgmt.h>
+#include <zephyr/net/wifi_mgmt.h>
+#include <zephyr/random/random.h>
+#include <string.h>
+
+#include <esp_wifi.h>
+
+#include "lt_core.h"
+#include "lt_wifi_esp32.h"
+
+#include <zephyr/logging/log.h>
+LOG_MODULE_REGISTER(lt_wifi, CONFIG_ZEPHCORE_MAIN_LOG_LEVEL);
+
+static struct net_mgmt_event_callback scan_cb;
+static K_SEM_DEFINE(scan_done, 0, 1);
+static K_MUTEX_DEFINE(scan_lock);
+static struct k_spinlock res_lock;
+static lt_wifi_ap_t *res_buf;
+static size_t res_max, res_n, res_raw;
+static int scan_status;
+static bool passive;
+static struct lt_wifi_stats stats;
+
+static void scan_event(struct net_mgmt_event_callback *cb, uint64_t ev, struct net_if *iface)
+{
+	ARG_UNUSED(iface);
+	if (ev == NET_EVENT_WIFI_SCAN_RESULT) {
+		const struct wifi_scan_result *r = (const struct wifi_scan_result *)cb->info;
+		k_spinlock_key_t key = k_spin_lock(&res_lock);
+
+		res_raw++;
+		if (res_buf && r && r->mac_length == 6) {
+			/* the same BSSID can come twice; keep the stronger */
+			size_t i;
+			for (i = 0; i < res_n && memcmp(res_buf[i].bssid, r->mac, 6); i++) {
+			}
+			if (i < res_n) {
+				if (r->rssi > res_buf[i].rssi) {
+					res_buf[i].rssi = r->rssi;
+				}
+			} else if (res_n < res_max) {
+				lt_wifi_ap_t *a = &res_buf[res_n++];
+				size_t l = MIN(r->ssid_length, sizeof(a->ssid) - 1);
+
+				memcpy(a->bssid, r->mac, 6);
+				a->rssi = r->rssi;
+				memcpy(a->ssid, r->ssid, l);
+				a->ssid[l] = 0;
+			} else {
+				/* full: replace the weakest when this one is stronger */
+				size_t w = 0;
+				for (i = 1; i < res_n; i++) {
+					if (res_buf[i].rssi < res_buf[w].rssi) {
+						w = i;
+					}
+				}
+				if (r->rssi > res_buf[w].rssi) {
+					size_t l = MIN(r->ssid_length, sizeof(res_buf[w].ssid) - 1);
+
+					memcpy(res_buf[w].bssid, r->mac, 6);
+					res_buf[w].rssi = r->rssi;
+					memcpy(res_buf[w].ssid, r->ssid, l);
+					res_buf[w].ssid[l] = 0;
+				}
+			}
+		}
+		k_spin_unlock(&res_lock, key);
+	} else if (ev == NET_EVENT_WIFI_SCAN_DONE) {
+		const struct wifi_status *st = (const struct wifi_status *)cb->info;
+
+		scan_status = st ? st->status : 0;
+		k_sem_give(&scan_done);
+	}
+}
+
+static int wifi_init(void)
+{
+	net_mgmt_init_event_callback(&scan_cb, scan_event, NET_EVENT_WIFI_SCAN_RESULT | NET_EVENT_WIFI_SCAN_DONE);
+	net_mgmt_add_event_callback(&scan_cb);
+	return 0;
+}
+SYS_INIT(wifi_init, APPLICATION, 90);
+
+void lt_wifi_set_passive(bool on)
+{
+	passive = on;
+}
+
+bool lt_wifi_passive(void)
+{
+	return passive;
+}
+
+const struct lt_wifi_stats *lt_wifi_last_stats(void)
+{
+	return &stats;
+}
+
+static void random_sta_mac(void)
+{
+	uint8_t mac[6];
+
+	sys_rand_get(mac, sizeof(mac));
+	mac[0] = (uint8_t)((mac[0] & 0xFC) | 0x02); /* locally administered, unicast */
+	int e = esp_wifi_set_mac(WIFI_IF_STA, mac);
+	if (e != ESP_OK) {
+		LOG_DBG("random MAC not set (%d)", e);
+	}
+}
+
+size_t lt_wifi_scan(lt_wifi_ap_t *aps, size_t max, uint32_t timeout_ms)
+{
+	struct net_if *iface = net_if_get_wifi_sta();
+	struct wifi_scan_params p = {};
+	int64_t t0 = k_uptime_get();
+	size_t n;
+
+	if (!iface) {
+		iface = net_if_get_first_wifi();
+	}
+	if (!iface) {
+		LOG_WRN("no Wi-Fi interface");
+		return 0;
+	}
+	k_mutex_lock(&scan_lock, K_FOREVER);
+	k_sem_reset(&scan_done);
+	{
+		k_spinlock_key_t key = k_spin_lock(&res_lock);
+		res_buf = aps;
+		res_max = max;
+		res_n = 0;
+		res_raw = 0;
+		k_spin_unlock(&res_lock, key);
+	}
+	scan_status = 0;
+	/* the radio is stopped between scans, which is when the station MAC may change */
+	(void)esp_wifi_stop();
+	random_sta_mac();
+	p.scan_type = passive ? WIFI_SCAN_TYPE_PASSIVE : WIFI_SCAN_TYPE_ACTIVE;
+	int r = net_mgmt(NET_REQUEST_WIFI_SCAN, iface, &p, sizeof(p));
+	bool ok = r == 0;
+
+	if (!ok) {
+		LOG_WRN("scan request failed (%d)", r);
+	} else if (k_sem_take(&scan_done, K_MSEC(timeout_ms)) != 0) {
+		LOG_WRN("scan: no result within %u ms", timeout_ms);
+		ok = false;
+	}
+	/* stop the radio: the Wi-Fi library keeps the SoC out of light sleep while it runs */
+	(void)esp_wifi_stop();
+	{
+		k_spinlock_key_t key = k_spin_lock(&res_lock);
+		n = res_n;
+		res_buf = NULL;
+		stats.raw = (uint16_t)MIN(res_raw, 65535);
+		k_spin_unlock(&res_lock, key);
+	}
+	stats.ms = (uint32_t)(k_uptime_get() - t0);
+	stats.count = (uint16_t)n;
+	stats.ok = ok && scan_status == 0;
+	stats.passive = passive;
+	stats.scans++;
+	k_mutex_unlock(&scan_lock);
+	LOG_INF("wifi scan: %u AP(s) (%u results) in %u ms%s", (unsigned)n, stats.raw, stats.ms,
+		stats.ok ? "" : ", failed");
+	return n;
+}
diff --git a/zephcore/src/lt_wifi_esp32.h b/zephcore/src/lt_wifi_esp32.h
new file mode 100644
index 0000000..ba0ec7f
--- /dev/null
+++ b/zephcore/src/lt_wifi_esp32.h
@@ -0,0 +1,31 @@
+/* LibreTag: Wi-Fi scan on ESP32 boards (lt_wifi_esp32.c). lt_wifi_scan() itself is declared in
+ * main_tracker.cpp (a weak default there finds nothing). */
+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "lt_core.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct lt_wifi_stats {
+	uint32_t ms;     /* the last scan, request to the radio stopped */
+	uint16_t count;  /* distinct BSSIDs it returned (at most the caller's buffer) */
+	uint16_t raw;    /* scan results reported, duplicates included */
+	uint32_t scans;  /* scans since boot */
+	bool ok;
+	bool passive;
+};
+
+size_t lt_wifi_scan(lt_wifi_ap_t *aps, size_t max, uint32_t timeout_ms);
+void lt_wifi_set_passive(bool on);
+bool lt_wifi_passive(void);
+const struct lt_wifi_stats *lt_wifi_last_stats(void);
+
+#ifdef __cplusplus
+}
+#endif
