+static void wz_print_ap(int scan, const lt_wifi_ap_t *a)
+{
+	char ss[33];
+	size_t i;
+
+	for (i = 0; i < sizeof(ss) - 1 && a->ssid[i]; i++) {
+		ss[i] = a->ssid[i] >= 0x20 && a->ssid[i] < 0x7f && a->ssid[i] != ' ' ? a->ssid[i] : '_';
+	}
+	ss[i] = 0;
+	out("AP %d %02x:%02x:%02x:%02x:%02x:%02x %d %s%s\r\n", scan, a->bssid[0], a->bssid[1], a->bssid[2],
+	    a->bssid[3], a->bssid[4], a->bssid[5], a->rssi, lt_wifi_zone_usable(a->bssid) ? "" : "laa ", ss[0] ? ss : "-");
+}
+
+static void wz_print_scores(int scan, const lt_wscan_ap_t *ws, size_t nws)
+{
+	for (uint8_t i = 0; i < wz.count; i++) {
+		uint8_t m;
+		uint8_t sc = lt_wfp_score(&wz.fp[i], ws, nws, &m);
+
+		out("SCORE %d %u %s %u matched %u of %u\r\n", scan, i, wz.name[i], sc, m, wz.fp[i].n);
+	}
+}
+
+static void wz_print_status(void)
+{
+	out("wifi zones=%u enter=%u stay=%u min_match=%u scan=%s", wz.count, wz.enter, wz.stay, wz.min_match,
+	    wz.passive ? "passive" : "active");
+	if (wake_scanned) {
+		out(" last: %u AP (%u for zones) in %u ms, zone %d score %u, parked score %u", (unsigned)wake_na,
+		    (unsigned)wake_nws, (unsigned)wake_scan_ms, wake_wzone, wake_wscore, still_score);
+	}
+	out("\r\n");
+}
+
+static void wz_print_zone(uint8_t i, bool entries)
+{
+	const lt_wfp_t *f = &wz.fp[i];
+
+	out("WZONE %u %s %u AP from %u scan(s)\r\n", i, wz.name[i], f->n, f->scans);
+	for (uint8_t k = 0; entries && k < f->n; k++) {
+		out("  %08x %d dBm seen %u/%u spread %u\r\n", (unsigned)f->ap[k].h, f->ap[k].rssi, f->ap[k].seen, f->scans,
+		    f->ap[k].spread);
+	}
+}
