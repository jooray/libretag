 }
 
 /* Rough charge model (SPEC 8, X1 figures): enough to tell "a month" from "a week". */
+#if defined(CONFIG_SOC_FAMILY_ESPRESSIF_ESP32)
+/* ESP32-S3 + SX1262 without GNSS (datasheet figures, not measured on the board; LibreTag
+ * docs/design/fw-wifi-esp32.md): light sleep with the radio asleep, awake = the SoC light-sleeps
+ * between events while the receiver runs, Wi-Fi active scan (RX ~90 mA with probe bursts) */
+#define UA_SLEEP 500
+#define UA_AWAKE 6000
+#define UA_RX 6000
+#define UA_TX 125000
+#define UA_BLE 30000
+#define UA_WIFI 100000
+#else
 #define UA_SLEEP 50
 #define UA_AWAKE 18800 /* GNSS searching + MCU */
 #define UA_RX 8550
 #define UA_TX 110500
 #define UA_BLE 6000
+#define UA_WIFI 0
+#endif
+static uint32_t en_wifi_ms; /* Wi-Fi scan time in this wake-up */
 
 static void energy_add(uint32_t ua, int64_t ms)
 {
@@ -1146,9 +1167,10 @@ static void energy_wake_end(int64_t wake_start_ms, int64_t listen_ms)
 	energy_add(UA_TX, en_tx_ms);
 	energy_add(UA_BLE, en_ble_ms);
 	energy_add(UA_RX, en_disc_rx_ms); /* GPS already off: the receiver instead of the search */
-	energy_add(UA_AWAKE, awake - listen_ms - en_tx_ms - en_disc_rx_ms);
+	energy_add(UA_WIFI, en_wifi_ms);
+	energy_add(UA_AWAKE, awake - listen_ms - en_tx_ms - en_disc_rx_ms - en_wifi_ms);
 	en_mark_ms = now;
-	en_tx_ms = en_ble_ms = en_disc_rx_ms = 0;
+	en_tx_ms = en_ble_ms = en_disc_rx_ms = en_wifi_ms = 0;
 	/* on a charger (or full) the count starts again */
 	if (board.getBattMilliVolts() >= 4150) {
 		cfg.energy_uah = 0;
@@ -1504,6 +1526,164 @@ extern "C" __weak size_t lt_wifi_scan(lt_wifi_ap_t *aps, size_t max, uint32_t ti
 	ARG_UNUSED(timeout_ms);
 	return 0;
 }
+
+/* Wi-Fi zones (LibreTag docs/design/fw-wifi-esp32.md): a place is a fingerprint of the access
+ * points seen there, taken with `wzone snap`. At a wake-up without a fix the scan is matched against
+ * them (lt_wzone_match) and an inside counts as a home zone in lt_wake_decide. The file keeps keyed
+ * 32-bit hashes of the BSSIDs, not the BSSIDs; the salt never leaves the tracker. */
+#define WZ_FILE  STATE_DIR "/wzones"
+#define WZ_TMP   STATE_DIR "/wzones.tmp"
+#define WZ_MAGIC 0x4C545731u /* "LTW1" */
+#define WZONES_MAX 8
+#define WZ_NAME 16
+#define WZ_SCAN_MS 8000      /* a passive scan of 13 channels takes about 5 s */
+#define WZ_SNAP_DEFAULT 5
+#define WZ_SNAP_MAX 20
+struct wzfile {
+	uint32_t magic;
+	uint8_t count;
+	uint8_t enter, stay, min_match;
+	uint8_t passive;     /* scan without probe requests */
+	uint8_t pad[3];
+	uint8_t salt[16];
+	char name[WZONES_MAX][WZ_NAME];
+	lt_wfp_t fp[WZONES_MAX];
+	uint32_t crc;
+};
+static struct wzfile wz;
+static lt_wzone_cfg_t wz_cfg;
+/* this wake-up's scan */
+static lt_wifi_ap_t wake_aps[32];
+static size_t wake_na;
+static lt_wscan_ap_t wake_ws[LT_WFP_MAX];
+static size_t wake_nws;
+static bool wake_scanned;
+static int8_t wake_wzone = -1;
+static uint8_t wake_wscore;
+static int64_t wake_scan_ms;
+static lt_wfp_t still_ref;     /* parked by Wi-Fi: the first scan of the stretch */
+static uint8_t still_score;
+
+static uint32_t wz_crc(const struct wzfile *z)
+{
+	return crc32_ieee((const uint8_t *)z, offsetof(struct wzfile, crc));
+}
+
+static void wz_apply(void)
+{
+	wz_cfg.enter = wz.enter;
+	wz_cfg.stay = wz.stay;
+	wz_cfg.min_match = wz.min_match;
+#if IS_ENABLED(CONFIG_WIFI_ESP32)
+	lt_wifi_set_passive(wz.passive);
+#endif
+}
+
+static bool wz_save(void)
+{
+	struct fs_file_t f;
+
+	wz.magic = WZ_MAGIC;
+	wz.crc = wz_crc(&wz);
+	fs_file_t_init(&f);
+	if (fs_open(&f, WZ_TMP, FS_O_CREATE | FS_O_WRITE | FS_O_TRUNC) < 0) {
+		LOG_ERR("cannot write %s", WZ_TMP);
+		return false;
+	}
+	ssize_t w = fs_write(&f, &wz, sizeof(wz));
+	int c = fs_close(&f);
+
+	if (w != (ssize_t)sizeof(wz) || c != 0 || fs_rename(WZ_TMP, WZ_FILE) != 0) {
+		LOG_ERR("wzones write failed");
+		fs_unlink(WZ_TMP);
+		return false;
+	}
+	wz_apply();
+	return true;
+}
+
+static bool wz_read(const char *path)
+{
+	struct fs_file_t f;
+
+	fs_file_t_init(&f);
+	if (fs_open(&f, path, FS_O_READ) != 0) {
+		return false;
+	}
+	ssize_t r = fs_read(&f, &wz, sizeof(wz));
+
+	fs_close(&f);
+	return r == (ssize_t)sizeof(wz) && wz.magic == WZ_MAGIC && wz.crc == wz_crc(&wz) && wz.count <= WZONES_MAX;
+}
+
+static void wz_load(void)
+{
+	if (!wz_read(WZ_TMP) && !wz_read(WZ_FILE)) {
+		memset(&wz, 0, sizeof(wz));
+		lt_wzone_cfg_default(&wz_cfg);
+		wz.enter = wz_cfg.enter;
+		wz.stay = wz_cfg.stay;
+		wz.min_match = wz_cfg.min_match;
+		rng.random(wz.salt, sizeof(wz.salt));
+		wz_save();
+	}
+	wz_apply();
+}
+
+/* one scan, as the zones see it */
+static size_t wz_scan(lt_wifi_ap_t *aps, size_t max, lt_wscan_ap_t ws[LT_WFP_MAX], size_t *nws)
+{
+	size_t n = lt_wifi_scan(aps, max, WZ_SCAN_MS);
+
+	*nws = lt_wscan_from_aps(wz.salt, aps, n, ws);
+	return n;
+}
+
+static int8_t wake_prev_wzone(void)
+{
+	return wake_st.zone >= LT_WZONE_BASE ? (int8_t)(wake_st.zone - LT_WZONE_BASE) : -1;
+}
+
+/* At the start of a wake-up that looks: scan and match (the report reuses the scan). */
+static void wifi_wake_scan(void)
+{
+	int64_t t = k_uptime_get();
+
+	wake_na = wz_scan(wake_aps, ARRAY_SIZE(wake_aps), wake_ws, &wake_nws);
+	wake_scan_ms = k_uptime_get() - t;
+	en_wifi_ms += (uint32_t)wake_scan_ms;
+	wake_scanned = true;
+	wake_wzone = lt_wzone_match(&wz_cfg, wz.fp, wz.count, wake_ws, wake_nws, wake_prev_wzone(), &wake_wscore);
+	still_score = still_ref.n ? lt_wfp_score(&still_ref, wake_ws, wake_nws, NULL) : 0;
+	LOG_INF("wifi: %u AP(s), %u for zones, zone %d score %u, parked score %u", (unsigned)wake_na,
+		(unsigned)wake_nws, wake_wzone, wake_wscore, still_score);
+}
+
+/* inputs of lt_wake_decide from this wake-up's scan */
+static void wifi_wake_in(lt_wake_in_t *w)
+{
+	if (!wake_scanned || !wake_nws) {
+		return; /* no scan, or nothing usable: no place (fail-open, as without a fix) */
+	}
+	w->wifi_valid = true;
+	w->wifi_zone = wake_wzone;
+	w->wifi_still = still_ref.n && still_score >= wz_cfg.enter;
+}
+
+static void wifi_wake_after(bool decided_by_wifi)
+{
+	if (decided_by_wifi && wake_st.still_count == 1) {
+		/* a new parked stretch starts here: this scan is its reference */
+		lt_wfp_acc_t acc;
+
+		lt_wfp_acc_init(&acc);
+		lt_wfp_acc_add(&acc, wake_ws, wake_nws);
+		lt_wfp_finish(&acc, &still_ref);
+	} else if (!decided_by_wifi && !wake_st.still_count) {
+		memset(&still_ref, 0, sizeof(still_ref));
+	}
+}
