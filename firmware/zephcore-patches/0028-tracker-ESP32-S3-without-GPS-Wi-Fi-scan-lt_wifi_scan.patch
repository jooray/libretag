diff --git a/zephcore/boards/common/tracker_wifi.conf b/zephcore/boards/common/tracker_wifi.conf
new file mode 100644
index 0000000..07d5ccd
--- /dev/null
+++ b/zephcore/boards/common/tracker_wifi.conf
@@ -0,0 +1,30 @@
+# LibreTag tracker on an ESP32 board without GPS: Wi-Fi scans place the tag (LibreTag
+# docs/design/fw-wifi-esp32.md). Added by CMake to tracker builds of ESP32 boards whose
+# zephcore.yml declares `capabilities: wifi: true`; light sleep (pm_esp32.conf) comes with it on
+# boards that declare `light_sleep: true`.
+CONFIG_LIBRETAG_WIFI=y
+
+# Scan only: no IP traffic, no sockets. The ESP32 Wi-Fi driver needs the networking core and the
+# Ethernet L2 underneath the Wi-Fi management API.
+CONFIG_NETWORKING=y
+CONFIG_NET_IPV4=y
+CONFIG_NET_IPV6=n
+CONFIG_NET_TCP=n
+# the connection table (NET_MAX_CONN) only exists with UDP or TCP; nothing opens a socket
+CONFIG_NET_UDP=y
+CONFIG_NET_MAX_CONN=2
+CONFIG_NET_MAX_CONTEXTS=2
+CONFIG_NET_DHCPV4=n
+CONFIG_NET_SOCKETS=n
+CONFIG_NET_MGMT=y
+CONFIG_NET_MGMT_EVENT=y
+CONFIG_NET_MGMT_EVENT_INFO=y
+# one event per scan result (the driver yields after each); a busy street has 30+ BSSIDs
+CONFIG_NET_MGMT_EVENT_QUEUE_SIZE=48
+CONFIG_NET_L2_ETHERNET=y
+CONFIG_WIFI=y
+CONFIG_NET_L2_WIFI_MGMT=y
+CONFIG_NET_PKT_RX_COUNT=4
+CONFIG_NET_PKT_TX_COUNT=4
+CONFIG_NET_BUF_RX_COUNT=8
+CONFIG_NET_BUF_TX_COUNT=8
diff --git a/zephcore/src/lt_pm_uart_esp32.c b/zephcore/src/lt_pm_uart_esp32.c
new file mode 100644
index 0000000..e8c8d37
--- /dev/null
+++ b/zephcore/src/lt_pm_uart_esp32.c
@@ -0,0 +1,91 @@
+/*
+ * LibreTag tracker on ESP32 boards with a USB-UART bridge (Heltec V3 family): the console can wake
+ * the SoC from light sleep. helpers/pm_esp32_console.c keeps the console reachable only in a window
+ * after boot or a button press, and opening the port of a CP2102 resets the board (DTR/RTS), which
+ * counts as a reset for the tracker's boot backoff. Here the console RX pad stays live through
+ * light sleep and the UART is a wake source: a few edges on RX wake the SoC, and the tracker then
+ * stays awake for LT_PM_UART_HOLD_S so the rest of the line gets in. The characters that woke it
+ * are lost, so a host sends a line break first, waits ~100 ms, then the command.
+ *
+ * Risk on battery: with the bridge unpowered the RX pad must not float (pinctrl pulls it up).
+ */
+
+#include <zephyr/kernel.h>
+#include <zephyr/init.h>
+#include <zephyr/pm/pm.h>
+#include <zephyr/sys/atomic.h>
+
+#include <esp_sleep.h>
+#include <hal/gpio_ll.h>
+#include <hal/uart_ll.h>
+#include <soc/gpio_struct.h>
+
+#include <helpers/pm_sleep_guard.h>
+#include "lt_pm_uart_esp32.h"
+
+#define LT_PM_UART_NUM CONFIG_ZEPHCORE_PM_CONSOLE_UART_NUM
+#define LT_PM_UART_RX_GPIO 44   /* U0RXD on the ESP32-S3 (the Heltec V3 console) */
+#define LT_PM_UART_EDGES 3      /* RX edges that wake the SoC */
+#define LT_PM_UART_HOLD_S 30
+
+static atomic_t held;
+static atomic_t wakes;
+
+static void hold_expired(struct k_work *w)
+{
+	ARG_UNUSED(w);
+	if (atomic_cas(&held, 1, 0)) {
+		zc_pm_unblock_sleep();
+	}
+}
+static K_WORK_DELAYABLE_DEFINE(hold_work, hold_expired);
+
+void lt_pm_console_touch(void)
+{
+	if (atomic_cas(&held, 0, 1)) {
+		zc_pm_block_sleep();
+	}
+	k_work_reschedule(&hold_work, K_SECONDS(LT_PM_UART_HOLD_S));
+}
+
+uint32_t lt_pm_uart_wakes(void)
+{
+	return (uint32_t)atomic_get(&wakes);
+}
+
+static void wake_work_fn(struct k_work *w)
+{
+	ARG_UNUSED(w);
+	lt_pm_console_touch();
+}
+static K_WORK_DEFINE(wake_work, wake_work_fn);
+
+static void uart_state_entry(enum pm_state state)
+{
+	if (state == PM_STATE_STANDBY) {
+		/* keep the RX pad in its normal (UART) configuration while asleep */
+		gpio_ll_sleep_sel_dis(&GPIO, LT_PM_UART_RX_GPIO);
+	}
+}
+
+static void uart_state_exit(enum pm_state state)
+{
+	if (state == PM_STATE_STANDBY && (esp_sleep_get_wakeup_causes() & BIT(ESP_SLEEP_WAKEUP_UART))) {
+		atomic_inc(&wakes);
+		k_work_submit(&wake_work);
+	}
+}
+
+static struct pm_notifier uart_notifier = {
+	.state_entry = uart_state_entry,
+	.state_exit = uart_state_exit,
+};
+
+static int lt_pm_uart_init(void)
+{
+	uart_ll_set_wakeup_edge_thrd(UART_LL_GET_HW(LT_PM_UART_NUM), LT_PM_UART_EDGES);
+	(void)esp_sleep_enable_uart_wakeup(LT_PM_UART_NUM);
+	pm_notifier_register(&uart_notifier);
+	return 0;
+}
+SYS_INIT(lt_pm_uart_init, APPLICATION, 91);
