# <path glob> <regex on the line>: findings that are fine to publish (tools/release/squash_check.py)
# region test: the public city centres of Bratislava and Vienna, not a private place
firmware/lt_core/test/region_test.c	/\* (Bratislava|Wien) \*/|plan\(48\.1486, 17\.1077
# NIP-17 example keys from the NIP itself (public test data)
pwa/tests/vectors/nip17-examples.json	nsec1
# this script's own pattern list
tools/release/squash_check.py	.
# lock files: versions, sizes and hashes, not places
host/uv.lock	(version|size|hash|url|upload-time) ?=
pwa/package-lock.json	"(version|integrity|resolved)"
# vendored upstream code (author addresses in comments)
firmware/third_party/*	.
# relay filter tests: a carrier-grade NAT address must be refused
*Test.kt	wss://100\.64\.1\.1
# nostr-live widget: a comment example of a URL with credentials, not an address
web/site/vendor/nostr-live.js	bank\.com@evil\.example
# quiet mesh baked area: the first bridge city (Bratislava old town centre, 25 km), a public point like region_test
firmware/lt_core/lt_core.c	\{48144[0-9]+, 17108[0-9]+, 25, "sk-ba", "sk"\}
